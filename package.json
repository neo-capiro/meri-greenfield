{
  "name": "meri-greenfield",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "node --test packages/contracts/test/*.test.mjs evals/qualification/hermes-session.test.mjs",
    "check:contracts": "node --test packages/contracts/test/*.test.mjs",
    "check:contracts:distribution": "npm run check --prefix packages/contracts",
    "check:sdk-evidence": "node --test --test-concurrency=1 packages/contracts/test/sdk-native-evidence.test.mjs apps/control/qualification-sdk-fixture/service/test/native-evidence.test.mjs apps/control/qualification-sdk-fixture/service/test/native-evidence-publisher.test.mjs apps/control/qualification-sdk-fixture/service/test/s3-checkpoint.test.mjs apps/worker/qualification/probes/native-observations.test.mjs apps/worker/qualification/probes/native-stream-observer.test.mjs apps/worker/qualification/probes/native-namespace-observer.test.mjs apps/worker/qualification/probes/sdk-capture.test.mjs apps/worker/qualification/probes/sdk-interruption.test.mjs apps/worker/qualification/probes/sdk-interruption-loopback.test.mjs apps/worker/qualification/checkpoint/fixture-channel.test.mjs apps/worker/qualification/checkpoint/fixture-transport.test.mjs apps/worker/qualification/checkpoint/native-session-files.test.mjs apps/worker/qualification/checkpoint/resume-admission.test.mjs apps/worker/qualification/checkpoint/fixture-sentinel.test.mjs scripts/qualification/sdk-stale-worker-challenge.test.mjs scripts/qualification/sdk-native-evidence-owner.test.mjs",
    "synth:qualification": "node infra/qualification/app.mjs",
    "check:infra": "npm run synth:qualification && node --test infra/qualification/security.test.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "aws-cdk": "2.1145.0",
    "aws-cdk-lib": "2.273.0",
    "canonicalize": "5.1.0",
    "constructs": "10.8.1"
  }
}
