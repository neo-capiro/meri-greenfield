   "status": "SYNTHETIC_RUNNABLE",
   "synthetic": true,
   "title": "Plain-text briefing memo is created and downloadable",
   "capability": "artifact.create",
   "prompt": "SYNTHETIC: Draft a short synthetic briefing memo as a file.",
   "expectedEvidence": [
    {
     "evidenceId": "DL-01-E1",
     "source": "artifact-service",
     "path": "version.filename",
     "value": "Synthetic briefing memo.txt",
     "required": true,
     "describes": "filename derived from the request title"
    },
    {
     "evidenceId": "DL-01-E2",
     "source": "artifact-service",
     "path": "version.generationStatus",
     "value": "draft",
     "required": true,
     "describes": "new versions start as drafts"
    },
    {
     "evidenceId": "DL-01-E3",
     "source": "artifact-service",
     "path": "execution.nativeQualified",
     "value": false,
     "required": true,
     "describes": "plain-text executor is not native Office qualification"
    }
   ],
   "permissions": {
    "principal": "synthetic tenant-synthetic-dl actor",
    "scopes": [
     "client"
    ],
    "expected": "allowed"
   },
   "outputFormat": {
    "kind": "file",
    "fileFormat": "txt",
    "files": 1,
    "requiredText": [
     "Synthetic briefing memo",
     "Purpose: synthetic evaluation only"
    ],
    "maxBytes": 65536
   },
   "successCriteria": [
    "File opens as UTF-8 text with the requested headings",
    "Checksum and size match the committed version"
   ],
   "graders": [
    "output-format",
    "permissions",
    "usable-file",
    "factual-claims"
   ],
   "scenario": {
    "kind": "artifact-text-create",
    "tenantId": "tenant-synthetic-dl",
    "tag": "d1a1",
    "title": "Synthetic briefing memo",
    "text": "Synthetic briefing memo\nPurpose: synthetic evaluation only\n"
   }
  },
