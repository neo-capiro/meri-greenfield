   "caseId": "AP-01",
   "group": "agent-product",
   "status": "SYNTHETIC_RUNNABLE",
   "synthetic": true,
   "title": "Resume restores opaque transcript and subagent entries",
   "capability": "durable.resume",
   "prompt": "SYNTHETIC: Resume the synthetic conversation after worker loss.",
   "expectedEvidence": [
    {
     "evidenceId": "AP-01-E1",
     "source": "session-store-deterministic-qualification",
     "path": "errors",
     "value": [],
     "required": true,
     "describes": "no refusal during append and readback"
    },
    {
     "evidenceId": "AP-01-E2",
     "source": "session-store-deterministic-qualification",
     "path": "main.0.compact.unknown",
     "value": [
      "verbatim",
      7,
      null
     ],
     "required": true,
     "describes": "opaque SDK entry preserved verbatim"
    },
    {
     "evidenceId": "AP-01-E3",
     "source": "session-store-deterministic-qualification",
     "path": "verification.transcripts",
     "value": 2,
     "required": true,
     "describes": "main and subagent transcripts verified"
    },
    {
     "evidenceId": "AP-01-E4",
     "source": "session-store-deterministic-qualification",
     "path": "verification.entries",
     "value": 4,
     "required": true,
     "describes": "every entry accounted for"
    }
   ],
   "permissions": {
    "principal": "synthetic-eval run binding",
    "scopes": [
     "tenant"
    ],
    "expected": "allowed"
   },
   "outputFormat": {
    "kind": "recovery-state"
   },
   "successCriteria": [
    "Opaque entries survive resume unchanged",
    "Subagent transcript is not dropped"
   ],
   "graders": [
    "output-format",
    "permissions",
    "factual-claims"
   ],
   "scenario": {
    "kind": "session-store",
    "scenario": "opaque-resume"
   }
  },
