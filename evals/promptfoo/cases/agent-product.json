   "status": "SYNTHETIC_RUNNABLE",
   "synthetic": true,
   "title": "Resubmitting the same request is acknowledged as a replay, not a second run",
   "capability": "conversation.submit",
   "prompt": "SYNTHETIC: Start a synthetic run, then press submit again.",
   "expectedEvidence": [
    {
     "evidenceId": "AP-04-E1",
     "source": "conversations-http",
     "path": "first.replayed",
     "value": false,
     "required": true,
     "describes": "first submission creates the run"
    },
    {
     "evidenceId": "AP-04-E2",
     "source": "conversations-http",
     "path": "second.replayed",
     "value": true,
     "required": true,
     "describes": "second submission is a replay"
    },
    {
     "evidenceId": "AP-04-E3",
     "source": "conversations-http",
     "path": "distinctRuns",
     "value": 1,
     "required": true,
     "describes": "exactly one run reaches the runtime"
    }
   ],
   "permissions": {
    "principal": "synthetic tenant-synthetic-ap actor",
    "scopes": [
     "client"
    ],
    "expected": "allowed"
   },
   "outputFormat": {
    "kind": "answer"
   },
   "successCriteria": [
    "Duplicate submit never creates a second run"
   ],
   "graders": [
    "output-format",
    "permissions",
    "factual-claims"
   ],
   "scenario": {
    "kind": "conversation-submit-replay",
    "tenantId": "tenant-synthetic-ap",
    "tag": "a0a1"
   }
  },
