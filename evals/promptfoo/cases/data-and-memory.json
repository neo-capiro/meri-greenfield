     "required": true,
     "describes": "stored request text served back to its own session"
    },
    {
     "evidenceId": "DM-01-E2",
     "source": "conversations-http",
     "path": "run.binding.tenantId",
     "value": "tenant-synthetic-dm",
     "required": true,
     "describes": "run bound to the authenticated synthetic tenant"
    }
   ],
   "permissions": {
    "principal": "synthetic tenant-synthetic-dm actor",
    "scopes": [
     "client"
    ],
    "expected": "allowed"
   },
   "outputFormat": {
    "kind": "answer"
   },
   "successCriteria": [
    "History is served only through the requesting session",
    "Every claim cites the stored request or run binding"
   ],
   "graders": [
    "output-format",
    "permissions",
    "factual-claims"
   ],
   "scenario": {
    "kind": "conversation-history",
    "tenantId": "tenant-synthetic-dm",
    "tag": "d0a1"
   }
  },
