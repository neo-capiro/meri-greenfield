  {
   "caseId": "CW-01",
   "group": "client-work",
   "status": "SYNTHETIC_RUNNABLE",
   "synthetic": true,
   "title": "Client-scoped file is served within the same client scope",
   "capability": "read_client_documents",
   "prompt": "SYNTHETIC: Save the synthetic client note and give me the file.",
   "expectedEvidence": [
    {
     "evidenceId": "CW-01-E1",
     "source": "artifact-service",
     "path": "version.mimeType",
     "value": "text/plain; charset=utf-8",
     "required": true,
     "describes": "canonical MIME type of the stored version"
    },
    {
     "evidenceId": "CW-01-E2",
     "source": "artifact-service",
     "path": "version.scopes.0.kind",
     "value": "client",
     "required": true,
     "describes": "version carries the client scope it was created under"
    },
    {
     "evidenceId": "CW-01-E3",
     "source": "artifact-service",
     "path": "version.binding.tenantId",
     "value": "tenant-synthetic-cw",
     "required": true,
     "describes": "version bound to the creating tenant"
    }
   ],
   "permissions": {
    "principal": "synthetic tenant-synthetic-cw actor",
    "scopes": [
     "client"
    ],
    "expected": "allowed"
   },
   "outputFormat": {
    "kind": "file",
    "fileFormat": "txt",
    "files": 1,
    "requiredText": [
     "Synthetic client note",
     "next step: synthetic follow-up"
    ],
    "maxBytes": 65536
   },
   "successCriteria": [
    "The downloaded bytes match the committed version",
    "The version keeps its client scope"
   ],
   "graders": [
    "output-format",
    "permissions",
    "usable-file",
    "factual-claims"
   ],
   "scenario": {
    "kind": "artifact-text-create",
    "tenantId": "tenant-synthetic-cw",
    "tag": "c0a1",
    "title": "Synthetic client note",
    "text": "Synthetic client note\nnext step: synthetic follow-up\n"
   }
  },
