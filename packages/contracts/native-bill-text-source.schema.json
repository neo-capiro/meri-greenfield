{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:meri:native-bill-text-source:1.0.0",
  "$defs": {
    "NativeBillTextSource": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "meri.native-bill-text-source/1"
        },
        "deliveryId": {
          "type": "string",
          "pattern": "^[-A-Za-z0-9_.:@/]{1,255}$"
        },
        "operation": {
          "type": "object",
          "properties": {
            "id": {
              "const": "read_bill_text"
            },
            "version": {
              "const": "0.2.0"
            }
          },
          "required": [
            "id",
            "version"
          ],
          "additionalProperties": false
        },
        "requestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "argumentsSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "resultSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "executionSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policyRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "source": {
          "type": "object",
          "properties": {
            "authoritativeOwner": {
              "const": "federal_evidence_current"
            },
            "billId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "versionCode": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "revisionId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "packageId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "provider": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "lineageKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "versionHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "textHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "authoritativeOwner",
            "billId",
            "versionCode",
            "revisionId",
            "packageId",
            "provider",
            "lineageKey",
            "versionHash",
            "textHash"
          ],
          "additionalProperties": false
        },
        "page": {
          "type": "object",
          "properties": {
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 30000000
            },
            "endOffset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 30000000
            },
            "totalCharacters": {
              "type": "integer",
              "minimum": 0,
              "maximum": 30000000
            },
            "textSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "pageComplete": {
              "const": true
            },
            "contentComplete": {
              "type": "boolean"
            },
            "paginationComplete": {
              "type": "boolean"
            },
            "truncated": {
              "type": "boolean"
            }
          },
          "required": [
            "offset",
            "endOffset",
            "totalCharacters",
            "textSha256",
            "pageComplete",
            "contentComplete",
            "paginationComplete",
            "truncated"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "deliveryId",
        "operation",
        "requestSha256",
        "argumentsSha256",
        "resultSha256",
        "executionSha256",
        "policyRevision",
        "source",
        "page"
      ],
      "additionalProperties": false
    },
    "NativeBillTextSourceEvent": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "0.1.0"
        },
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "binding": {
          "$ref": "urn:meri:contracts:0.1.0#/$defs/RunBinding"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "urn:meri:contracts:0.1.0#/$defs/Scope"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "type": {
          "const": "source.native-bill-text"
        },
        "data": {
          "$ref": "#/$defs/NativeBillTextSource"
        }
      },
      "required": [
        "contractVersion",
        "eventId",
        "binding",
        "sequence",
        "createdAt",
        "scopes",
        "type",
        "data"
      ],
      "additionalProperties": false
    },
    "BillTextSourceReadRequest": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "meri.bill-text-source-read/1"
        },
        "conversationId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "runId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "referenceId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "schemaVersion",
        "conversationId",
        "runId",
        "referenceId"
      ],
      "additionalProperties": false
    },
    "BillTextSourceReadResponse": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "meri.bill-text-source-read/1"
        },
        "event": {
          "$ref": "#/$defs/NativeBillTextSourceEvent"
        },
        "current": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 9000
            },
            "sourceModifiedAt": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "publishedAt": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "fetchedAt": {
              "type": "string",
              "format": "date-time"
            },
            "coverage": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "totalCharacters": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "pageComplete": {
                  "const": true
                },
                "contentComplete": {
                  "type": "boolean"
                },
                "paginationComplete": {
                  "type": "boolean"
                },
                "complete": {
                  "type": "boolean"
                },
                "truncated": {
                  "type": "boolean"
                },
                "nextCursor": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024,
                      "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "locator": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "offset": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "endOffset": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "offset",
                    "endOffset"
                  ]
                }
              },
              "required": [
                "totalCharacters",
                "pageComplete",
                "contentComplete",
                "paginationComplete",
                "complete",
                "truncated",
                "nextCursor",
                "locator"
              ]
            },
            "sourceLocator": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 4096
                },
                {
                  "type": "null"
                }
              ]
            },
            "linkStatus": {
              "enum": [
                "available",
                "unsafe"
              ]
            }
          },
          "required": [
            "text",
            "sourceModifiedAt",
            "publishedAt",
            "fetchedAt",
            "coverage",
            "sourceLocator",
            "linkStatus"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "event",
        "current"
      ],
      "additionalProperties": false
    }
  }
}
