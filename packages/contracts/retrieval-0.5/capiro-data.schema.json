        "clientId"
      ]
    },
    "CapiroDataPrivateRelation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "client_objectives",
            "client_activity",
            "client_team_roster",
            "client_account_owners",
            "client_targets",
            "client_profiles",
            "client_profile_codes",
            "client_people",
            "client_contacts",
            "client_engagement_tasks",
            "client_action_items",
            "client_tracked_bills",
            "client_outreach_campaigns",
            "client_campaign_recipients",
            "client_meetings",
            "research_portfolios",
            "research_portfolio_members",
            "classic_outreach_records"
          ]
        },
        "description": {
          "type": "string",
          "maxLength": 2048
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CapiroDataField"
          },
          "minItems": 1,
          "maxItems": 64
        },
        "primaryKey": {
          "type": "array",
