{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:meri:native-upload-source:1.0.0",
  "$defs": {
    "NativeUploadSource": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "meri.native-upload-source/1"
        },
        "deliveryId": {
          "type": "string",
          "pattern": "^[-A-Za-z0-9_.:@/]{1,255}$"
        },
        "operation": {
          "type": "object",
          "properties": {
            "id": {
              "const": "read_upload_source"
            },
            "version": {
              "const": "0.2.0"
            }
          },
          "required": [
            "id",
            "version"
          ],
          "additionalProperties": false
        },
        "requestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "argumentsSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "resultSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "executionSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policyRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "source": {
          "type": "object",
          "properties": {
            "authoritativeOwner": {
              "const": "upload_custody"
            },
            "uploadId": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "versionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "filename": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "mimeType": {
              "type": "string",
              "maxLength": 128
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10485760
            },
            "extractedSourceSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "extractionStatus": {
              "enum": [
                "available",
                "partial"
              ]
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{0,79}$"
              },
              "maxItems": 16
            }
          },
          "required": [
            "authoritativeOwner",
            "uploadId",
            "sha256",
            "versionId",
            "filename",
            "mimeType",
            "bytes",
            "extractedSourceSha256",
            "extractionStatus",
            "limitations"
          ],
          "additionalProperties": false
        },
        "page": {
          "type": "object",
          "properties": {
            "number": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "nextPage": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 255
                },
                {
                  "type": "null"
                }
              ]
            },
            "fragmentCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "extractionStatus": {
              "enum": [
                "available",
                "partial"
              ]
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{0,79}$"
              },
              "maxItems": 16
            }
          },
          "required": [
            "number",
            "count",
            "sha256",
            "nextPage",
            "fragmentCount",
            "extractionStatus",
            "limitations"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "deliveryId",
        "operation",
        "requestSha256",
        "argumentsSha256",
        "resultSha256",
        "executionSha256",
        "policyRevision",
        "source",
        "page"
      ],
      "additionalProperties": false
    },
    "NativeUploadSourceEvent": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "0.1.0"
        },
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "binding": {
          "$ref": "urn:meri:contracts:0.1.0#/$defs/RunBinding"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "urn:meri:contracts:0.1.0#/$defs/Scope"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "type": {
          "const": "source.native-upload"
        },
        "data": {
          "$ref": "#/$defs/NativeUploadSource"
        }
      },
      "required": [
        "contractVersion",
        "eventId",
        "binding",
        "sequence",
        "createdAt",
        "scopes",
        "type",
        "data"
      ],
      "additionalProperties": false
    }
  }
}
