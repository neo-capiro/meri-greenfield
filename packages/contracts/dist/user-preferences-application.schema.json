{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:meri:user-preferences-application:0.1.0",
  "$defs": {
    "UserPreferences": {
      "type": "object",
      "properties": {
        "theme": {
          "type": "string",
          "enum": [
            "system",
            "light",
            "dark"
          ]
        },
        "density": {
          "type": "string",
          "enum": [
            "comfortable",
            "compact"
          ]
        },
        "timezone": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "notifications": {
          "type": "object",
          "properties": {
            "runCompleted": {
              "type": "boolean"
            },
            "approvalRequested": {
              "type": "boolean"
            },
            "memoryReviewed": {
              "type": "boolean"
            }
          },
          "required": [
            "runCompleted",
            "approvalRequested",
            "memoryReviewed"
          ],
          "additionalProperties": false
        },
        "defaultClientId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "theme",
        "density",
        "timezone",
        "notifications",
        "defaultClientId"
      ],
      "additionalProperties": false
    },
    "UserPreferencesOwner": {
      "type": "object",
      "properties": {
        "tenantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "actorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "tenantId",
        "actorId"
      ],
      "additionalProperties": false
    },
    "UserPreferencesReadRequest": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "UserPreferencesSaveRequest": {
      "type": "object",
      "properties": {
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        },
        "preferences": {
          "$ref": "#/$defs/UserPreferences"
        }
      },
      "required": [
        "expectedRevision",
        "preferences"
      ],
      "additionalProperties": false
    },
    "UserPreferencesResponse": {
      "type": "object",
      "properties": {
        "owner": {
          "$ref": "#/$defs/UserPreferencesOwner"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "preferences": {
          "$ref": "#/$defs/UserPreferences"
        }
      },
      "required": [
        "owner",
        "revision",
        "preferences"
      ],
      "additionalProperties": false
    },
    "UserPreferencesErrorResponse": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "INVALID_REQUEST",
                "UNAUTHENTICATED",
                "ACCESS_DENIED",
                "MEMBERSHIP_REVOKED",
                "NOT_FOUND",
                "METHOD_NOT_ALLOWED",
                "DEADLINE",
                "MEMBERSHIP_CHANGED",
                "REQUEST_TOO_LARGE",
                "UNSUPPORTED_MEDIA_TYPE",
                "CANCELLED",
                "PRODUCT_UNAVAILABLE",
                "SETTINGS_REQUEST_INVALID",
                "SETTINGS_DOCUMENT_INVALID",
                "SETTINGS_FIELD_INVALID",
                "SETTINGS_CLIENT_REFUSED",
                "SETTINGS_REVISION_CONFLICT",
                "SETTINGS_STORE_UNAVAILABLE",
                "SETTINGS_STORE_STATE",
                "SETTINGS_COMMIT_UNKNOWN",
                "SETTINGS_UNAVAILABLE",
                "USER_PREFERENCES_UNAVAILABLE"
              ]
            },
            "outcome": {
              "type": "string",
              "enum": [
                "UNKNOWN",
                "RESULT_NOT_RELEASED"
              ]
            },
            "field": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
            }
          },
          "required": [
            "code"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    }
  }
}
