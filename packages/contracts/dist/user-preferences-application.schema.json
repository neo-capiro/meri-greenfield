{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:meri:user-preferences-application:0.1.0",
  "$defs": {
    "UserPreferences": {
      "type": "object",
      "properties": {
        "defaultModel": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "provider": {
                  "enum": [
                    "bedrock",
                    "claude-api"
                  ]
                },
                "modelId": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]{0,199}$"
                },
                "effort": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "enum": [
                        "low",
                        "medium",
                        "high",
                        "xhigh",
                        "max"
                      ]
                    }
                  ]
                }
              },
              "required": [
                "provider",
                "modelId",
                "effort"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "theme": {
          "type": "string",
          "enum": [
            "system",
            "light",
            "dark"
          ]
        },
        "density": {
          "type": "string",
          "enum": [
            "comfortable",
            "compact"
          ]
        },
        "timezone": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "notifications": {
          "type": "object",
          "properties": {
            "runCompleted": {
              "type": "boolean"
            },
            "approvalRequested": {
              "type": "boolean"
            },
            "memoryReviewed": {
              "type": "boolean"
            }
          },
          "required": [
            "runCompleted",
            "approvalRequested",
            "memoryReviewed"
          ],
          "additionalProperties": false
        },
        "defaultClientId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "defaultModel",
        "theme",
        "density",
        "timezone",
        "notifications",
        "defaultClientId"
      ],
      "additionalProperties": false
    },
    "UserPreferencesOwner": {
      "type": "object",
      "properties": {
        "tenantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "actorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "tenantId",
        "actorId"
      ],
      "additionalProperties": false
    },
    "UserPreferencesReadRequest": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "UserPreferencesSaveRequest": {
      "type": "object",
      "properties": {
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        },
        "preferences": {
          "$ref": "#/$defs/UserPreferences"
        }
      },
      "required": [
        "expectedRevision",
        "preferences"
      ],
      "additionalProperties": false
    },
    "UserPreferencesResponse": {
      "type": "object",
      "properties": {
        "owner": {
          "$ref": "#/$defs/UserPreferencesOwner"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "preferences": {
          "$ref": "#/$defs/UserPreferences"
        },
        "modelCatalog": {
          "type": "object",
          "properties": {
            "defaultSelection": {
              "type": "object",
              "properties": {
                "provider": {
                  "enum": [
                    "bedrock",
                    "claude-api"
                  ]
                },
                "modelId": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]{0,199}$"
                },
                "effort": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "enum": [
                        "low",
                        "medium",
                        "high",
                        "xhigh",
                        "max"
                      ]
                    }
                  ]
                }
              },
              "required": [
                "provider",
                "modelId",
                "effort"
              ],
              "additionalProperties": false
            },
            "models": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": {
                "type": "object",
                "properties": {
                  "provider": {
                    "enum": [
                      "bedrock",
                      "claude-api"
                    ]
                  },
                  "modelId": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]{0,199}$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "efforts": {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "string",
                          "enum": [
                            "low",
                            "medium",
                            "high",
                            "xhigh",
                            "max"
                          ]
                        }
                      ]
                    },
                    "minItems": 1,
                    "maxItems": 6,
                    "uniqueItems": true
                  },
                  "available": {
                    "type": "boolean"
                  },
                  "unavailableReason": {
                    "enum": [
                      null,
                      "provider_unconfigured",
                      "model_unqualified"
                    ]
                  }
                },
                "required": [
                  "provider",
                  "modelId",
                  "label",
                  "efforts",
                  "available",
                  "unavailableReason"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "defaultSelection",
            "models"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "owner",
        "revision",
        "preferences",
        "modelCatalog"
      ],
      "additionalProperties": false
    },
    "UserPreferencesErrorResponse": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "INVALID_REQUEST",
                "UNAUTHENTICATED",
                "ACCESS_DENIED",
                "MEMBERSHIP_REVOKED",
                "NOT_FOUND",
                "METHOD_NOT_ALLOWED",
                "DEADLINE",
                "MEMBERSHIP_CHANGED",
                "REQUEST_TOO_LARGE",
                "UNSUPPORTED_MEDIA_TYPE",
                "CANCELLED",
                "PRODUCT_UNAVAILABLE",
                "SETTINGS_REQUEST_INVALID",
                "SETTINGS_DOCUMENT_INVALID",
                "SETTINGS_FIELD_INVALID",
                "SETTINGS_CLIENT_REFUSED",
                "SETTINGS_REVISION_CONFLICT",
                "SETTINGS_STORE_UNAVAILABLE",
                "SETTINGS_STORE_STATE",
                "SETTINGS_COMMIT_UNKNOWN",
                "SETTINGS_UNAVAILABLE",
                "USER_PREFERENCES_UNAVAILABLE"
              ]
            },
            "outcome": {
              "type": "string",
              "enum": [
                "UNKNOWN",
                "RESULT_NOT_RELEASED"
              ]
            },
            "field": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
            }
          },
          "required": [
            "code"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    }
  }
}
