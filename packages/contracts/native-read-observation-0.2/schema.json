{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:meri:native-read-observation:0.2.0",
  "title": "Private finite funding, semantic KB and evidence-mode observation carrier; never an authority grant",
  "$ref": "#/$defs/NativeReadObservation",
  "$defs": {
    "NativeReadOperationRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "search_funding_opportunities",
            "get_funding_opportunity_requirements",
            "get_funding_opportunity",
            "get_opportunity_client_context",
            "get_opportunity_government_landscape",
            "search_client_knowledge",
            "search_federal_grants",
            "search_federal_awards",
            "search_program_elements",
            "get_program_element",
            "get_pe_budget_timeline",
            "search_sam_opportunities",
            "get_certification_status",
            "get_state_rule_status"
          ]
        },
        "version": {
          "const": "0.2.0"
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "NativeReadContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asOf": {
          "type": "string",
          "minLength": 24,
          "maxLength": 27,
          "pattern": "^(?:[0-9]{4}|[+-][0-9]{6})-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
          "description": "Must additionally round-trip exactly through Date.toISOString(), as required by the frozen observation instant owner."
        }
      },
      "required": [
        "asOf"
      ]
    },
    "NativeReadModeContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidenceAccuracyMode": {
          "enum": [
            "off",
            "shadow",
            "enforce"
          ]
        }
      },
      "required": [
        "evidenceAccuracyMode"
      ]
    },
    "NativeReadObservation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "meri-native-read-observation/1"
        },
        "operation": {
          "$ref": "#/$defs/NativeReadOperationRef"
        },
        "requestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "context": {
          "oneOf": [
            {
              "$ref": "#/$defs/NativeReadContext"
            },
            {
              "$ref": "#/$defs/NativeReadModeContext"
            },
            {
              "$ref": "#/$defs/NativeCertificationContext"
            },
            {
              "$ref": "#/$defs/NativeRuleStatusContext"
            },
            {
              "$ref": "#/$defs/NativeSamContext"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "operation",
        "requestSha256",
        "context"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "type": "object",
                "properties": {
                  "id": {
                    "enum": [
                      "search_federal_grants",
                      "search_federal_awards",
                      "search_program_elements",
                      "get_program_element",
                      "get_pe_budget_timeline"
                    ]
                  }
                },
                "required": [
                  "id"
                ]
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "properties": {
              "context": {
                "$ref": "#/$defs/NativeReadModeContext"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "type": "object",
                "properties": {
                  "id": {
                    "enum": [
                      "search_funding_opportunities",
                      "get_funding_opportunity_requirements",
                      "get_funding_opportunity",
                      "get_opportunity_client_context",
                      "get_opportunity_government_landscape",
                      "search_client_knowledge"
                    ]
                  }
                },
                "required": [
                  "id"
                ]
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "properties": {
              "context": {
                "$ref": "#/$defs/NativeReadContext"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "type": "object",
                "properties": {
                  "id": {
                    "enum": [
                      "get_certification_status"
                    ]
                  }
                },
                "required": [
                  "id"
                ]
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "properties": {
              "context": {
                "$ref": "#/$defs/NativeCertificationContext"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "type": "object",
                "properties": {
                  "id": {
                    "enum": [
                      "get_state_rule_status"
                    ]
                  }
                },
                "required": [
                  "id"
                ]
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "properties": {
              "context": {
                "$ref": "#/$defs/NativeRuleStatusContext"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "type": "object",
                "properties": {
                  "id": {
                    "enum": [
                      "search_sam_opportunities"
                    ]
                  }
                },
                "required": [
                  "id"
                ]
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "properties": {
              "context": {
                "$ref": "#/$defs/NativeSamContext"
              }
            }
          }
        }
      ]
    },
    "NativeCertificationContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "comparisonLocale": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128
        }
      },
      "required": [
        "comparisonLocale"
      ]
    },
    "NativeRuleStatusContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stageAsOf": {
          "type": "string",
          "minLength": 24,
          "maxLength": 27,
          "pattern": "^(?:[0-9]{4}|[+-][0-9]{6})-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
          "description": "Must additionally round-trip exactly through Date.toISOString(), as required by the frozen observation instant owner."
        },
        "commentAsOf": {
          "type": "string",
          "minLength": 24,
          "maxLength": 27,
          "pattern": "^(?:[0-9]{4}|[+-][0-9]{6})-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
          "description": "Must additionally round-trip exactly through Date.toISOString(), as required by the frozen observation instant owner."
        }
      },
      "required": [
        "stageAsOf",
        "commentAsOf"
      ]
    },
    "NativeSamContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asOf": {
          "type": "string",
          "minLength": 24,
          "maxLength": 27,
          "pattern": "^(?:[0-9]{4}|[+-][0-9]{6})-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
          "description": "Must additionally round-trip exactly through Date.toISOString(), as required by the frozen observation instant owner."
        },
        "sourceStatusAsOf": {
          "type": "string",
          "minLength": 24,
          "maxLength": 27,
          "pattern": "^(?:[0-9]{4}|[+-][0-9]{6})-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
          "description": "Must additionally round-trip exactly through Date.toISOString(), as required by the frozen observation instant owner."
        },
        "sourceHealthAsOf": {
          "type": "string",
          "minLength": 24,
          "maxLength": 27,
          "pattern": "^(?:[0-9]{4}|[+-][0-9]{6})-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
          "description": "Must additionally round-trip exactly through Date.toISOString(), as required by the frozen observation instant owner."
        },
        "evidenceAccuracyMode": {
          "enum": [
            "off",
            "shadow",
            "enforce"
          ]
        }
      },
      "required": [
        "asOf",
        "sourceStatusAsOf",
        "sourceHealthAsOf",
        "evidenceAccuracyMode"
      ]
    }
  }
}
