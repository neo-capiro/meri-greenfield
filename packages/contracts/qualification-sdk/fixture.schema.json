{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:meri:qualification:sdk-fixture:1",
  "title": "Private SDK interruption fixture channel — structural DATA only",
  "$defs": {
    "Clock": {
      "type": "object",
      "properties": {
        "t0Ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "deadlineMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "cleanupDeadlineMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "t0Ms",
        "deadlineMs",
        "cleanupDeadlineMs"
      ],
      "additionalProperties": false
    },
    "Namespace": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "format": "uuid"
        },
        "cwd": {
          "const": "/workspace/conversation"
        },
        "projectKey": {
          "const": "-workspace-conversation"
        }
      },
      "required": [
        "sessionId",
        "cwd",
        "projectKey"
      ],
      "additionalProperties": false
    },
    "RuntimePins": {
      "type": "object",
      "properties": {
        "sourceCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "imageDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "sdkVersion": {
          "const": "0.3.295"
        },
        "cliVersion": {
          "const": "2.1.295"
        },
        "contractsVersion": {
          "const": "0.1.0"
        },
        "contractsSchemaSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "skillsManifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "sourceCommit",
        "imageDigest",
        "sdkVersion",
        "cliVersion",
        "contractsVersion",
        "contractsSchemaSha256",
        "skillsManifestSha256"
      ],
      "additionalProperties": false
    },
    "IdentityMapping": {
      "type": "object",
      "properties": {
        "mappingId": {
          "type": "string",
          "format": "uuid"
        },
        "grantId": { "type": "string", "format": "uuid" },
        "admittedAtMs": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "expiresAtMs": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "taskArn": {
          "type": "string",
          "pattern": "^arn:aws:ecs:us-east-1:967807252336:task/[A-Za-z0-9_-]{1,255}/[a-f0-9]{32}$",
          "maxLength": 370
        },
        "attempt": {
          "type": "integer",
          "enum": [
            1,
            2
          ]
        },
        "fence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "policyRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "canonical": {
          "$ref": "urn:meri:contracts:0.1.0#/$defs/RunBinding"
        }
