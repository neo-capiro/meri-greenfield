    "FixtureContext": {
      "type": "object",
      "properties": {
        "channelVersion": {
          "const": "sdk-fixture/1"
        },
        "profile": {
          "const": "sdk-interruption-fixture-v1"
        },
        "runUuid": {
          "type": "string",
          "format": "uuid"
