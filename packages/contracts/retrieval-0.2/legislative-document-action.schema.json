{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:meri:retrieval:legislative-document-action:0.2.0",
  "$defs": {
    "LegislativeDocumentSource": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "LegislativeDocumentCitation": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        }
      },
      "required": [
        "kind",
        "id",
        "revision",
        "locator",
        "start",
        "end",
        "quote"
      ],
      "additionalProperties": false
    },
    "LegislativeDocumentSelectionCitation": {
      "type": "object",
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        }
      },
      "required": [
        "documentId",
        "revision",
        "locator",
        "start",
        "end",
        "quote"
      ],
      "additionalProperties": false
    },
    "LegislativeDocumentBriefingSelection": {
      "type": "object",
      "properties": {
        "clientId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[a-f0-9-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "folderId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[a-f0-9-]+$"
        },
        "jurisdiction": {
          "type": "string",
          "pattern": "^(US|[A-Z]{2})$"
        },
        "sessionKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "template": {
          "enum": [
            "research_update",
            "daily_legislative_brief",
            "morning_news_brief"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "analysis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30000
        },
        "cutoff": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "sources": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/LegislativeDocumentSource"
          }
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 150,
          "items": {
            "$ref": "#/$defs/LegislativeDocumentCitation"
          }
        }
      },
      "required": [
        "folderId",
        "template",
        "title",
        "analysis",
        "cutoff",
        "timezone",
        "sources",
        "citations"
      ],
      "additionalProperties": false
    },
    "LegislativeDocumentBriefingInput": {
      "$ref": "#/$defs/LegislativeDocumentBriefingSelection"
    },
    "LegislativeDocumentBriefingRequest": {
      "type": "object",
      "properties": {
        "clientId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[a-f0-9-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "folderId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[a-f0-9-]+$"
        },
        "jurisdiction": {
          "type": "string",
          "pattern": "^(US|[A-Z]{2})$"
        },
        "sessionKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "template": {
          "enum": [
            "research_update",
            "daily_legislative_brief",
            "morning_news_brief"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "analysis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30000
        },
        "cutoff": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "sources": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/LegislativeDocumentSource"
          }
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 150,
          "items": {
            "$ref": "#/$defs/LegislativeDocumentCitation"
          }
        },
        "requestKey": {
          "type": "string",
          "minLength": 8,
          "maxLength": 180
        }
      },
      "required": [
        "folderId",
        "template",
        "title",
        "analysis",
        "cutoff",
        "timezone",
        "sources",
        "citations",
        "requestKey",
        "clientId"
      ],
      "additionalProperties": false
    },
    "LegislativeDocumentResearchSelection": {
      "type": "object",
      "properties": {
        "clientId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[a-f0-9-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "folderId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[a-f0-9-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "jurisdiction": {
          "type": "string",
          "pattern": "^(US|[A-Z]{2})$"
        },
        "sessionKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "analysis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30000
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "sessionKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              }
            },
            "required": [
              "id",
              "revision"
            ],
            "additionalProperties": false
          }
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/LegislativeDocumentSelectionCitation"
          }
        },
        "allowCrossBill": {
          "type": "boolean"
        },
        "rightSessionKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        }
      },
      "required": [
        "jurisdiction",
        "sessionKey",
        "title",
        "analysis",
        "documents",
        "citations"
      ],
      "additionalProperties": false
    },
    "LegislativeDocumentResearchInput": {
      "$ref": "#/$defs/LegislativeDocumentResearchSelection"
    },
    "LegislativeDocumentResearchRequest": {
      "type": "object",
      "properties": {
        "clientId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[a-f0-9-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "folderId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[a-f0-9-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "jurisdiction": {
          "type": "string",
          "pattern": "^(US|[A-Z]{2})$"
        },
        "sessionKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "analysis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30000
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "sessionKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              }
            },
            "required": [
              "id",
              "revision"
            ],
            "additionalProperties": false
          }
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/LegislativeDocumentSelectionCitation"
          }
        },
        "allowCrossBill": {
          "type": "boolean"
        },
        "rightSessionKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "requestKey": {
          "type": "string",
          "minLength": 8,
          "maxLength": 180
        }
      },
      "required": [
        "jurisdiction",
        "sessionKey",
        "title",
        "analysis",
        "documents",
        "citations",
        "requestKey",
        "clientId",
        "folderId"
      ],
      "additionalProperties": false
    },
    "LegislativeDocumentContext": {
      "type": "object",
      "properties": {
        "conversationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[a-f0-9-]+$"
        },
        "selectedClientId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[a-f0-9-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "identityRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "membershipRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contextRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "conversationId",
        "selectedClientId",
        "identityRevision",
        "membershipRevision",
        "contextRevision"
      ],
      "additionalProperties": false
    },
    "LegislativeDocumentStatus": {
      "enum": [
        "proposed",
        "approved",
        "executing",
        "succeeded",
        "failed_retryable",
        "failed_terminal",
        "outcome_unknown",
        "blocked",
        "dismissed",
        "expired"
      ]
    },
    "LegislativeDocumentEffect": {
      "enum": [
        "complete",
        "selection_only",
        "unknown"
      ]
    },
    "LegislativeDocumentReceipt": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "complete",
            "selection_only"
          ]
        },
        "selectionId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "documentId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "location": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "reused": {
          "type": "boolean"
        },
        "request": {
          "anyOf": [
            {
              "$ref": "#/$defs/LegislativeDocumentBriefingRequest"
            },
            {
              "$ref": "#/$defs/LegislativeDocumentResearchRequest"
            }
          ]
        }
      },
      "required": [
        "state",
        "selectionId",
        "documentId",
        "location",
        "reused",
        "request"
      ],
      "additionalProperties": false
    },
    "LegislativeDocumentCoreResult": {
      "type": "object",
      "properties": {
        "version": {
          "const": "0.1.0"
        },
        "proposalId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[a-f0-9-]+$"
        },
        "status": {
          "$ref": "#/$defs/LegislativeDocumentStatus"
        },
        "operation": {
          "enum": [
            "prepare_legiwatch_briefing",
            "save_legislative_research"
          ]
        },
        "request": {
          "anyOf": [
            {
              "$ref": "#/$defs/LegislativeDocumentBriefingRequest"
            },
            {
              "$ref": "#/$defs/LegislativeDocumentResearchRequest"
            }
          ]
        },
        "context": {
          "$ref": "#/$defs/LegislativeDocumentContext"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/LegislativeDocumentReceipt"
            },
            {
              "type": "null"
            }
          ]
        },
        "effect": {
          "anyOf": [
            {
              "$ref": "#/$defs/LegislativeDocumentEffect"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "proposalId",
        "status",
        "operation",
        "request",
        "context",
        "createdAt",
        "expiresAt",
        "receipt",
        "effect"
      ],
      "additionalProperties": false
    },
    "LegislativeDocumentProposal": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "legislative_document_action"
        },
        "binding": {
          "$ref": "urn:meri:contracts:0.1.0#/$defs/RunBinding"
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "urn:meri:contracts:0.1.0#/$defs/Scope"
          },
          "minItems": 1,
          "maxItems": 1
        },
        "operation": {
          "enum": [
            "prepare_legiwatch_briefing",
            "save_legislative_research"
          ]
        },
        "proposalId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[a-f0-9-]+$"
        },
        "request": {
          "anyOf": [
            {
              "$ref": "#/$defs/LegislativeDocumentBriefingRequest"
            },
            {
              "$ref": "#/$defs/LegislativeDocumentResearchRequest"
            }
          ]
        },
        "context": {
          "$ref": "#/$defs/LegislativeDocumentContext"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "commandSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "kind",
        "binding",
        "scopes",
        "operation",
        "proposalId",
        "request",
        "context",
        "createdAt",
        "expiresAt",
        "commandSha256"
      ],
      "additionalProperties": false
    },
    "LegislativeDocumentPrepared": {
      "type": "object",
      "properties": {
        "status": {
          "const": "approval_required"
        },
        "proposal": {
          "$ref": "#/$defs/LegislativeDocumentProposal"
        }
      },
      "required": [
        "status",
        "proposal"
      ],
      "additionalProperties": false
    }
  }
}
