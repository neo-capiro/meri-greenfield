            { "type": "string", "minLength": 1, "maxLength": 128 },
            { "type": "null" }
          ]
        },
        "deadline": {
          "anyOf": [
            { "type": "string", "format": "date-time", "pattern": "Z$" },
            { "type": "null" }
          ]
        },
        "deadlineSource": {
          "anyOf": [
            { "$ref": "#/$defs/DeadlineSource" },
            { "type": "null" }
          ]
        },
        "ownerUserId": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 128 },
            { "type": "null" }
          ]
        },
        "priority": { "type": "number" },
        "confidence": { "$ref": "#/$defs/ConfidenceBands" },
        "uncertainty": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 4000 },
            { "type": "null" }
          ]
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/EvidenceRef" },
          "minItems": 0,
          "maxItems": 4096
        },
        "status": { "$ref": "#/$defs/ActionStatus" },
        "dismissalReason": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 4000 },
            { "type": "null" }
          ]
        },
        "outcome": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 4000 },
            { "type": "null" }
          ]
        },
        "createdAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "updatedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "body": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "recordKind": { "const": "action_recommendation" },
        "recommendation": { "const": true },
        "acceptedAsTask": { "const": false },
        "nativeCompletion": { "$ref": "#/$defs/ActionItemNativeCompletion" },
        "sourceProof": { "$ref": "#/$defs/ActionItemSourceProof" }
      },
      "required": [
