        "districtKey",
        "clientId",
        "clientName",
        "peCode",
        "programId",
        "deltaId",
        "actionType",
        "issueTitle",
        "whatChanged",
        "whyItMatters",
        "recommendedAction",
        "targetAudience",
        "suggestedArtifactType",
        "deadline",
        "deadlineSource",
        "ownerUserId",
        "priority",
        "confidence",
        "uncertainty",
        "evidence",
        "status",
        "dismissalReason",
        "outcome",
        "createdAt",
        "updatedAt",
        "title",
        "body",
        "recordKind",
        "recommendation",
        "acceptedAsTask",
        "nativeCompletion",
        "sourceProof"
      ],
      "additionalProperties": false
    },
    "ActionItemClientScopedPageCoverage": {
      "type": "object",
      "properties": {
        "sourceStatus": { "type": "string", "enum": ["healthy", "degraded"] },
        "sourceReason": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 200 },
            { "type": "null" }
          ]
        },
        "complete": { "type": "boolean" },
        "partial": { "type": "boolean" },
        "paginationComplete": { "type": "boolean" },
        "hasMore": { "type": "boolean" },
        "nextCursor": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 4096 },
            { "type": "null" }
          ]
        },
        "totalIsExactForScope": { "const": true },
        "absenceSupported": { "type": "boolean" },
        "note": { "type": "string", "minLength": 1, "maxLength": 500 }
      },
      "required": [
        "sourceStatus",
        "sourceReason",
        "complete",
        "partial",
        "paginationComplete",
        "hasMore",
        "nextCursor",
        "totalIsExactForScope",
        "absenceSupported",
        "note"
      ],
      "additionalProperties": false
    },
    "ActionItemClientScopedPage": {
      "type": "object",
      "properties": {
        "kind": { "const": "action-item-client-scoped-page" },
        "contractVersion": { "const": "0.2.0" },
        "operation": {
          "type": "object",
          "properties": {
            "id": { "const": "query_action_items" },
            "version": { "const": "0.2.0" }
          },
          "required": ["id", "version"],
          "additionalProperties": false
        },
        "requestId": { "type": "string", "format": "uuid" },
        "traceId": { "type": "string", "format": "uuid" },
        "binding": { "$ref": "urn:meri:contracts:0.1.0#/$defs/RunBinding" },
        "subject": { "$ref": "urn:meri:retrieval:common:0.2.0#/$defs/ResolvedSubject" },
        "window": { "$ref": "urn:meri:retrieval:common:0.2.0#/$defs/NormalizedWindow" },
        "argumentsSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "appliedFilters": {
          "$ref": "urn:meri:retrieval:retrieval:0.2.0#/$defs/EvidenceEnvelope/properties/appliedFilters"
        },
        "generatedAt": { "type": "string", "format": "date-time" },
        "sources": {
          "type": "array",
          "items": { "$ref": "urn:meri:retrieval:retrieval:0.2.0#/$defs/SourceState" },
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "coverage": { "$ref": "urn:meri:retrieval:retrieval:0.2.0#/$defs/Coverage" },
        "selection": { "$ref": "#/$defs/ActionItemClientScopedSelection" },
        "order": {
          "type": "string",
          "enum": [
            "deadline-asc_nulls-last_priority-desc_id-asc-owner-unconfirmed",
            "priority-desc_deadline-asc_nulls-last_id-asc-owner-unconfirmed"
          ]
        },
        "snapshotVersionId": { "type": "null" },
        "clientId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "scope": { "$ref": "#/$defs/ActionItemReadScope" },
        "total": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "returned": { "type": "integer", "minimum": 0, "maximum": 50 },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/ActionItemReadRow" },
          "minItems": 0,
          "maxItems": 50
        },
        "pageCoverage": { "$ref": "#/$defs/ActionItemClientScopedPageCoverage" },
        "continuation": {
          "$ref": "urn:meri:retrieval:retrieval:0.2.0#/$defs/EvidenceEnvelope/properties/continuation"
        },
        "evidenceReady": { "const": false },
        "negativeAssertion": {
          "type": "object",
          "properties": { "kind": { "const": "none" } },
          "required": ["kind"],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "contractVersion",
        "operation",
        "requestId",
        "traceId",
        "binding",
        "subject",
        "window",
        "argumentsSha256",
        "appliedFilters",
        "generatedAt",
        "sources",
        "coverage",
        "selection",
        "order",
        "snapshotVersionId",
        "clientId",
        "scope",
        "total",
        "returned",
        "actions",
        "pageCoverage",
        "continuation",
        "evidenceReady",
        "negativeAssertion"
      ],
      "additionalProperties": false
    }
  }
