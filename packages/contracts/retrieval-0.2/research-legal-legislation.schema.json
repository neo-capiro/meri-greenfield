      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "$ref": "#/$defs/ResearchLegalScope"
        },
        "query": {
          "type": "string"
        },
        "versionPolicy": {
          "enum": [
            "any_retained",
            "current_extractions",
            "newest_dated_text"
          ]
        },
        "versionStage": {
          "enum": [
            "all",
            "enrolled",
