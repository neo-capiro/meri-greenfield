{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:meri:retrieval:research-legal-legislation:0.2.0",
  "title": "Private retained legislative and legal evidence projections; no parser, source or current authority qualification",
  "$defs": {
    "ResearchLegalScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jurisdiction": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "sessionKey": {
          "type": "string"
        },
        "folderId": {
          "type": [
            "string",
            "null"
          ]
        },
        "clientId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      },
      "required": [
        "jurisdiction",
        "sessionKey",
        "folderId",
        "clientId"
      ]
    },
    "ResearchLegalLegislationContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clientResolution": {
          "$ref": "urn:meri:retrieval:outreach-query:0.2.0#/$defs/OutreachQueryContext/properties/clientResolution"
        },
        "citationResolution": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "citation": {
                  "type": "string"
                },
                "referenceId": {
                  "type": "string",
                  "minLength": 1
                },
                "code": {
                  "enum": [
                    "statute",
                    "constitution"
                  ]
                }
              },
              "required": [
                "citation",
                "referenceId",
                "code"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "clientResolution",
        "citationResolution"
      ]
    },
