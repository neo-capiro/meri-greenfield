        "end": {
          "type": "integer",
          "minimum": 0
        },
        "quote": {
          "type": "string"
        },
        "expression": {
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "quote",
        "expression"
      ]
    },
    "ResearchLegalExcerpt": {
      "oneOf": [
        {
          "$ref": "#/$defs/ResearchLegalQueryEvidence"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start": {
              "const": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0,
              "maximum": 280
            },
            "quote": {
              "type": "string"
            }
          },
          "required": [
            "start",
            "end",
            "quote"
          ]
        }
      ]
    },
    "ResearchLegalQueryEvaluation": {
      "type": "object",
