    "ResearchLegalQueryAst": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "term"
            },
            "value": {
              "type": "string"
            },
            "wildcard": {
              "enum": [
                "none",
                "prefix",
                "suffix"
              ]
            }
          },
          "required": [
            "kind",
            "value",
            "wildcard"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "phrase"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "not"
            },
            "child": {
              "$ref": "#/$defs/ResearchLegalQueryAst"
            }
          },
          "required": [
            "kind",
            "child"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "and",
                "or"
              ]
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ResearchLegalQueryAst"
              }
            }
          },
          "required": [
            "kind",
            "children"
          ]
        }
      ]
    },
    "ResearchLegalQueryCompilation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "raw": {
          "type": "string"
        },
        "parserVersion": {
          "const": "legiwatch-query-v1"
        },
        "status": {
          "const": "supported"
        },
        "ast": {
          "$ref": "#/$defs/ResearchLegalQueryAst"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 0
        },
        "interpretation": {
          "type": "string"
        }
      },
      "required": [
        "raw",
        "parserVersion",
        "status",
        "ast",
        "reasons",
        "interpretation"
      ]
    },
    "ResearchLegalQueryEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
