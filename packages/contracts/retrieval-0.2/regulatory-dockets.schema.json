{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:meri:retrieval:regulatory-dockets:0.2.0",
  "$defs": {
    "RegulatoryDocketsQueryInput": {
      "type": "object",
      "properties": {
        "upcomingOnly": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "agencyId": {
          "type": [
            "string",
            "null"
          ]
        },
        "documentType": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "RegulatoryDocketRow": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "documentId": {
          "type": "string"
        },
        "agencyId": {
          "type": "string"
        },
        "docketId": {
          "type": [
            "string",
            "null"
          ]
        },
        "documentType": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "postedDate": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "^\\d{4}-"
        },
        "commentStartDate": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "^\\d{4}-"
        },
        "commentEndDate": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "^\\d{4}-"
        },
        "frDocNum": {
          "type": [
            "string",
            "null"
          ]
        },
        "subtype": {
          "type": [
            "string",
            "null"
          ]
        },
        "withdrawn": {
          "type": "boolean"
        },
        "lastModified": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "^\\d{4}-"
        },
        "syncedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-"
        }
      },
      "required": [
        "id",
        "documentId",
        "agencyId",
        "docketId",
        "documentType",
        "title",
        "postedDate",
        "commentStartDate",
        "commentEndDate",
        "frDocNum",
        "subtype",
        "withdrawn",
        "lastModified",
        "syncedAt"
      ],
      "additionalProperties": false
    },
    "RegulatoryDocketsQueryOutput": {
      "type": "object",
      "properties": {
        "tool": {
          "const": "query_regulatory_dockets"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-"
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "results": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/RegulatoryDocketRow"
          }
        },
        "windowDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        }
      },
      "required": [
        "tool",
        "generatedAt",
        "total",
        "results"
      ],
      "additionalProperties": false
    }
  }
}
