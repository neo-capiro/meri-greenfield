        "value",
        "fiscalYear",
        "stage",
        "stageLabel",
        "legislativeVehicle",
        "cycleClass",
        "isProjection",
        "unit"
      ],
      "additionalProperties": false
    },
    "ProgramElementStage": {
      "enum": [
        "request",
        "hasc",
        "sasc",
        "hacd",
        "sacd",
        "conference",
        "enacted",
        "none"
      ]
    },
    "ProgramElementVehicle": {
      "enum": [
