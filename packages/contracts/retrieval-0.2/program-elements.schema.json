        "stageLabel": {
          "type": "string"
        },
        "legislativeVehicle": {
          "enum": [
            "request",
            "authorization",
            "authorization_conference",
            "appropriations",
            "appropriations_conference",
            "enacted",
            "none"
          ]
        },
        "cycleClass": {
          "enum": [
            "historical",
            "current",
            "outyear",
            "unknown"
          ]
        },
        "isProjection": {
          "type": "boolean"
        },
        "unit": {
          "const": "USD millions"
        },
        "enactmentStatus": {
          "enum": [
            "enacted",
            "not_enacted",
            "unknown"
          ]
        },
        "vehicleType": {
          "enum": [
            "budget_request",
            "authorization",
            "appropriation",
            "unknown"
          ]
        },
        "originalUnit": {
          "anyOf": [
            {
              "enum": [
                "dollars",
                "thousands",
                "millions"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "originalValue": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/ProgramElementClaimSource"
        },
        "semantics": {
          "type": "string"
        }
      },
