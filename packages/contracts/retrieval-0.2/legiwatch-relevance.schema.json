        "tool": {
          "const": "preview_legiwatch_relevance"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "selection": {
          "$ref": "#/$defs/RelevancePreviewInput"
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/RelevanceDiscovery"
            },
            {
              "$ref": "#/$defs/RelevanceVerified"
            }
          ]
        },
        "effects": {
          "type": "array",
          "maxItems": 0
