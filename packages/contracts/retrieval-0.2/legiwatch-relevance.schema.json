            "suggestionId": {
              "type": "string",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-8][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
            },
            "version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "origin": {
              "const": "semantic"
            },
            "state": {
              "const": "pending"
            }
          },
          "required": [
            "binding",
            "suggestionId",
            "version",
            "origin",
            "state"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "request",
        "outcome",
        "payload"
      ],
      "additionalProperties": false
