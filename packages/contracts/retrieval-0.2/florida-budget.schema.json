{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:meri:retrieval:florida-budget:0.2.0",
  "title": "Private stored Florida budget projection; source and authorization unavailable",
  "$defs": {
    "FloridaBudgetOperationId": {
      "const": "get_florida_budget_project"
    },
    "FloridaBudgetAuthority": {
      "const": "Source quotations retain their document identity. Meri relevance is an inference for review; keyword grammar and current folder decisions control assignments."
    },
    "FloridaBudgetNotice": {
      "const": "Selected publisher evidence. Requests and chamber alternatives are not awards. No statewide aggregate is inferred."
    },
    "FloridaBudgetRequest": {
      "type": "object",
      "properties": {
        "q": {
          "type": [
            "string",
            "null"
          ]
        },
        "fiscalYear": {
          "type": [
            "string",
            "null"
          ]
        },
        "projectId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sessionKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "folderId": {
          "type": [
            "string",
            "null"
          ]
        },
        "clientId": {
          "type": [
            "string",
            "null"
          ]
        },
        "offset": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "FloridaBudgetInput": {
      "type": "object",
      "properties": {
        "q": {
          "type": "string"
        },
        "fiscalYear": {
          "type": "string",
          "pattern": "^20[0-9]{2}-[0-9]{2}$"
        },
        "projectId": {
          "type": "string"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "sessionKey": {
          "type": "string"
        },
        "folderId": {
          "type": [
            "string",
            "null"
          ]
        },
        "clientId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "q",
        "fiscalYear",
        "projectId",
        "offset",
        "sessionKey",
        "folderId",
        "clientId"
      ],
      "additionalProperties": false
    },
    "FloridaBudgetScope": {
      "type": "object",
      "properties": {
        "jurisdiction": {
          "const": "FL"
        },
        "sessionKey": {
          "type": "string"
        },
        "folderId": {
          "type": [
            "string",
            "null"
          ]
        },
        "clientId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "jurisdiction",
        "sessionKey",
        "folderId",
        "clientId"
      ],
      "additionalProperties": false
    },
    "FloridaBudgetContext": {
      "type": "object",
      "properties": {
        "asOf": {
          "type": "string",
          "format": "date-time"
        },
        "effectiveScope": {
          "$ref": "#/$defs/FloridaBudgetScope"
        },
        "clientResolution": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "selector": {
                  "type": "string"
                },
                "clientId": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "required": [
                "selector",
                "clientId"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "asOf",
        "effectiveScope",
        "clientResolution"
      ],
      "additionalProperties": false
    },
    "FloridaBudgetAmount": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "observation": {}
      },
      "required": [
        "id",
        "observation"
      ],
      "additionalProperties": false
    },
    "FloridaBudgetRecentAmount": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "observation": {}
      },
      "required": [
        "project_id",
        "id",
        "observation"
      ],
      "additionalProperties": false
    },
    "FloridaBudgetProject": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "fiscal_year": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "agency": {
          "type": [
            "string",
            "null"
          ]
        },
        "identities": {},
        "relations": {},
        "evidence": {},
        "saved": {
          "type": "boolean"
        },
        "tracking_version": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        },
        "recentAmounts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FloridaBudgetRecentAmount"
          },
          "maxItems": 4
        }
      },
      "required": [
        "id",
        "fiscal_year",
        "title",
        "agency",
        "identities",
        "relations",
        "evidence",
        "saved",
        "tracking_version",
        "recentAmounts"
      ],
      "additionalProperties": false
    },
    "FloridaBudgetDocument": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "source_url": {
          "type": "string"
        },
        "content_hash": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "fiscal_year": {
          "type": "string"
        },
        "session_key": {
          "type": "string"
        },
        "chamber": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "offer": {
          "type": [
            "string",
            "null"
          ]
        },
        "publication_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "complete": {
          "type": "boolean"
        },
        "metadata": {}
      },
      "required": [
        "id",
        "publisher",
        "source_url",
        "content_hash",
        "title",
        "fiscal_year",
        "session_key",
        "chamber",
        "stage",
        "role",
        "offer",
        "publication_date",
        "observed_at",
        "complete",
        "metadata"
      ],
      "additionalProperties": false
    },
    "FloridaBudgetEvent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "document_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "new_document",
            "amount_change",
            "stage_change",
            "proviso_change",
            "veto_outcome",
            "schedule_revision"
          ]
        },
        "payload": {},
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "title": {
          "type": "string"
        },
        "source_url": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        },
        "fiscal_year": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "project_id",
        "document_id",
        "kind",
        "payload",
        "observed_at",
        "title",
        "source_url",
        "stage",
        "fiscal_year"
      ],
      "additionalProperties": false
    },
    "FloridaBudgetResult": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "#/$defs/FloridaBudgetScope"
        },
        "fiscalYear": {
          "type": "string"
        },
        "projects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FloridaBudgetProject"
          },
          "maxItems": 100
        },
        "nextOffset": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 100,
              "maximum": 10100
            },
            {
              "type": "null"
            }
          ]
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FloridaBudgetDocument"
          },
          "maxItems": 101
        },
        "amounts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FloridaBudgetAmount"
          },
          "maxItems": 501
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FloridaBudgetEvent"
          },
          "maxItems": 101
        },
        "notice": {
          "$ref": "#/$defs/FloridaBudgetNotice"
        }
      },
      "required": [
        "scope",
        "fiscalYear",
        "projects",
        "nextOffset",
        "documents",
        "amounts",
        "events",
        "notice"
      ],
      "additionalProperties": false
    },
    "FloridaBudgetOutput": {
      "type": "object",
      "properties": {
        "tool": {
          "$ref": "#/$defs/FloridaBudgetOperationId"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "result": {
          "$ref": "#/$defs/FloridaBudgetResult"
        },
        "authority": {
          "$ref": "#/$defs/FloridaBudgetAuthority"
        }
      },
      "required": [
        "tool",
        "generatedAt",
        "result",
        "authority"
      ],
      "additionalProperties": false
    }
  }
}
