{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:meri:retrieval:district-nexus:0.2.0",
  "$comment": "Private source-only projection. Meri lineage wrapper is new; reported flags, fact basis, coverage and gaps prove no current authorization, completeness or source truth. Text/caveat ceilings are Meri transport admission, not source limits. Both source flags and current actor/client-wall authorization remain adapter obligations.",
  "$defs": {
    "DistrictNexusContext": {
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "urn:meri:contracts:0.1.0#/$defs/RunBinding"
        },
        "subject": {
          "$ref": "urn:meri:retrieval:common:0.2.0#/$defs/ResolvedSubject"
        }
      },
      "required": [
        "binding",
        "subject"
      ],
      "additionalProperties": false
    },
    "DistrictNexusContextInput": {
      "type": "object",
      "properties": {
        "clientId": {
          "type": "string",
          "maxLength": 1048576
        },
        "state": {
          "type": "string",
          "maxLength": 1048576
        },
        "district": {
          "type": "string",
          "maxLength": 1048576
        }
      },
      "required": [
        "clientId",
        "state",
        "district"
      ],
      "additionalProperties": false
    },
    "DistrictNexusChangesInput": {
      "type": "object",
      "properties": {
        "clientId": {
          "type": "string",
          "maxLength": 1048576
        },
        "state": {
          "type": "string",
          "maxLength": 1048576
        },
        "district": {
          "type": "string",
          "maxLength": 1048576
        },
        "since": {
          "type": "string",
          "maxLength": 1024
        }
      },
      "required": [
        "clientId",
        "state",
        "district"
      ],
      "additionalProperties": false
    },
    "DistrictNexusContextSelection": {
      "type": "object",
      "properties": {
        "clientId": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "state": {
          "type": "string",
          "maxLength": 2,
          "pattern": "^[A-Z]{2}$"
        },
        "district": {
          "type": "string",
          "maxLength": 2,
          "pattern": "^[0-9]{2}$"
        }
      },
      "required": [
        "clientId",
        "state",
        "district"
      ],
      "additionalProperties": false
    },
    "DistrictNexusChangesSelection": {
      "type": "object",
      "properties": {
        "clientId": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "state": {
          "type": "string",
          "maxLength": 2,
          "pattern": "^[A-Z]{2}$"
        },
        "district": {
          "type": "string",
          "maxLength": 2,
          "pattern": "^[0-9]{2}$"
        },
        "since": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64,
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "clientId",
        "state",
        "district",
        "since"
      ],
      "additionalProperties": false
    },
    "DistrictNexusFactSection": {
      "type": "string",
      "enum": [
        "footprint",
        "economic",
        "opportunities",
        "representation",
        "cpf_cds",
        "changes"
      ]
    },
    "DistrictNexusGap": {
      "type": "object",
      "properties": {
        "section": {
          "$ref": "#/$defs/DistrictNexusFactSection"
        },
        "reason": {
          "type": "string",
          "maxLength": 1048576
        },
        "source": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1048576
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "section",
        "reason",
        "source"
      ],
      "additionalProperties": false
    },
    "DistrictNexusChangeGap": {
      "type": "object",
      "properties": {
        "section": {
          "const": "changes"
        },
        "reason": {
          "type": "string",
          "maxLength": 1048576
        },
        "source": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1048576
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "section",
        "reason",
        "source"
      ],
      "additionalProperties": false
    },
    "DistrictNexusFact": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 1048576
        },
        "section": {
          "$ref": "#/$defs/DistrictNexusFactSection"
        },
        "label": {
          "type": "string",
          "maxLength": 1048576
        },
        "value": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1048576
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1048576
            },
            {
              "type": "null"
            }
          ]
        },
        "amountStage": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "requested",
                "enacted",
                "obligated",
                "awarded",
                "forecast"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "basis": {
          "type": "string",
          "enum": [
            "verified_client_nexus",
            "public_context"
          ]
        },
        "source": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "maxLength": 1048576
            },
            "label": {
              "type": "string",
              "maxLength": 1048576
            },
            "recordId": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 1048576
                },
                {
                  "type": "null"
                }
              ]
            },
            "url": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 1048576
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "label",
            "recordId",
            "url"
          ],
          "additionalProperties": false
        },
        "asOf": {
          "type": "object",
          "properties": {
            "date": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 1048576
                },
                {
                  "type": "null"
                }
              ]
            },
            "fiscalYear": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "sourceYear": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "date",
            "fiscalYear",
            "sourceYear"
          ],
          "additionalProperties": false
        },
        "geography": {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "maxLength": 2,
              "pattern": "^[A-Z]{2}$"
            },
            "district": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 2,
                  "pattern": "^[0-9]{2}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "scope": {
              "type": "string",
              "enum": [
                "district",
                "statewide",
                "national"
              ]
            },
            "basis": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 1048576
                },
                {
                  "type": "null"
                }
              ]
            },
            "boundaryCongress": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "state",
            "district",
            "scope",
            "basis",
            "boundaryCongress"
          ],
          "additionalProperties": false
        },
        "freshness": {
          "type": "object",
          "properties": {
            "lastSyncedAt": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 1048576
                },
                {
                  "type": "null"
                }
              ]
            },
            "stale": {
              "type": "boolean"
            },
            "unavailable": {
              "type": "boolean"
            }
          },
          "required": [
            "lastSyncedAt",
            "stale",
            "unavailable"
          ],
          "additionalProperties": false
        },
        "coverage": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "caveats": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1048576
          },
          "maxItems": 10000
        }
      },
      "required": [
        "id",
        "section",
        "label",
        "value",
        "unit",
        "amountStage",
        "basis",
        "source",
        "asOf",
        "geography",
        "freshness",
        "coverage",
        "caveats"
      ],
      "additionalProperties": false
    },
    "DistrictNexusChange": {
      "type": "object",
      "properties": {
        "changeKind": {
          "type": "string",
          "maxLength": 48
        },
        "source": {
          "type": "string",
          "maxLength": 32
        },
        "sourceRecordId": {
          "type": "string",
          "maxLength": 1048576
        },
        "observedAt": {
          "type": "string",
          "maxLength": 64,
          "format": "date-time"
        },
        "effectiveAt": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64,
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "severity": {
          "type": "string",
          "maxLength": 16
        }
      },
      "required": [
        "changeKind",
        "source",
        "sourceRecordId",
        "observedAt",
        "effectiveAt",
        "severity"
      ],
      "additionalProperties": false
    },
    "DistrictNexusDisabledData": {
      "type": "object",
      "properties": {
        "available": {
          "const": false
        },
        "reason": {
          "const": "feature_disabled"
        }
      },
      "required": [
        "available",
        "reason"
      ],
      "additionalProperties": false
    },
    "DistrictNexusContextData": {
      "type": "object",
      "properties": {
        "available": {
          "const": true
        },
        "clientId": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "state": {
          "type": "string",
          "maxLength": 2,
          "pattern": "^[A-Z]{2}$"
        },
        "district": {
          "type": "string",
          "maxLength": 2,
          "pattern": "^[0-9]{2}$"
        },
        "generatedAt": {
          "type": "string",
          "maxLength": 64,
          "format": "date-time"
        },
        "clientName": {
          "type": "string",
          "maxLength": 1048576
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DistrictNexusFact"
          },
          "maxItems": 40
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DistrictNexusGap"
          },
          "maxItems": 30
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "available",
        "clientId",
        "state",
        "district",
        "generatedAt",
        "clientName",
        "facts",
        "gaps",
        "truncated"
      ],
      "additionalProperties": false
    },
    "DistrictNexusChangesData": {
      "type": "object",
      "properties": {
        "available": {
          "const": true
        },
        "clientId": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "state": {
          "type": "string",
          "maxLength": 2,
          "pattern": "^[A-Z]{2}$"
        },
        "district": {
          "type": "string",
          "maxLength": 2,
          "pattern": "^[0-9]{2}$"
        },
        "generatedAt": {
          "type": "string",
          "maxLength": 64,
          "format": "date-time"
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DistrictNexusChange"
          },
          "maxItems": 20
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DistrictNexusChangeGap"
          },
          "maxItems": 30
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "available",
        "clientId",
        "state",
        "district",
        "generatedAt",
        "changes",
        "gaps",
        "truncated"
      ],
      "additionalProperties": false
    },
    "DistrictNexusContextResult": {
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "urn:meri:contracts:0.1.0#/$defs/RunBinding"
        },
        "subject": {
          "$ref": "urn:meri:retrieval:common:0.2.0#/$defs/ResolvedSubject"
        },
        "data": {
          "oneOf": [
            {
              "$ref": "#/$defs/DistrictNexusDisabledData"
            },
            {
              "$ref": "#/$defs/DistrictNexusContextData"
            }
          ]
        }
      },
      "required": [
        "binding",
        "subject",
        "data"
      ],
      "additionalProperties": false
    },
    "DistrictNexusChangesResult": {
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "urn:meri:contracts:0.1.0#/$defs/RunBinding"
        },
        "subject": {
          "$ref": "urn:meri:retrieval:common:0.2.0#/$defs/ResolvedSubject"
        },
        "data": {
          "oneOf": [
            {
              "$ref": "#/$defs/DistrictNexusDisabledData"
            },
            {
              "$ref": "#/$defs/DistrictNexusChangesData"
            }
          ]
        }
      },
      "required": [
        "binding",
        "subject",
        "data"
      ],
      "additionalProperties": false
    }
  }
}
