{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:meri:retrieval:client-knowledge-search:0.2.0",
  "$defs": {
    "ClientKnowledgeSearchContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asOf": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "asOf"
      ]
    },
    "KnowledgeGraphContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    },
    "ClientKnowledgeSearchRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": "string"
        },
        "clientId": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "query"
      ]
    },
    "ClientKnowledgeSearchInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "clientId": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "type": "number",
          "minimum": 1,
          "maximum": 20
        }
      },
      "required": [
        "query",
        "clientId",
        "kind",
        "limit"
      ]
    },
    "KnowledgeGraphRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed": {
          "type": [
            "string",
            "null"
          ]
        },
        "clientId": {
          "type": [
            "string",
            "null"
          ]
        },
        "depth": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": []
    },
    "KnowledgeGraphInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed": {
          "type": [
            "string",
            "null"
          ]
        },
        "clientId": {
          "type": [
            "string",
            "null"
          ]
        },
        "depth": {
          "type": "number",
          "minimum": 1,
          "maximum": 4
        }
      },
      "required": [
        "seed",
        "clientId",
        "depth"
      ]
    },
    "ClientKnowledgeMatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "client_profile",
            "client_person",
            "client_facility",
            "client_doc_chunk"
          ]
        },
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "snippet": {
          "type": "string"
        },
        "score": {
          "type": "number",
          "exclusiveMinimum": 0.2
        }
      },
      "required": [
        "kind",
        "id",
        "title",
        "snippet",
        "score"
      ]
    },
    "ClientKnowledgeSearchOutput": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tool": {
              "const": "search_client_knowledge"
            },
            "generatedAt": {
              "type": "string",
              "format": "date-time"
            },
            "results": {
              "type": "array",
              "maxItems": 0
            },
            "note": {
              "const": "No client is linked to this conversation. Ask the user which client, or pass clientId."
            }
          },
          "required": [
            "tool",
            "generatedAt",
            "results",
            "note"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tool": {
              "const": "search_client_knowledge"
            },
            "generatedAt": {
              "type": "string",
              "format": "date-time"
            },
            "results": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ClientKnowledgeMatch"
              },
              "maxItems": 20
            },
            "clientId": {
              "type": "string"
            },
            "clientName": {
              "type": "string"
            },
            "query": {
              "type": "string"
            },
            "note": {
              "const": "Knowledge-base search is temporarily unavailable; fall back to get_client_context."
            }
          },
          "required": [
            "tool",
            "generatedAt",
            "results",
            "clientId",
            "clientName",
            "query"
          ]
        }
      ]
    },
    "KnowledgeGraphOutput": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "error": {
              "enum": [
                "clientId must be a client UUID \u2014 pass the exact id, or omit it.",
                "This conversation is scoped to one client, so the knowledge graph cannot be walked from another client's node here. Omit the seed to explore this client's graph, or switch the session's client."
              ]
            }
          },
          "required": [
            "error"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "summary": {
              "const": "The knowledge graph is empty or has nothing connected to that seed. Run \"Populate graph\" on the Knowledge Graph page to build it from clients, memories, meetings, and email."
            },
            "nodes": {
              "type": "array",
              "maxItems": 0
            },
            "edges": {
              "type": "array",
              "maxItems": 0
            }
          },
          "required": [
            "summary",
            "nodes",
            "edges"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "summary": {
              "type": "string"
            },
            "nodes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "type",
                  "label"
                ]
              }
            },
            "connections": {
              "type": "array",
              "maxItems": 120,
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "summary",
            "nodes",
            "connections"
          ]
        }
      ]
    }
  }
}
