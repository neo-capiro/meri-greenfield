      "type": "object",
      "properties": {
        "conversationId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "conversationId"
      ],
      "additionalProperties": false
    },
    "ResearchWorkflowReviewsInput": {
      "type": "object",
      "properties": {
        "conversationId": {
          "type": "string",
          "format": "uuid"
        },
        "lane": {
          "enum": [
            "mine",
            "team",
            "deferred",
            "resolved"
          ]
        }
      },
      "required": [
        "conversationId"
      ],
      "additionalProperties": false
    },
    "ResearchWorkflowImportsInput": {
