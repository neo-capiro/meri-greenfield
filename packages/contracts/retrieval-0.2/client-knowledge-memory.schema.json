{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:meri:retrieval:client-knowledge-memory:0.2.0",
  "$defs": {
    "ClientKnowledgeMemoryContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenantId": {
          "type": "string",
          "format": "uuid"
        },
        "userId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "tenantId",
        "userId"
      ]
    },
    "ClientKnowledgeMemoryRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": [
            "string",
            "null"
          ]
        },
        "clientId": {
          "type": [
            "string",
            "null"
          ]
        },
        "k": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "memoryItemId": {
          "type": [
            "string",
            "null"
          ]
        },
        "contentCursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": []
    },
    "ClientKnowledgeMemoryInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": [
            "string",
            "null"
          ]
        },
        "clientId": {
          "type": [
            "string",
            "null"
          ]
        },
        "k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "memoryItemId": {
          "type": [
            "string",
            "null"
          ]
        },
        "contentCursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "query",
        "clientId",
        "k",
        "cursor",
        "memoryItemId",
        "contentCursor"
      ]
    },
    "MemoryContentCursor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "itemId": {
          "type": "string",
          "format": "uuid"
        },
        "scope": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "version",
        "itemId",
        "scope",
        "hash",
        "offset"
      ]
    },
    "MemoryProjectedRecord": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domain": {
          "const": "institutional_knowledge"
        },
        "recordId": {
          "type": "string",
          "format": "uuid"
        },
        "entityRef": {
          "$ref": "urn:meri:retrieval:data-search:0.2.0#/$defs/KnowledgeRef"
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "retrievalSignals": {
          "$ref": "urn:meri:retrieval:data-search:0.2.0#/$defs/RetrievalRecordSignals"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "const": "memory_items"
            },
            "recordId": {
              "type": "string",
              "format": "uuid"
            },
            "startOffset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "endOffset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "sourceType": {
              "type": "string"
            },
            "sourceId": {
              "type": [
                "string",
                "null"
              ]
            },
            "sourceRef": {
              "type": [
                "string",
                "null"
              ]
            },
            "sourceExcerpt": {
              "type": [
                "string",
                "null"
              ]
            },
            "contentHash": {
              "type": [
                "string",
                "null"
              ]
            },
            "sourceVersion": {
              "type": [
                "string",
                "null"
              ]
            },
            "metadataTruncated": {
              "type": "boolean"
            }
          },
          "required": [
            "source",
            "recordId",
            "startOffset",
            "endOffset",
            "sourceType",
            "sourceId",
            "sourceRef",
            "sourceExcerpt",
            "contentHash",
            "sourceVersion",
            "metadataTruncated"
          ]
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sourceKind": {
              "const": "governed_memory"
            },
            "memoryItemId": {
              "type": "string",
              "format": "uuid"
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            },
            "titleTruncated": {
              "type": "boolean"
            },
            "type": {
              "type": "string"
            },
            "scope": {
              "enum": [
                "firm",
                "client",
                "user_private"
              ]
            },
            "clientId": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "governance": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "memoryClass": {
                  "enum": [
                    "institutional_authoritative",
                    "client_steering",
                    "user_preference",
                    "episodic_working"
                  ]
                },
                "authority": {
                  "enum": [
                    "firm_approved",
                    "client_approved",
                    "external_authoritative",
                    "user_asserted",
                    "analyst_verified",
                    "working_draft",
                    "model_inferred",
                    "legacy_unclassified"
                  ]
                },
                "status": {
                  "enum": [
                    "active",
                    "stale",
                    "conflicted"
                  ]
                },
                "conflictStatus": {
                  "enum": [
                    null,
                    "none",
                    "open",
                    "resolved",
                    "controlling"
                  ]
                },
                "controllingItemId": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "uuid"
                },
                "approvedByUserId": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "uuid"
                },
                "approvedAt": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "asOf": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "effectiveFrom": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "validUntil": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "expiresAt": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "lastConfirmedAt": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "reviewDueAt": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "stale": {
                  "type": "boolean"
                },
                "instructionsAllowed": {
                  "type": "boolean"
                }
              },
              "required": [
                "memoryClass",
                "authority",
                "status",
                "conflictStatus",
                "controllingItemId",
                "approvedByUserId",
                "approvedAt",
                "asOf",
                "effectiveFrom",
                "validUntil",
                "expiresAt",
                "lastConfirmedAt",
                "reviewDueAt",
                "stale",
                "instructionsAllowed"
              ]
            },
            "contentStatus": {
              "enum": [
                "available",
                "metadata_only",
                "empty"
              ]
            },
            "contentLimitation": {
              "type": [
                "string",
                "null"
              ]
            },
            "content": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "hash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "totalCharacters": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "endOffset": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "truncated": {
                  "type": "boolean"
                },
                "nextRead": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "query": {
                          "const": "Read this approved memory"
                        },
                        "memoryItemId": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "clientId": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "contentCursor": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "query",
                        "memoryItemId",
                        "contentCursor"
                      ]
                    }
                  ]
                }
              },
              "required": [
                "hash",
                "totalCharacters",
                "offset",
                "endOffset",
                "truncated",
                "nextRead"
              ]
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "sourceKind",
            "memoryItemId",
            "title",
            "titleTruncated",
            "type",
            "scope",
            "clientId",
            "governance",
            "contentStatus",
            "contentLimitation",
            "content",
            "value"
          ]
        }
      },
      "required": [
        "domain",
        "recordId",
        "updatedAt",
        "retrievalSignals",
        "provenance",
        "payload"
      ]
    },
    "ClientKnowledgeMemoryOutput": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "error": {
              "enum": [
                "Provide a search query.",
                "clientId must be a client UUID \u2014 pass the exact id, or omit it."
              ]
            }
          },
          "required": [
            "error"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tool": {
              "const": "search_memory"
            },
            "coverage": {
              "$ref": "urn:meri:retrieval:data-search:0.2.0#/$defs/CoverageManifest"
            },
            "observability": {
              "$ref": "urn:meri:retrieval:data-search:0.2.0#/$defs/RetrievalObservability"
            },
            "summary": {
              "type": "string"
            },
            "requestedPageSize": {
              "type": "integer",
              "minimum": 1,
              "maximum": 15
            },
            "effectivePageSize": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "nextCursor": {
              "type": [
                "string",
                "null"
              ]
            },
            "governanceCoverage": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "searched": {
                  "const": "Eligible active governed memory, including stale or controlling conflicted records when policy allows"
                },
                "excluded": {
                  "const": "Pending proposals, rejected, withdrawn, revoked, superseded and non-controlling conflicts are not active recall. Their absence here does not establish that no such proposals or historical records exist."
                }
              },
              "required": [
                "searched",
                "excluded"
              ]
            },
            "factContentUnavailableCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "contentStatus": {
              "enum": [
                "available",
                "metadata_only",
                "empty",
                "unavailable",
                "unavailable_or_ineligible"
              ]
            },
            "contentTruncated": {
              "type": "boolean"
            },
            "results": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "memoryItemId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "title": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "type": {
                    "type": "string"
                  },
                  "clientId": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "uuid"
                  },
                  "relevance": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                },
                "required": [
                  "id",
                  "memoryItemId",
                  "title",
                  "type",
                  "clientId",
                  "relevance"
                ]
              }
            },
            "records": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "$ref": "#/$defs/MemoryProjectedRecord"
              }
            }
          },
          "required": [
            "tool",
            "coverage",
            "observability",
            "summary",
            "requestedPageSize",
            "effectivePageSize",
            "nextCursor",
            "governanceCoverage",
            "factContentUnavailableCount",
            "contentStatus",
            "contentTruncated",
            "results",
            "records"
          ]
        }
      ]
    },
    "MemoryContentAvailableLimitation": {
      "type": "null"
    },
    "MemoryMetadataOnlyLimitation": {
      "const": "This approved record contains a learning-event description, not the underlying fact. The original source must be reviewed before proposing corrected content; approval of this event is not verification of an unstored capability, person or facility."
    },
    "MemoryEmptyLimitation": {
      "const": "This approved record has no stored section body. No source fact can be inferred from its title or approval."
    }
  }
}
