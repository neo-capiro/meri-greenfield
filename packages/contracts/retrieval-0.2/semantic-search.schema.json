{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:meri:retrieval:semantic-search:0.2.0",
  "title": "Semantic (embedding) search over public bills, grants and contract opportunities",
  "$defs": {
    "SemanticSearchInput": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 3,
          "maxLength": 2000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "congress": {
          "type": "integer",
          "minimum": 93,
          "maximum": 130
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "agency": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "naics": {
          "type": "string",
          "pattern": "^[0-9]{2,6}$"
        },
        "includeInactive": {
          "type": "boolean"
        },
        "dateFrom": {
          "type": "string",
          "format": "date"
        },
        "dateTo": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    },
    "SemanticNullableText": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 8192
        },
        {
          "type": "null"
        }
      ]
    },
    "SemanticNullableDate": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "SemanticNullableDateTime": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        },
        {
          "type": "null"
        }
      ]
    },
    "SemanticNullableNumber": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "SemanticBillRecord": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "congress": {
          "type": "integer",
          "minimum": 1
        },
        "billType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "billNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "title": {
          "type": "string",
          "maxLength": 8192
        },
        "sponsorName": {
          "$ref": "#/$defs/SemanticNullableText"
        },
        "sponsorParty": {
          "$ref": "#/$defs/SemanticNullableText"
        },
        "sponsorState": {
          "$ref": "#/$defs/SemanticNullableText"
        },
        "policyArea": {
          "$ref": "#/$defs/SemanticNullableText"
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 512
          },
          "maxItems": 500
        },
        "status": {
          "$ref": "#/$defs/SemanticNullableText"
        },
        "introducedDate": {
          "$ref": "#/$defs/SemanticNullableDate"
        },
        "latestActionDate": {
          "$ref": "#/$defs/SemanticNullableDate"
        },
        "latestActionText": {
          "$ref": "#/$defs/SemanticNullableText"
        },
        "url": {
          "$ref": "#/$defs/SemanticNullableText"
        }
      },
      "required": [
        "id",
        "congress",
        "billType",
        "billNumber",
        "title",
        "sponsorName",
        "sponsorParty",
        "sponsorState",
        "policyArea",
        "subjects",
        "status",
        "introducedDate",
        "latestActionDate",
        "latestActionText",
        "url"
      ],
      "additionalProperties": false
    },
    "SemanticGrantRecord": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "maxLength": 8192
        },
        "agency": {
          "type": "string",
          "maxLength": 1024
        },
        "subAgency": {
          "$ref": "#/$defs/SemanticNullableText"
        },
        "opportunityNumber": {
          "$ref": "#/$defs/SemanticNullableText"
        },
        "category": {
          "$ref": "#/$defs/SemanticNullableText"
        },
        "fundingInstrument": {
          "$ref": "#/$defs/SemanticNullableText"
        },
        "awardCeiling": {
          "$ref": "#/$defs/SemanticNullableNumber"
        },
        "awardFloor": {
          "$ref": "#/$defs/SemanticNullableNumber"
        },
        "estimatedFunding": {
          "$ref": "#/$defs/SemanticNullableNumber"
        },
        "openDate": {
          "$ref": "#/$defs/SemanticNullableDate"
        },
        "closeDate": {
          "$ref": "#/$defs/SemanticNullableDate"
        },
        "status": {
          "$ref": "#/$defs/SemanticNullableText"
        },
        "responseDateDesc": {
          "$ref": "#/$defs/SemanticNullableText"
        },
        "openForApplications": {
          "type": "boolean"
        },
        "url": {
          "$ref": "#/$defs/SemanticNullableText"
        }
      },
      "required": [
        "id",
        "title",
        "agency",
        "subAgency",
        "opportunityNumber",
        "category",
        "fundingInstrument",
        "awardCeiling",
        "awardFloor",
        "estimatedFunding",
        "openDate",
        "closeDate",
        "status",
        "url"
      ],
      "additionalProperties": false
    },
    "SemanticContractOpportunityRecord": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "noticeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "solicitationNumber": {
          "$ref": "#/$defs/SemanticNullableText"
        },
        "title": {
          "type": "string",
          "maxLength": 8192
        },
        "noticeType": {
          "type": "string",
          "maxLength": 32
        },
        "agency": {
          "$ref": "#/$defs/SemanticNullableText"
        },
        "subAgency": {
          "$ref": "#/$defs/SemanticNullableText"
        },
        "office": {
          "$ref": "#/$defs/SemanticNullableText"
        },
        "setAside": {
          "$ref": "#/$defs/SemanticNullableText"
        },
        "naicsCode": {
          "$ref": "#/$defs/SemanticNullableText"
        },
        "pscCode": {
          "$ref": "#/$defs/SemanticNullableText"
        },
        "postedDate": {
          "$ref": "#/$defs/SemanticNullableDateTime"
        },
        "responseDeadline": {
          "$ref": "#/$defs/SemanticNullableDateTime"
        },
        "active": {
          "type": "boolean"
        },
        "currentNotice": {
          "type": "boolean"
        },
        "url": {
          "$ref": "#/$defs/SemanticNullableText"
        }
      },
      "required": [
        "id",
        "noticeId",
        "solicitationNumber",
        "title",
        "noticeType",
        "agency",
        "subAgency",
        "office",
        "setAside",
        "naicsCode",
        "pscCode",
        "postedDate",
        "responseDeadline",
        "active",
        "url"
      ],
      "additionalProperties": false
    },
    "SemanticPassage": {
      "type": "object",
      "properties": {
        "sourceTable": {
          "anyOf": [
            {
              "enum": [
                "federal_grant",
                "sam_opportunity",
                "opportunity_attachment"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceUrl": {
          "$ref": "#/$defs/SemanticNullableText"
        },
        "fileName": {
          "$ref": "#/$defs/SemanticNullableText"
        },
        "documentHash": {
          "$ref": "#/$defs/SemanticNullableText"
        },
        "chunkIndex": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "start": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "end": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "extractionMethod": {
          "$ref": "#/$defs/SemanticNullableText"
        },
        "truncated": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "embeddedAt": {
          "$ref": "#/$defs/SemanticNullableDateTime"
        }
      },
      "required": [
        "sourceTable",
        "sourceUrl",
        "fileName",
        "documentHash",
        "chunkIndex",
        "start",
        "end",
        "extractionMethod",
        "truncated",
        "embeddedAt"
      ],
      "additionalProperties": false
    },
    "SemanticDocumentCoverage": {
      "type": "object",
      "properties": {
        "attachments": {
          "type": "integer",
          "minimum": 0
        },
        "withText": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "integer",
          "minimum": 0
        },
        "indexed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "attachments",
        "withText",
        "truncated",
        "indexed"
      ],
      "additionalProperties": false
    },
    "SemanticSearchResult": {
      "type": "object",
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(congress_bill|federal_grant|sam_opportunity):.+$"
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "snippet": {
          "type": "string",
          "maxLength": 1024
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/SemanticBillRecord"
            },
            {
              "$ref": "#/$defs/SemanticGrantRecord"
            },
            {
              "$ref": "#/$defs/SemanticContractOpportunityRecord"
            }
          ]
        },
        "passage": {
          "$ref": "#/$defs/SemanticPassage"
        },
        "documents": {
          "$ref": "#/$defs/SemanticDocumentCoverage"
        }
      },
      "required": [
        "reference",
        "score",
        "snippet",
        "record"
      ],
      "additionalProperties": false
    },
    "SemanticSearchOutput": {
      "type": "object",
      "properties": {
        "tool": {
          "enum": [
            "semantic_search_bills",
            "semantic_search_grants",
            "semantic_search_contract_opportunities"
          ]
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        },
        "query": {
          "type": "string",
          "minLength": 3,
          "maxLength": 2000
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "similarityFloor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "candidateLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25
        },
        "coverage": {
          "type": "object",
          "properties": {
            "indexedRecords": {
              "type": "integer",
              "minimum": 0
            },
            "totalRecords": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "indexedRecords",
            "totalRecords"
          ],
          "additionalProperties": false
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 1,
          "maxItems": 8
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SemanticSearchResult"
          },
          "maxItems": 25
        }
      },
      "required": [
        "tool",
        "generatedAt",
        "query",
        "model",
        "similarityFloor",
        "candidateLimit",
        "total",
        "coverage",
        "notes",
        "results"
      ],
      "additionalProperties": false
    },
    "ActiveSemanticSearchInput": {
      "type": "object",
      "properties": {
        "query": {"type": "string", "minLength": 2, "maxLength": 2000},
        "limit": {"type": "integer", "minimum": 1, "maximum": 25},
        "agency": {"type": "string"},
        "dateFrom": {"type": "string", "format": "date"},
        "dateTo": {"type": "string", "format": "date"}
      },
      "required": ["query"],
      "additionalProperties": false
    },
    "SemanticActiveDocumentCoverage": {
      "type": "object",
      "properties": {
        "attachments": {"type": "integer", "const": 1},
        "withText": {"type": "integer", "const": 1},
        "indexed": {"type": "integer", "const": 1},
        "truncated": {"type": "integer", "enum": [0, 1]}
      },
      "required": ["attachments", "withText", "indexed", "truncated"],
      "additionalProperties": false
    },
    "SemanticDibbsRecord": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "providerId": {"type": "string", "minLength": 1, "maxLength": 128},
        "solicitationNumber": {"type": "string", "minLength": 1, "maxLength": 128},
        "documentType": {"enum": ["rfq", "rfp"]},
        "title": {"$ref": "#/$defs/SemanticNullableText"},
        "nsn": {"$ref": "#/$defs/SemanticNullableText"},
        "partNumber": {"$ref": "#/$defs/SemanticNullableText"},
        "quantity": {"anyOf": [{"type": "string", "maxLength": 64, "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"}, {"type": "null"}]},
        "unitOfIssue": {"$ref": "#/$defs/SemanticNullableText"},
        "setAside": {"$ref": "#/$defs/SemanticNullableText"},
        "agency": {"const": "Defense Logistics Agency"},
        "closeDate": {"$ref": "#/$defs/SemanticNullableDate"},
        "currentSolicitation": {"const": true},
        "url": {"type": "string", "minLength": 1, "maxLength": 2048},
        "observedAt": {"type": "string", "format": "date-time", "maxLength": 40}
      },
      "required": ["id", "providerId", "solicitationNumber", "documentType", "title", "nsn", "partNumber",
        "quantity", "unitOfIssue", "setAside", "agency", "closeDate", "currentSolicitation", "url", "observedAt"],
      "additionalProperties": false
    },
    "SemanticSbirTopicRecord": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "providerId": {"type": "string", "minLength": 1, "maxLength": 128},
        "topicNumber": {"$ref": "#/$defs/SemanticNullableText"},
        "solicitationNumber": {"$ref": "#/$defs/SemanticNullableText"},
        "title": {"$ref": "#/$defs/SemanticNullableText"},
        "agency": {"$ref": "#/$defs/SemanticNullableText"},
        "year": {"anyOf": [{"type": "integer", "minimum": 1900, "maximum": 2200}, {"type": "null"}]},
        "activity": {"type": "string", "minLength": 1, "maxLength": 64},
        "solicitationStatus": {"$ref": "#/$defs/SemanticNullableText"},
        "closeDate": {"$ref": "#/$defs/SemanticNullableDate"},
        "currentTopic": {"const": true},
        "url": {"$ref": "#/$defs/SemanticNullableText"},
        "observedAt": {"type": "string", "format": "date-time", "maxLength": 40}
      },
      "required": ["id", "providerId", "topicNumber", "solicitationNumber", "title", "agency", "year", "activity",
        "solicitationStatus", "closeDate", "currentTopic", "url", "observedAt"],
      "additionalProperties": false
    },
    "SemanticActivePassage": {
      "type": "object",
      "properties": {
        "sourceTable": {
          "enum": [
            "opportunity_attachment",
            "tango_sbir_topic"
          ]
        },
        "sourceUrl": {
          "$ref": "#/$defs/SemanticNullableText"
        },
        "fileName": {
          "$ref": "#/$defs/SemanticNullableText"
        },
        "documentHash": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "chunkIndex": {
          "type": "integer",
          "minimum": 0
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "extractionMethod": {
          "$ref": "#/$defs/SemanticNullableText"
        },
        "truncated": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "embeddedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        },
        "binding": {
          "enum": [
            "archived_content_sha256",
            "provider_topic_id"
          ]
        },
        "canonicalRecordId": {
          "$ref": "#/$defs/SemanticNullableText"
        },
        "providerRecordId": {
          "$ref": "#/$defs/SemanticNullableText"
        },
        "attachmentContentSha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "offsetBasis": {
          "const": "plain_text_normalized_utf16"
        },
        "archivedAt": {
          "$ref": "#/$defs/SemanticNullableDateTime"
        },
        "textFetchedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        }
      },
      "required": ["sourceTable", "sourceUrl", "fileName", "documentHash", "chunkIndex", "start", "end",
        "extractionMethod", "truncated", "embeddedAt", "binding", "canonicalRecordId", "providerRecordId",
        "attachmentContentSha256", "offsetBasis", "archivedAt", "textFetchedAt"],
      "additionalProperties": false
    },
    "SemanticDibbsResult": {
      "type": "object",
      "properties": {
        "reference": {
          "type": "string",
          "maxLength": 160,
          "pattern": "^tango_dibbs_solicitation:.+$"
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "snippet": {
          "type": "string",
          "maxLength": 1024
        },
        "record": {
          "$ref": "#/$defs/SemanticDibbsRecord"
        },
        "passage": {
          "$ref": "#/$defs/SemanticActivePassage"
        },
        "documents": {
          "$ref": "#/$defs/SemanticActiveDocumentCoverage"
        }
      },
      "required": [
        "reference",
        "score",
        "snippet",
        "record",
        "passage",
        "documents"
      ],
      "additionalProperties": false
    },
    "SemanticSbirTopicResult": {
      "type": "object",
      "properties": {
        "reference": {
          "type": "string",
          "maxLength": 160,
          "pattern": "^tango_sbir_topic:.+$"
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "snippet": {
          "type": "string",
          "maxLength": 1024
        },
        "record": {
          "$ref": "#/$defs/SemanticSbirTopicRecord"
        },
        "passage": {
          "$ref": "#/$defs/SemanticActivePassage"
        }
      },
      "required": [
        "reference",
        "score",
        "snippet",
        "record",
        "passage"
      ],
      "additionalProperties": false
    },
    "SemanticDibbsOutput": {
      "type": "object",
      "properties": {
        "tool": {
          "const": "semantic_search_dibbs_solicitations"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        },
        "query": {
          "type": "string",
          "minLength": 3,
          "maxLength": 2000
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "similarityFloor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "candidateLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25
        },
        "coverage": {
          "type": "object",
          "properties": {
            "indexedRecords": {
              "type": "integer",
              "minimum": 0
            },
            "totalRecords": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "indexedRecords",
            "totalRecords"
          ],
          "additionalProperties": false
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 1,
          "maxItems": 8
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SemanticDibbsResult"
          },
          "maxItems": 25
        }
      },
      "required": [
        "tool",
        "generatedAt",
        "query",
        "model",
        "similarityFloor",
        "candidateLimit",
        "total",
        "coverage",
        "notes",
        "results"
      ],
      "additionalProperties": false
    },
    "SemanticSbirTopicOutput": {
      "type": "object",
      "properties": {
        "tool": {
          "const": "semantic_search_sbir_topics"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        },
        "query": {
          "type": "string",
          "minLength": 3,
          "maxLength": 2000
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "similarityFloor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "candidateLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25
        },
        "coverage": {
          "type": "object",
          "properties": {
            "indexedRecords": {
              "type": "integer",
              "minimum": 0
            },
            "totalRecords": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "indexedRecords",
            "totalRecords"
          ],
          "additionalProperties": false
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 1,
          "maxItems": 8
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SemanticSbirTopicResult"
          },
          "maxItems": 25
        }
      },
      "required": [
        "tool",
        "generatedAt",
        "query",
        "model",
        "similarityFloor",
        "candidateLimit",
        "total",
        "coverage",
        "notes",
        "results"
      ],
      "additionalProperties": false
    }
  }
}
