  "$defs": {
    "ResearchPortfolioJsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "maxLength": 1048576
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResearchPortfolioJsonValue"
          },
          "maxItems": 10000
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ResearchPortfolioJsonValue"
          },
          "maxProperties": 10000
        }
      ]
    },
    "ResearchPortfolioJsonObject": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ResearchPortfolioJsonValue"
      },
      "maxProperties": 10000
    },
    "ResearchPortfolioDetailInput": {
      "type": "object",
      "properties": {
        "conversationId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "ResearchPortfolioChangesInput": {
      "type": "object",
      "properties": {
        "conversationId": {
          "type": "string",
          "format": "uuid"
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "ResearchPortfolioDetailSelection": {
      "type": "object",
      "properties": {
        "conversationId": {
          "type": "string",
          "format": "uuid"
        },
        "portfolioId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "conversationId",
        "portfolioId"
      ],
      "additionalProperties": false
    },
    "ResearchPortfolioChangesSelection": {
      "type": "object",
      "properties": {
        "conversationId": {
          "type": "string",
          "format": "uuid"
        },
        "portfolioId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
