{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:meri:retrieval:stored-intelligence:0.2.0",
  "$defs": {
    "StoredIntelligenceSearchInput": {
      "type": "object",
      "properties": {
        "query": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 20
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "StoredIntelligenceArticle": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "maxLength": 240
        },
        "url": {
          "type": "string"
        },
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-"
        },
        "summary": {
          "type": "string",
          "maxLength": 400
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "source",
        "title",
        "url",
        "author",
        "publishedAt",
        "summary",
        "categories",
        "topics"
      ],
      "additionalProperties": false
    },
    "StoredIntelligenceSearchOutput": {
      "type": "object",
      "properties": {
        "tool": {
          "const": "search_intel_articles"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-"
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StoredIntelligenceArticle"
          },
          "maxItems": 50
        }
      },
      "required": [
        "tool",
        "generatedAt",
        "total",
        "data"
      ],
      "additionalProperties": false
    }
  }
}
