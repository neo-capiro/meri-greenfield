  "datasets": [
    {
      "metadata": {
        "key": "lda_registrations",
        "description": "Senate LDA lobbying registrations: one row per (registrant, client) relationship, derived from the latest filing on record for that pair as of `asOfDate` (default: now). `status` is derived from the official LDA filing-type code of that latest filing, not a raw code. `is_in_house` flags a registrant that appears to be registering itself as its own client (name match) rather than an outside firm. Does not cover relationships whose LAST filing predates the ingestion window (2021-present) — a true-inactive-since-before-2021 relationship simply will not appear.",
        "supportsAsOf": true,
        "fields": [
          {
            "name": "registrant_id",
            "type": "number",
            "description": "LDA registrant id (a lobbying firm or in-house registrant).",
            "filterable": true,
            "groupable": true,
            "aggregatable": true
          },
          {
            "name": "registrant_name",
            "type": "string",
            "description": "Registrant (firm) name as filed.",
            "filterable": true,
            "groupable": true,
            "aggregatable": false
          },
          {
            "name": "client_id",
            "type": "number",
            "description": "LDA client id. NOTE: this id is scoped to the registration, not a stable per-company identifier — the same real company represented by two firms gets two different client_ids. Prefer client_name for entity-level questions, and expect it to be an overcount of distinct real organizations.",
            "filterable": true,
            "groupable": true,
            "aggregatable": true
          },
          {
            "name": "client_name",
            "type": "string",
            "description": "Client name as filed on this registration.",
            "filterable": true,
            "groupable": true,
            "aggregatable": false
          },
          {
            "name": "client_state",
            "type": "string",
            "description": "Client's registered state.",
            "filterable": true,
            "groupable": true,
            "aggregatable": false
          },
          {
            "name": "filing_year",
            "type": "number",
            "description": "Year of the latest filing considered (bounded by asOfDate).",
            "filterable": true,
            "groupable": true,
            "aggregatable": true
          },
          {
            "name": "dt_posted",
            "type": "timestamp",
            "description": "When the latest considered filing was posted.",
            "filterable": true,
            "groupable": true,
            "aggregatable": false
          },
          {
            "name": "status",
            "type": "string",
            "description": "Derived from the latest filing's official LDA filing-type code (see LDA_TERMINATION_TYPES in source) — 'active' or 'terminated'. This is the field to filter on for \"how many active registrations.\"",
            "filterable": true,
            "groupable": true,
            "aggregatable": false
          },
          {
            "name": "is_in_house",
            "type": "boolean",
            "description": "True when the registrant appears to be registering itself as its own client (in-house lobbying) rather than representing an outside client. Name-match heuristic — undercounts when the two name strings differ even slightly.",
            "filterable": true,
            "groupable": true,
            "aggregatable": false
          }
        ]
      },
      "defaultLimit": 200,
      "maxLimit": 2000
    },
