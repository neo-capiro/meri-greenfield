{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:meri:commands:task-update:0.2.0",
  "$defs": {
    "TaskUpdateRaw": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "dueDate": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "taskId"
      ],
      "additionalProperties": false
    },
    "TaskUpdateArguments": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "format": "uuid"
        },
        "mode": {
          "const": "unconditional_patch"
        },
        "patch": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "status": {
              "enum": [
                "todo",
                "in_progress",
                "done",
                "blocked",
                "canceled"
              ]
            },
            "dueDate": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            }
          },
          "required": [],
          "additionalProperties": false,
          "minProperties": 1
        }
      },
      "required": [
        "taskId",
        "mode",
        "patch"
      ],
      "additionalProperties": false
    },
    "TaskUpdateContext": {
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "urn:meri:contracts:0.1.0#/$defs/RunBinding"
        }
      },
      "required": [
        "binding"
      ],
      "additionalProperties": false
    },
    "TaskUpdateCommand": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "0.2.0"
        },
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "binding": {
          "$ref": "urn:meri:contracts:0.1.0#/$defs/RunBinding"
        },
        "action": {
          "const": "task.update"
        },
        "arguments": {
          "$ref": "#/$defs/TaskUpdateArguments"
        },
        "attachments": {
          "type": "array",
          "maxItems": 0
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "urn:meri:contracts:0.1.0#/$defs/Scope"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "contractVersion",
        "commandId",
        "binding",
        "action",
        "arguments",
        "attachments",
        "scopes",
        "idempotencyKey"
      ],
      "additionalProperties": false
    },
    "TaskUpdateApprovalProposal": {
      "type": "object",
      "properties": {
        "proposalId": {
          "type": "string",
          "format": "uuid"
        },
        "command": {
          "$ref": "#/$defs/TaskUpdateCommand"
        },
        "commandSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "requiredApprover": {
          "$ref": "urn:meri:contracts:0.1.0#/$defs/Identity"
        }
      },
      "required": [
        "proposalId",
        "command",
        "commandSha256",
        "createdAt",
        "expiresAt",
        "requiredApprover"
      ],
      "additionalProperties": false
    },
    "TaskUpdateResult": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "enum": [
            "todo",
            "in_progress",
            "done",
            "blocked",
            "canceled"
          ]
        },
        "dueDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "clientId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "id",
        "title",
        "status",
        "dueDate",
        "clientId",
        "updatedAt"
      ],
      "additionalProperties": false
    }
  }
}
