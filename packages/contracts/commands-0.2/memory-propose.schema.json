{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:meri:commands:memory-propose:0.2.0",
  "title": "Private pending-only memory proposal intent; no committed-memory assertion",
  "$defs": {
    "MemoryProposeRaw": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string",
          "maxLength": 16384
        },
        "key": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 16384
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 16384
            },
            {
              "type": "null"
            }
          ]
        },
        "clientId": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 16384
            },
            {
              "type": "null"
            }
          ]
        },
        "ttlDays": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "content"
      ],
      "additionalProperties": false
    },
    "MemoryProposeContext": {
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "urn:meri:contracts:0.1.0#/$defs/RunBinding"
        },
        "conversationClientId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "binding",
        "conversationClientId"
      ],
      "additionalProperties": false
    },
    "MemoryProposeArguments": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "key": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "enum": [
            "personal",
            "client",
            "firm"
          ]
        },
        "clientId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "ttlDays": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 365
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "content",
        "key",
        "scope",
        "clientId",
        "ttlDays"
      ],
      "additionalProperties": false
    },
    "MemoryProposeResult": {
      "type": "object",
      "properties": {
        "candidateId": {
          "type": "string",
          "format": "uuid"
        },
        "commandSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "const": "pending"
        }
      },
      "required": [
        "candidateId",
        "commandSha256",
        "status"
      ],
      "additionalProperties": false
    }
  }
}
