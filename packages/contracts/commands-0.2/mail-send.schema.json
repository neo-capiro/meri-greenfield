{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:meri:commands:mail-send:0.2.0",
  "$defs": {
    "MailSendContext": {
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "urn:meri:contracts:0.1.0#/$defs/RunBinding"
        }
      },
      "required": [
        "binding"
      ],
      "additionalProperties": false
    },
    "MailSendCommand": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "0.2.0"
        },
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "binding": {
          "$ref": "urn:meri:contracts:0.1.0#/$defs/RunBinding"
        },
        "action": {
          "const": "mail.send"
        },
        "arguments": {
          "$ref": "#/$defs/MailSendArguments"
        },
        "attachments": {
          "type": "array",
          "maxItems": 0
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "urn:meri:contracts:0.1.0#/$defs/Scope"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "contractVersion",
        "commandId",
        "binding",
        "action",
        "arguments",
        "attachments",
        "scopes",
        "idempotencyKey"
      ],
      "additionalProperties": false
    },
    "MailSendApprovalProposal": {
      "type": "object",
      "properties": {
        "proposalId": {
          "type": "string",
          "format": "uuid"
        },
        "command": {
          "$ref": "#/$defs/MailSendCommand"
        },
        "commandSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "requiredApprover": {
          "$ref": "urn:meri:contracts:0.1.0#/$defs/Identity"
        }
      },
      "required": [
        "proposalId",
        "command",
        "commandSha256",
        "createdAt",
        "expiresAt",
        "requiredApprover"
      ],
      "additionalProperties": false
    },
    "MailSendArguments": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "send",
            "reply",
            "reply_all",
            "forward"
          ]
        },
        "clientId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "senderConnectionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "senderEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 254
        },
        "to": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 254
          }
        },
        "cc": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 254
          }
        },
        "bcc": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 254
          }
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "bodyHtml": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50000
        },
        "files": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "properties": {
              "attachmentId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "fileName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "contentType": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3145728
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "attachmentId",
              "fileName",
              "contentType",
              "bytes",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "original": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "threadId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "messageId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "updatedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "bodySha256": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "threadId",
                "messageId",
                "updatedAt",
                "bodySha256"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "mode",
        "clientId",
        "senderConnectionId",
        "senderEmail",
        "to",
        "cc",
        "bcc",
        "subject",
        "bodyHtml",
        "files",
        "original"
      ],
      "additionalProperties": false
    },
    "MailSendResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "failed"
            },
            "intentId": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "requestKey": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "retryable": {
              "const": false
            }
          },
          "required": [
            "state",
            "intentId",
            "requestKey",
            "retryable"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "accepted"
            },
            "intentId": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "requestKey": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "retryable": {
              "const": false
            },
            "threadId": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "messageId": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "provider": {
              "enum": [
                "gmail",
                "microsoft_graph"
              ]
            },
            "senderConnectionId": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "senderEmail": {
              "type": "string",
              "minLength": 3,
              "maxLength": 254
            },
            "mode": {
              "enum": [
                "send",
                "reply",
                "reply_all",
                "forward"
              ]
            },
            "original": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "threadId": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                    },
                    "messageId": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                    },
                    "updatedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "bodySha256": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "threadId",
                    "messageId",
                    "updatedAt",
                    "bodySha256"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "signaturePolicy": {
              "const": "actor"
            },
            "signatureAppended": {
              "type": "boolean"
            },
            "mailboxConfirmation": {
              "enum": [
                null,
                "pending",
                "confirmed"
              ]
            }
          },
          "required": [
            "state",
            "intentId",
            "requestKey",
            "retryable",
            "threadId",
            "messageId",
            "provider",
            "senderConnectionId",
            "senderEmail",
            "mode",
            "original",
            "signaturePolicy",
            "signatureAppended",
            "mailboxConfirmation"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
