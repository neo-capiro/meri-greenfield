  "completion": {
    "requireAllSources": true,
    "allowDisclosedPartial": true,
    "negativeClaims": "complete-covered-only",
    "rubric": [
      {
        "id": "meeting-context",
        "requirement": "Recent exchanges, prior meetings, decisions, open issues, deadlines/developments and promises are covered.",
        "evidenceRequired": true
      },
      {
        "id": "one-page-checklist",
        "requirement": "End with a one-page pre-meeting checklist and visible evidence/coverage limitations.",
        "evidenceRequired": true
      },
      {
        "id": "decisive-evidence",
        "requirement": "Read exact material records/passages and retain source/version/hash/scope/time binding; separate free-form inference from source excerpts.",
        "evidenceRequired": true
      },
      {
        "id": "coverage",
        "requirement": "Expose per-required-source freshness, pagination, decisive-read and history limits; absence requires complete relevant current coverage.",
        "evidenceRequired": true
      }
    ]
