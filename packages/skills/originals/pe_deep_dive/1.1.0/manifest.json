    "rubric": [
      {
        "id": "pe-and-fydp",
        "requirement": "Confirm canonical PE; retain FYDP fiscal-year/stage/revision/unit and missing years.",
        "evidenceRequired": true
      },
      {
        "id": "congress-and-contractors",
        "requirement": "Read report language, contractors and authorizing/appropriating bill versions without conflating lanes.",
        "evidenceRequired": true
      },
      {
        "id": "decisive-evidence",
        "requirement": "Read exact material records/passages and retain source/version/hash/scope/time binding; separate free-form inference from source excerpts.",
        "evidenceRequired": true
      },
      {
        "id": "coverage",
        "requirement": "Expose per-required-source freshness, pagination, decisive-read and history limits; absence requires complete relevant current coverage.",
        "evidenceRequired": true
      },
      {
        "id": "structured-grain",
        "requirement": "Keep PE/project grains, position cycle, asserted FY, value kind, exact numeric strings and separate row/byte/SQL limits; query evidence is not immutable source text.",
