  "completion": {
    "requireAllSources": true,
    "allowDisclosedPartial": true,
    "negativeClaims": "complete-covered-only",
    "rubric": [
      {
        "id": "client-footprint",
        "requirement": "Retain the selected client interest and evidenced state footprint; inferred or missing geography remains uncertain and each profile section keeps coverage.",
        "evidenceRequired": true
      },
      {
        "id": "federal-and-state-status",
        "requirement": "Separate federal and each relevant state bill identity/session, recorded status/date, action evidence, client relevance and next check; disclose unchecked states and bounded searches.",
        "evidenceRequired": true
      },
      {
        "id": "canonical-state-reads",
        "requirement": "Read state status only using retained canonical keys; no designation fallback, fabricated state key or claim that metadata supplies immutable state bill text.",
        "evidenceRequired": true
      },
      {
        "id": "decisive-evidence",
        "requirement": "Bind federal legal wording to exact bill-text version/passages and separate sourced facts, conflicts, inference and proposed impact; state wording remains unverified without a qualified text read.",
        "evidenceRequired": true
      },
      {
        "id": "coverage",
        "requirement": "Show profile/tracking/federal/state freshness, pagination, budget and decisive-read limits; no complete-universe or no-bills claim from partial coverage.",
        "evidenceRequired": true
      }
    ]
  },
  "approval": {
