    "rubric": [
      {
        "id": "promise-and-owner",
        "requirement": "Preserve promise versus suggestion, original source, unknown/conflicting internal owner and date.",
        "evidenceRequired": true
      },
      {
        "id": "tracking-and-delivery",
        "requirement": "Deduplicate exact origins, flag untracked email/meeting promises; native completion is not delivery/acceptance.",
        "evidenceRequired": true
      },
      {
        "id": "monday-and-coverage",
        "requirement": "Only mapped/authorized supplied boards; disclose Monday checked, disconnected, unavailable or not mapped and all source gaps.",
        "evidenceRequired": true
      },
      {
        "id": "decisive-evidence",
        "requirement": "Read exact material records/passages and retain source/version/hash/scope/time binding; separate free-form inference from source excerpts.",
        "evidenceRequired": true
      },
      {
        "id": "coverage",
        "requirement": "Expose per-required-source freshness, pagination, decisive-read and history limits; absence requires complete relevant current coverage.",
        "evidenceRequired": true
      }
    ]
  },
