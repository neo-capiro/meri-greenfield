+ const control=gzipSync(tar([['.PKGINFO',Buffer.from(`pkgname = ${name}\npkgver = ${version}\ndatahash = ${datahash??sha256(data)}\n`)]]));
+ return {bytes:Buffer.concat([control,data]),control,data};
+}
