# Sourced by every script in this kit. Git Bash on Windows; aws.exe, node and python on PATH.
# Paths handed to aws/node/python are always relative (each script cd's first): MSYS_NO_PATHCONV
# keeps /meri/... style names intact but then /c/dev/... paths would not reach Windows binaries.
export MSYS_NO_PATHCONV=1 AWS_PROFILE=capiro-dev AWS_REGION=us-east-1 AWS_DEFAULT_REGION=us-east-1

KIT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STATE="$KIT_DIR/${KIT_STATE:-state}"   # KIT_STATE (a sibling folder name) only for dry runs
mkdir -p "$STATE"

ACCOUNT=967807252336
SOURCE_SHA=51e265bd5b5170abffb32a62ffc39a52a788fe60
SOURCE_BRANCH=codex/agent4-core-runtime-closure-20261021   # pre-merge qualification build of PR #107 (O139)
ARCHIVE_NAME="core-$SOURCE_SHA-lf.zip"
ARCHIVE_SHA256=8c1bc0608edc2f46b0027b71e11e4e2c586db7caf77f99c6a582ad1c2113800c
BUCKET=capiro-portfolio-preview-source-967807252336-us-east-1
KEY="inputs/$ARCHIVE_NAME"
PROJECT=capiro-preview-first-chat-core-alpine-amd64-build
REPOSITORY=capiro/preview-core
REGISTRY=967807252336.dkr.ecr.us-east-1.amazonaws.com
CLUSTER=capiro-dev
SERVICE=capiro-preview-first-chat-core
TG_ARN=arn:aws:elasticloadbalancing:us-east-1:967807252336:targetgroup/Capiro-CoreT-NHA4DBPHLZ2E/11512f9487ee2f54
CORE_LOG_GROUP=/capiro/preview-first-chat/core

# Serving today and the rollback target.
ROLLBACK_TD=arn:aws:ecs:us-east-1:967807252336:task-definition/capiro-preview-first-chat-core:3
ROLLBACK_DIGEST=sha256:1ae9b1670ba53bd7bcc10121400d4fe2e8b670e37674d3c2691caf78266fe807
ROLLBACK_SHA=0f5d7e15ecc8b4b748b33ab0877937e7a6d63804

# aws text output from aws.exe carries CRLF; strip it before comparing.
awst() { aws "$@" --output text | tr -d '\r'; }
# Read one value an earlier step recorded under state/.
need() { [ -s "$STATE/$1" ] || { echo "STOP: missing state/$1 (run the earlier step first)" >&2; exit 1; }; tr -d '\r\n' < "$STATE/$1"; }
stop() { echo "STOP: $*" >&2; exit 1; }
CLONE_DB_HOST=capiro-newstack-preview-clone.cluster-csryw28ai752.us-east-1.rds.amazonaws.com
