# Sourced by every script in this proxy kit (Git Bash; aws, python3 3.14, git on PATH).
export MSYS_NO_PATHCONV=1 AWS_PAGER='' AWS_PROFILE=capiro-dev AWS_REGION=us-east-1 AWS_DEFAULT_REGION=us-east-1
KIT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
command -v cygpath >/dev/null && KIT_DIR="$(cygpath -m "$KIT_DIR")"
STATE="$KIT_DIR/state"

COMMIT=205eead4c18882e4fc0e6c016c10dc4e5dd8c45c
ZIP_SHA256=28bd4d2bed7aad6e77f1e6113e6e5f475ec755f5dbed995efdd555d34004ae83
REPO=C:/dev/fable/meri-greenfield
ARTIFACTS=C:/dev/fable/proxy-artifacts-b7fc
ACCOUNT=967807252336
BUCKET=meri-greenfield-qual-build-967807252336-us-east-1
PROJECT=meri-greenfield-qualification-build
REPOSITORY_NAME=meri-greenfield/qualification-worker
REPOSITORY_URI=967807252336.dkr.ecr.us-east-1.amazonaws.com/meri-greenfield/qualification-worker
# Pinned bases every proxy receipt must name (unchanged since 34851020).
NODE_BASE='node:24.21.0-trixie-slim@sha256:173f125896c3b47ddf056734c7ea789d04595a6a08769a8f78e0df642781fb66'
RUNTIME_BASE='cgr.dev/chainguard/wolfi-base@sha256:030e45cb37187dff322bbefe9658bcaec31b824a5d523380771a64864c9f45d4'
# Serving proxy (release E and the C baseline): the rollback image.
LIVE_PROXY="$REPOSITORY_URI@sha256:734a20ec036a9aacb1f99cd8f8d2a0d5a3319a44a27e13e14781e396ebec3551"
LIVE_PROXY_COMMIT=34851020aa0d73fead4db59ba6e26a098e2d0313
LIVE_PROXY_SCAN_SHA256=04d24b4b22b39e0cd7690fce755b6069062a799f83d179852a73a904401b9f53
PROXY_SERVICE=meri-product-preview-proxy
CLUSTER=capiro-dev

awst() { aws "$@" --output text | tr -d '\r'; }
stop() { echo "STOP: $*" >&2; exit 1; }
need() { [ -s "$STATE/$1" ] || stop "missing state/$1 (run the earlier step first)"; tr -d '\r\n' < "$STATE/$1"; }
