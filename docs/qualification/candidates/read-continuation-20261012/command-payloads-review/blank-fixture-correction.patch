 test('command independent: task public action version and scope are checked',()=>{for(const edit of [c=>c.action='task.update',c=>c.contractVersion='0.2.0',c=>c.scopes[0].tenantId='other',c=>c.arguments.approved=true]){const c=task();edit(c);assert.throws(()=>t.assertTaskCreateCommand(c,tc()));}});
