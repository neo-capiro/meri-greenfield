 test('command independent: task direct command enforces normalized date title and zero attachments',()=>{for(const args of [{title:' A ',clientId:null,dueDate:null},{title:'x'.repeat(241),clientId:null,dueDate:null},{title:'A',clientId:null,dueDate:'2026-10-12T12:00:00.000Z'}])assert.throws(()=>t.assertTaskCreateCommand(task(args),tc()));const c=task();c.attachments=[object()];assert.throws(()=>t.assertTaskCreateCommand(c,tc()));});
