 test('command independent: client context is closed and does not default binding',()=>{for(const x of [{},null,{binding:binding()},{...tc(),approved:true},{...tc(),clientResolution:{reference:'A',clientId:uuid(5),allowed:true}}])assert.throws(()=>t.normalizeTaskCreateInput({title:'A'},x));});
