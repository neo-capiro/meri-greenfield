{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:meri:retrieval:tracked-bills:0.2.0",
  "$comment": "Pure private typed source projection. Context/reference and binding/subject wrapper are new Meri assertions, not legacy fields or proof of current access. No connected resolver, query, grant or completeness attestation. No operation list cap; canonical bounded JSON admission may refuse the entire result.",
  "$defs": {
    "TrackedBillsContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "binding": {
          "$ref": "urn:meri:contracts:0.1.0#/$defs/RunBinding"
        },
        "subject": {
          "$ref": "urn:meri:retrieval:common:0.2.0#/$defs/ResolvedSubject"
        },
        "clientReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "required": [
        "binding",
        "subject",
        "clientReference"
      ]
    },
    "TrackedBillsRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clientId": {
          "type": "string",
          "maxLength": 16384
        }
      },
      "required": [
        "clientId"
      ]
    },
    "TrackedBillsInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clientId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "clientId"
      ]
    },
    "TrackedBillsBill": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identifier": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "latestActionDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "latestActionText": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "actionTexts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sponsorName": {
          "type": [
            "string",
            "null"
          ]
        },
        "sponsorParty": {
          "type": [
            "string",
            "null"
          ]
        },
        "subjectNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "identifier",
        "title",
        "latestActionDate",
        "latestActionText",
        "status",
        "actionTexts",
        "sponsorName",
        "sponsorParty",
        "subjectNames"
      ]
    },
    "TrackedBillsRow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "billId": {
          "type": "string"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "bill": {
          "anyOf": [
            {
              "$ref": "#/$defs/TrackedBillsBill"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "billId",
        "note",
        "createdAt",
        "bill"
      ]
    },
    "TrackedBillsData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {
          "const": "search_tracked_bills"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "clientId": {
          "type": "string",
          "format": "uuid"
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "bills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TrackedBillsRow"
          }
        }
      },
      "required": [
        "tool",
        "generatedAt",
        "clientId",
        "total",
        "bills"
      ]
    },
    "TrackedBillsResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "binding": {
          "$ref": "urn:meri:contracts:0.1.0#/$defs/RunBinding"
        },
        "subject": {
          "$ref": "urn:meri:retrieval:common:0.2.0#/$defs/ResolvedSubject"
        },
        "data": {
          "$ref": "#/$defs/TrackedBillsData"
        }
      },
      "required": [
        "binding",
        "subject",
        "data"
      ]
    }
  }
}
