+++ b/packages/contracts/test/retrieval-bill-text.test.mjs
@@ -0,0 +1,47 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import Ajv from 'ajv/dist/2020.js';
+import addFormats from 'ajv-formats';
+import {createBillTextValidators,BILL_TEXT_OPERATION_IDS} from '../retrieval-0.2/bill-text-validation.mjs';
+import {decodeBillTextCursor} from '../retrieval-0.2/bill-text-cursor.mjs';
+import {createOperationContracts} from '../retrieval-0.2/operation-contracts.mjs';
+import {canonicalSha256} from '../validate.mjs';
+const schema=JSON.parse(readFileSync(new URL('../retrieval-0.2/bill-text.schema.json',import.meta.url)));
+const ajv=new Ajv({strict:true,allErrors:true});addFormats(ajv);ajv.addSchema(schema);
+const checks=new Map(Object.keys(schema.$defs).map(name=>[name,ajv.compile({$ref:`${schema.$id}#/$defs/${name}`})]));
+const v=createBillTextValidators({schema,validateShape(name,value){const check=checks.get(name);if(!check?.(value))throw new Error(`${name}: ${ajv.errorsText(check?.errors)}`);return value;}});
+const [SEARCH,READ]=BILL_TEXT_OPERATION_IDS,context={defaultCongress:119},billId='119-hr-1',revisionId='aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa',textHash='a'.repeat(64),stamp='2026-10-12T12:00:00.000Z';
+const encode=(offset,change={})=>Buffer.from(JSON.stringify([change.billId??billId,change.versionCode??'ih',change.revisionId??revisionId,change.textHash??textHash,offset])).toString('base64url');
+function rawBill(){return{id:billId,congress:119,billType:'hr',billNumber:'1',title:'Synthetic bill',introducedDate:null,sponsorName:null,sponsorState:null,sponsorParty:null,sponsorBioguideId:null,latestActionText:null,latestActionDate:null,policyArea:null,subjects:[],peCodes:[],committees:{opaque:true},cosponsorsCount:0,originChamber:null,updateDate:null,updateDateIncludingText:null,status:null,statusAt:null,url:null,lastSyncedAt:stamp};}
+function metadata(){return{tool:SEARCH,generatedAt:stamp,data:[rawBill()],total:1,page:1,limit:20};}
+function sequential(total=12,offset=0){const end=Math.min(total,offset+9000),more=end<total;return{tool:READ,authoritativeOwner:'federal_evidence_current',currentStatus:'available',found:true,billId,versionCode:'ih',revisionId,packageId:'synthetic-package',provider:'synthetic-provider',lineageKey:'synthetic-lineage',versionHash:'b'.repeat(64),textHash,sourceLocator:'https://example.invalid/text',sourceModifiedAt:null,publishedAt:null,fetchedAt:stamp,text:'x'.repeat(end-offset),trust:'external_untrusted',coverage:{locator:{offset,endOffset:end},totalCharacters:total,pageComplete:true,contentComplete:!more&&offset===0,paginationComplete:!more,complete:true,truncated:more||offset>0,nextCursor:more?encode(end):null},note:'This is exact bill-version text from the current federal evidence owner. It is not amendment text or bill status.'};}
+function unavailable(version=null){return{tool:READ,authoritativeOwner:'federal_evidence_current',currentStatus:'unavailable',billId,requestedVersionCode:version,found:false,coverage:{complete:true,truncated:false,nextCursor:null},note:version?`No current complete bill-text revision ${version} is available for ${billId}.`:`No current complete bill-text revision is available for ${billId}.`};}
+function located(total=1000,start=0){const p=sequential(total);p.query='minerals';p.queryParts=['minerals'];p.totalHits=1;p.passages=[{heading:null,startOffset:start,endOffset:start+Math.min(total,1000),matchedTerms:['minerals'],readCursor:start?encode(start):null}];p.text=`[Text | characters ${start}-${p.passages[0].endOffset}]\n`+'x'.repeat(Math.min(total,1000));p.coverage={locator:{query:'minerals'},totalCharacters:total,pageComplete:true,contentComplete:false,paginationComplete:false,complete:false,truncated:true,nextCursor:null};p.note='Excerpts of the exact bill-version text that match the query, best first by section order. Read on from a passage with read_bill_text and its readCursor before relying on surrounding context.';return p;}
+function textPage(){return{tool:SEARCH,generatedAt:stamp,mode:'bill_text',textQuery:'minerals',results:[{billId,title:null,versionCode:'ih',passages:[{snippet:'synthetic «minerals»',startOffset:0,readCursor:null}]}],total:1,totalBills:1,page:1,perPage:8,hasMore:false,note:'Bills whose stored text matches, best first, with matching passages (« » marks the match). Read a passage in context with read_bill_text and its readCursor. Stored text covers 119th-Congress bills. 1 bill match in all.'};}
+const check=(op,p,request={})=>v.assertBillTextOutput(op,p,request,context);
+
+test('distinct operations/schema and hostile operation references',()=>{assert.equal(v.billTextSchemaId,'urn:meri:retrieval:bill-text:0.2.0');assert.equal(v.billTextInputDefinition(SEARCH),'CongressBillSearchInput');assert.equal(v.billTextOutputDefinition(READ),'BillTextReadOutput');for(const op of ['__proto__','constructor','read_amendment_text'])assert.throws(()=>v.normalizeBillTextInput(op,{},context));});
+test('trusted defaultCongress required; model arguments cannot inject authority',()=>{for(const ctx of [undefined,{},null,{defaultCongress:0},{defaultCongress:1.5},{defaultCongress:'119'},{defaultCongress:119,actorId:'x'}])assert.throws(()=>v.normalizeBillTextInput(SEARCH,{},ctx));for(const key of ['defaultCongress','tenantId','currentPointer','actorId','asOf'])assert.throws(()=>v.normalizeBillTextInput(SEARCH,{[key]:119},context));});
+test('request normalization preserves query/search aliases and exact UTF16 caps',()=>{for(const query of [undefined,null,'','  ']){const input={search:' Minerals ',...(query===undefined?{}:{query})};assert.equal(v.normalizeBillTextInput(SEARCH,input,context).input.query,'Minerals');}assert.equal(v.normalizeBillTextInput(SEARCH,{query:' First ',search:'Second'},context).input.query,'First');assert.equal(v.normalizeBillTextInput(SEARCH,{query:'x'.repeat(239)+'😀'},context).input.query,'x'.repeat(239)+'\ud83d');assert.deepEqual(v.normalizeBillTextInput(SEARCH,{search:null,congress:0},context).input,{page:1,limit:20});});
+test('text and metadata limits/defaults differ; registered text limit is conservatively clamped',()=>{assert.equal(v.normalizeBillTextInput(SEARCH,{textQuery:'x'},context).input.limit,8);assert.equal(v.normalizeBillTextInput(SEARCH,{textQuery:'x',limit:50},context).input.limit,10);for(const limit of [0,51,1.5,'10',null])assert.throws(()=>v.normalizeBillTextInput(SEARCH,{limit},context));for(const page of [0,101,'1',1.5])assert.throws(()=>v.normalizeBillTextInput(SEARCH,{page},context));});
+test('metadata returns all stored scalar/null fields and opaque committees without false total equality',()=>{const p=metadata();p.total=0;p.data[0].cosponsorsCount=-1;check(SEARCH,p);delete p.data[0].sponsorBioguideId;assert.throws(()=>check(SEARCH,p));});
+test('metadata nullable dates, newer-first non-null order, unknown statuses stay distinct',()=>{const p=metadata();p.data[0].status='Unrecognized stored label';p.data[0].introducedDate='2026-01-01T00:00:00.000Z';check(SEARCH,p);p.data[0].introducedDate='2026-01-01T12:00:00.000Z';assert.throws(()=>check(SEARCH,p));const ordered=metadata();ordered.data.push({...rawBill(),id:'119-s-2',updateDate:stamp});ordered.data[0].updateDate='2026-10-01T00:00:00.000Z';assert.throws(()=>check(SEARCH,ordered));});
+test('direct designation has one exact bill, page1 and ignores metadata filters by original branch',()=>{const p=metadata();p.resolvedBy='bill-id';check(SEARCH,p,{query:'H.R. 1',congress:118,page:4});const n=v.normalizeBillTextInput(SEARCH,{query:'H.R. 1'},context);assert.equal(n.metadata.directBillId,billId);p.data[0].id='119-hr-2';assert.throws(()=>check(SEARCH,p,{query:'H.R. 1'}));});
+test('designation miss can fall back to metadata page; no fabricated unavailable search envelope',()=>{const p=metadata();p.page=3;p.data=[];p.total=0;check(SEARCH,p,{query:'H.R. 1',page:3});p.found=false;assert.throws(()=>check(SEARCH,p,{query:'H.R. 1',page:3}));});
+test('text search scalar/null fields and same-bill cross-version passage cursor are preserved',()=>{const p=textPage();p.results[0].passages.push({snippet:'other version',startOffset:12,readCursor:encode(12,{versionCode:'eh',revisionId:'bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb',textHash:'c'.repeat(64)})});check(SEARCH,p,{textQuery:'minerals'});p.results[0].passages[1].readCursor=encode(12,{billId:'119-s-2'});assert.throws(()=>check(SEARCH,p,{textQuery:'minerals'}));});
