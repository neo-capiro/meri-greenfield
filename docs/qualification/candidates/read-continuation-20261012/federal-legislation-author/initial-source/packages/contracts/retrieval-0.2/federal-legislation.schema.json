    "FederalInvalidBillNote": {
      "const": "Provide a bill id (\"119-hr-8800\") or designation (\"H.R. 8800\")."
    },
    "FederalNoBillVoteNote": {
      "const": "No recorded roll-call vote on this bill itself. Do NOT infer that it passed or failed a chamber from the absence of a vote."
    },
    "FederalRuleFailedNote": {
      "const": "The rule governing this bill FAILED \u2014 the bill did NOT advance to the floor under that rule; it is stalled, not pending passage."
    },
    "FederalNoVotesNote": {
      "const": "No roll-call vote on record matches that. Say so explicitly \u2014 do not infer a vote outcome or tally."
    },
