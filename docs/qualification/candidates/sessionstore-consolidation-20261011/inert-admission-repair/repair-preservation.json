{
  "base": "cf9eb76a0f9ea797151a2684bc83592ae1033c9f",
  "original16TestBodiesPreserved": true,
  "originalTestNames": [
    "pinned SDK interface roundtrips unknown/compaction fields and repeated UUID-less entries",
    "all append calls are delivered in call order even when an earlier commit is delayed",
    "input and loaded values cannot mutate stored state or trusted binding",
    "foreign session/project and malformed key refuse before transport",
    "JSON-unsafe entries and payload/entry bounds refuse before transport",
    "invalid canonical binding, missing subkey transport and timeout policy fail at construction",
    "transport errors are redacted, and a successful SDK retry can follow a definite rejection",
    "uncertain timeout aborts its signal and refuses queued/retried dispatch",
    "closing rejects late SDK writes; observed settlement is not labelled durable",
    "trusted execution boundary can reject an obsolete generation before append",
    "unknown append rejection is treated as possibly committed and is never retried by dispatch",
    "full transcripts can exceed one append batch without truncation",
    "whole-snapshot verification checks ordered main/subagent entries and produces readback-only digest",
    "missing, changed, reordered, duplicated or omitted UUID-less transcript records fail verification",
    "missing or extra subagent streams and missing main refuse",
    "backend cannot return malformed/duplicate subkeys or invalid transcript entries"
  ],
  "newAdversarialGroups": 7,
