  "findings": [
    {
      "id": "N1",
      "finding": "Top-level source allocates a fixed destination and executes native child; safe import not supported."
    },
    {
      "id": "N2",
      "finding": "Pre/post Git, recursive evidence enumeration, complete-file hashing and packaging fall outside15second execution interval; no aggregate bound."
    },
    {
      "id": "N3",
      "finding": "Synchronous process creation, kill/wait, thread joins and stream close do not establish hard total-time preemption; additional3second waits and2seconds per reader are distinct."
    },
    {
      "id": "N4",
      "finding": "Reader-thread completion implies EOF only in absence of reader errors; missing/late EOF, live reader and output overflow must remain failure/UNKNOWN."
    },
    {
      "id": "N5",
      "finding": "Direct-child physical exit is separate from descendant teardown; source already labels descendants unqualified."
    },
    {
      "id": "N6",
      "finding": "Selected executable name derives from original receipt but current selected bytes/handle invariants are not independently pinned by this wrapper."
    },
    {
      "id": "N7",
      "finding": "Current wrapper hash is newly verified; old command receipt did not bind it, so historical execution source remains unproven."
    },
    {
      "id": "N8",
      "finding": "Supporting identity JSON filenames/bytes not supplied; reported identity/hash-refusal observations are not independently verified by this review."
    }
  ],
