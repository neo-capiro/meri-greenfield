diff --git a/packages/contracts/test/retrieval-client-knowledge-monday.test.mjs b/packages/contracts/test/retrieval-client-knowledge-monday.test.mjs
new file mode 100644
index 00000000..12405de8
--- /dev/null
+++ b/packages/contracts/test/retrieval-client-knowledge-monday.test.mjs
@@ -0,0 +1,21 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import Ajv from 'ajv/dist/2020.js';
+import formats from 'ajv-formats';
+import {createClientKnowledgeMondayValidators} from '../retrieval-0.2/client-knowledge-monday-validation.mjs';
+const load=name=>JSON.parse(readFileSync(new URL(`../retrieval-0.2/${name}.schema.json`,import.meta.url)));
+const schema=load('client-knowledge-monday'),ajv=new Ajv({strict:true,allErrors:true});formats(ajv);ajv.addSchema(load('data-search'));ajv.addSchema(schema);
+const v=createClientKnowledgeMondayValidators({schema,validateShape:(name,value)=>{const fn=ajv.getSchema(`${schema.$id}#/$defs/${name}`);if(!fn(value))throw new Error(JSON.stringify(fn.errors));}});
+const id='read_monday_client_boards', clientId='11111111-1111-1111-1111-111111111111';
+const source={domain:'monday',sourceStatus:'healthy',returned:1,recordsEvaluated:1,requestedEntityCount:1,searchedEntityCount:1,pagesRead:1,hasMore:false,truncated:false,paginationComplete:true,coverageComplete:true,stopReason:'monday_mapped_boards_complete'};
+const row=()=>({domain:'monday',recordId:'1:2',payload:{clientId,sourceActorUserId:'actor',title:{opaque:true},status:null,owners:[{id:5}],dueDate:'provider date',origin:{provider:'monday',boardId:'1',itemId:'2',itemType:'item',scope:'saved_mapping'},updates:[{}],columns:[null,{value:{data:'external'}}],url:null},provenance:{source:'managed_monday_mcp',boardId:'1',itemId:'2'}});
+const page=()=>({tool:id,authoritativeOwner:'managed_monday_mcp',currentStatus:'healthy',clientId,records:[row()],coverage:{requestedDomains:['monday'],searchedDomains:['monday'],requestedEntityCount:1,searchedEntityCount:1,recordsEvaluated:1,recordsReturned:1,paginationComplete:true,unavailableSources:[],sources:[structuredClone(source)],complete:true,stopReason:'done'}});
+test('Monday normalized complete/page distinction and Number string semantics',()=>{assert.deepEqual(v.normalizeInput(id,{clientId}).input,{clientId,boardContext:null,cursor:null,pageSize:null,requireComplete:true});for(const [raw,n] of [['',1],['2.9',2],['2junk',100],[null,100],[200,100]])assert.equal(v.normalizeInput(id,{clientId,pageSize:raw}).input.pageSize,n);assert.equal(v.normalizeInput(id,{clientId,cursor:' opaque '}).input.requireComplete,false);});
+test('Monday requires UUID and bounded trimmed selectors',()=>{assert.throws(()=>v.normalizeInput(id,{clientId:'name'}));assert.equal(v.normalizeInput(id,{clientId,boardContext:' x '.repeat(1000)}).input.boardContext.length,2000);});
+test('Monday full provider JSON fields stay inert without invented scalar types',()=>v.assertResult(id,page(),{clientId}));
+test('Monday parent and provenance binding preserves subitems',()=>{const p=page();p.records[0].payload.origin.parentItemId='3';p.records[0].payload.origin.itemType='subitem';p.records[0].provenance.parentItemId='3';v.assertResult(id,p,{clientId});p.records[0].provenance.parentItemId='4';assert.throws(()=>v.assertResult(id,p,{clientId}));});
+test('Monday current status echoes first coverage source including unavailable',()=>{const p=page();p.currentStatus='unavailable';assert.throws(()=>v.assertResult(id,p,{clientId}));p.records=[];p.coverage.sources=[];v.assertResult(id,p,{clientId});});
+test('Monday client, record, domain and duplicate substitutions fail',()=>{for(const mutate of [p=>p.clientId='other',p=>p.records[0].payload.clientId='other',p=>p.records[0].recordId='1:3',p=>p.records.push(row()),p=>p.coverage.requestedDomains=['mail']]){const p=page();mutate(p);assert.throws(()=>v.assertResult(id,p,{clientId}));}});
+test('Monday invalid cursors remain bounded request data awaiting source refusal',()=>{assert.equal(v.normalizeInput(id,{clientId,cursor:'not-signed'}).input.cursor,'not-signed');const p=page();p.records=[];p.currentStatus='error';p.coverage.sources[0].sourceStatus='error';p.coverage.sources[0].stopReason='monday_cursor_invalid';v.assertResult(id,p,{clientId,cursor:'not-signed'});});
+test('Monday source-only data detaches and rejects getters',()=>{const p=page(),out=v.assertResult(id,p,{clientId});assert.notEqual(out.records[0].payload.columns,p.records[0].payload.columns);let touched=0;assert.throws(()=>v.normalizeInput(id,{get clientId(){touched++;return clientId;}}));assert.equal(touched,0);});
