+const load=name=>JSON.parse(readFileSync(new URL(`../retrieval-0.2/${name}.schema.json`,import.meta.url)));
+const schema=load('client-knowledge-attachments'),ajv=new Ajv({strict:true,allErrors:true});formats(ajv);ajv.addSchema(load('data-search'));ajv.addSchema(schema);
+const v=createClientKnowledgeAttachmentValidators({schema,validateShape:(name,value)=>{const f=ajv.getSchema(`${schema.$id}#/$defs/${name}`);if(!f(value))throw new Error(JSON.stringify(f.errors));}});
+const id='read_chat_attachments',u='11111111-1111-1111-1111-111111111111',a='22222222-2222-2222-2222-222222222222',h='a'.repeat(64),dt='2026-10-12T00:00:00.000Z';
+const ctx={asOf:dt,scope:{tenantId:u,userId:u,conversationId:u,clientId:null,conversationVersion:dt}},req={conversationId:u};
+const base={tool:id,authoritativeOwner:'clio_chat_attachment',currentStatus:'available',generatedAt:dt,conversationId:u,clientId:null};
+const manifest=()=>({...base,coverage:{mode:'manifest',total:null,returned:0,unavailableInPage:0,scannedMessages:0,paginationComplete:true,complete:true,contentComplete:false,nextCursor:null,query:null,queryAppliesTo:'filename',note:'This is a finite metadata manifest, not file content. Follow nextCursor until paginationComplete before treating the inventory as complete.'},records:[]});
+const cursor=payload=>'chat-attachment:v1:'+Buffer.from(JSON.stringify(payload)).toString('base64url')+'.'+Buffer.alloc(32).toString('base64url');
+const payload=()=>({v:1,mode:'read',...ctx.scope,query:'',attachmentId:a,messageId:u,originalBytesHash:h,locator:{section:1,rowStart:1,offset:0}});
+function section(){const locator={section:1,rowStart:1,offset:0},reference=`${a}:${h.slice(0,16)}:text_section:1:0-3`,coordinates={section:1};return {...base,source:{attachmentId:a,sourceMessageId:u,filename:'a.txt',sourceKind:'text',mediaType:'text/plain',byteSize:3,originalBytesHash:h,persistedExtractionStatus:'parsed',persistedExtractionReason:null},coverage:{mode:'section',locator,sectionKind:'text_section',sectionLabel:'Text section 1',sectionCount:1,coordinates,characterStart:0,characterEnd:3,sectionCharacters:3,extractionStatus:'complete',limitation:null,matched:null,query:null,sectionComplete:true,contentComplete:true,paginationComplete:true,truncated:false,complete:true,nextCursor:null,note:'Content was decoded from the currently authorized original persisted bytes. Follow nextCursor for remaining text or typed sections; an empty or partial section is not evidence that later sections are empty.'},records:[{domain:'chat_attachments',recordId:reference,payload:{id:reference,attachmentId:a,title:'a.txt',sourceKind:'text',sectionKind:'text_section',sectionLabel:'Text section 1',coordinates,characterStart:0,characterEnd:3,text:'abc'},provenance:{sourceType:'ordinary_chat_attachment_original_bytes',sourceRecordId:a,sourceMessageId:u,conversationId:u,clientId:null,originalBytesHash:h,locator,trust:'external_untrusted'}}]};}
+test('attachment manifest defaults and empty query difference',()=>{assert.equal(v.normalizeInput(id,req,ctx).input.limit,10);assert.equal(v.normalizeInput(id,{...req,attachmentId:a},ctx).input.limit,5000);assert.throws(()=>v.normalizeInput(id,{...req,query:''},ctx));assert.throws(()=>v.normalizeInput(id,{...req,limit:'1'},ctx));});
+test('attachment complete manifest does not establish content completeness',()=>{v.assertResult(id,manifest(),req,ctx);const p=manifest();p.coverage.contentComplete=true;assert.throws(()=>v.assertResult(id,p,req,ctx));});
+test('attachment source sections bind text, bytes receipt, locator and external trust',()=>{v.assertResult(id,section(),{...req,attachmentId:a},ctx);for(const mutate of [p=>p.source.attachmentId=u,p=>p.records[0].payload.text='xxxx',p=>p.coverage.complete=false,p=>p.records[0].provenance.trust='approved']){const p=section();mutate(p);assert.throws(()=>v.assertResult(id,p,{...req,attachmentId:a},ctx));}});
+test('attachment cursor is correlated but fake HMAC is expressly not authenticated',()=>{const c=cursor(payload()),n=v.normalizeInput(id,{...req,attachmentId:a,cursor:c},ctx);assert.equal(n.metadata.cursorAuthenticated,false);v.assertResult(id,section(),{...req,attachmentId:a,cursor:c},ctx);for(const key of ['userId','tenantId','conversationId','attachmentId']){const p=payload();p[key]='33333333-3333-3333-3333-333333333333';assert.throws(()=>v.normalizeInput(id,{...req,attachmentId:a,cursor:cursor(p)},ctx));}});
+test('attachment cursor stale version, noncanonical encoding and explicit locator conflict fail',()=>{const p=payload();p.conversationVersion='old';assert.throws(()=>v.normalizeInput(id,{...req,attachmentId:a,cursor:cursor(p)},ctx));assert.throws(()=>v.normalizeInput(id,{...req,attachmentId:a,cursor:cursor(payload())+'='},ctx));assert.throws(()=>v.normalizeInput(id,{...req,attachmentId:a,cursor:cursor(payload()),section:1},ctx));});
+test('attachment metadata permits signed stored page counts and absent original bytes',()=>{const p=manifest();p.records=[{attachmentId:a,filename:'named.bin',kind:'old-kind',sourceMessageId:u,uploadedAt:dt,extractionStatus:'old-status',extractionReason:null,byteSize:-1,pages:-1,originalBytesAvailable:false,originalBytesHash:null}];p.coverage.returned=1;p.coverage.scannedMessages=1;v.assertResult(id,p,req,ctx);p.records[0].originalBytesAvailable=true;assert.throws(()=>v.assertResult(id,p,req,ctx));});
+test('attachment partial/empty section is not complete even without next cursor',()=>{const p=section();p.records=[];p.coverage.characterStart=3;p.coverage.characterEnd=3;p.coverage.sectionComplete=false;p.coverage.contentComplete=false;p.coverage.complete=false;v.assertResult(id,p,{...req,attachmentId:a,characterOffset:3},ctx);});
+test('attachment detached return and hostile nested JSON',()=>{const p=section(),out=v.assertResult(id,p,{...req,attachmentId:a},ctx);assert.notEqual(out.records[0].payload,p.records[0].payload);let touched=0;assert.throws(()=>v.normalizeInput(id,{...req,get query(){touched++;return 'x';}},ctx));assert.equal(touched,0);});
