+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "urn:meri:schedules:inspection:0.2.0",
+  "description": "Read-only bounded Temporal observation, not current authorization or complete execution history.",
+  "$defs": {
+    "ScheduleInspectionBinding": {
+      "type": "object",
+      "properties": {
+        "projection": {
+          "$ref": "urn:meri:contracts:0.1.0#/$defs/ScheduleProjection"
+        },
+        "callerIdentity": {
+          "$ref": "urn:meri:contracts:0.1.0#/$defs/Identity"
+        },
+        "deadlineMs": {
+          "type": "integer",
+          "minimum": 0,
+          "maximum": 9007199254740991
+        }
+      },
+      "required": [
+        "projection",
+        "callerIdentity",
+        "deadlineMs"
+      ],
+      "additionalProperties": false
+    },
+    "ScheduleInspectionAuthorization": {
+      "type": "object",
+      "properties": {
+        "authorized": {
+          "const": true
+        },
+        "projectionSha256": {
+          "type": "string",
+          "pattern": "^[a-f0-9]{64}$"
+        },
+        "callerIdentity": {
+          "$ref": "urn:meri:contracts:0.1.0#/$defs/Identity"
+        },
+        "expiresAtMs": {
+          "type": "integer",
+          "minimum": 0,
+          "maximum": 9007199254740991
+        }
+      },
+      "required": [
+        "authorized",
+        "projectionSha256",
+        "callerIdentity",
+        "expiresAtMs"
+      ],
+      "additionalProperties": false
+    },
+    "ScheduleOriginalRun": {
+      "type": "object",
+      "properties": {
+        "workflowId": {
+          "type": "string",
+          "minLength": 1
+        },
+        "firstExecutionRunId": {
+          "type": "string",
+          "minLength": 1
+        }
+      },
+      "required": [
+        "workflowId",
+        "firstExecutionRunId"
+      ],
+      "additionalProperties": false
+    },
+    "ScheduleRecentAction": {
+      "type": "object",
+      "properties": {
+        "scheduledAt": {
+          "type": "string",
+          "format": "date-time"
+        },
+        "takenAt": {
+          "type": "string",
+          "format": "date-time"
+        },
+        "workflow": {
+          "$ref": "#/$defs/ScheduleOriginalRun"
+        }
+      },
+      "required": [
+        "scheduledAt",
+        "takenAt",
+        "workflow"
+      ],
+      "additionalProperties": false
+    },
+    "ScheduleInspectionWindow": {
+      "type": "object",
+      "properties": {
+        "observed": {
+          "type": "integer",
+          "minimum": 0,
+          "maximum": 9007199254740991
+        },
+        "returned": {
+          "type": "integer",
+          "minimum": 0,
+          "maximum": 9007199254740991
+        },
+        "omitted": {
+          "type": "integer",
+          "minimum": 0,
+          "maximum": 9007199254740991
+        }
+      },
+      "required": [
+        "observed",
+        "returned",
+        "omitted"
+      ],
+      "additionalProperties": false
+    },
+    "ScheduleInspectionOutput": {
+      "type": "object",
+      "properties": {
+        "projection": {
+          "$ref": "urn:meri:contracts:0.1.0#/$defs/ScheduleProjection"
+        },
+        "projectionSha256": {
+          "type": "string",
+          "pattern": "^[a-f0-9]{64}$"
+        },
+        "observedAt": {
+          "type": "string",
+          "format": "date-time"
+        },
