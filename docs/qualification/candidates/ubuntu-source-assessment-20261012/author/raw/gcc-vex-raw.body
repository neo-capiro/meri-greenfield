      "vulnerability": {
        "@id": "https://nvd.nist.gov/vuln/detail/CVE-2026-95619",
        "name": "CVE-2026-95619",
        "description": "A flaw was found in libstdc++. An integer overflow can occur when processing large inputs to the aligned operator new in the C++ library. This vulnerability could lead to an undersized memory allocation, potentially causing memory corruption or application instability.",
        "aliases": [
          "https://www.cve.org/CVERecord?id=CVE-2026-95619",
