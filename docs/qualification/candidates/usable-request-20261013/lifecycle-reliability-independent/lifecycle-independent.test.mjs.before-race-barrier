test('external pipeline cancellation after SDK text stops completion, closes query and preserves earlier durable text',async()=>{
 const f=await applicationFixture(),controller=new AbortController();try{await f.service.submit({credential:f.credential,input:f.input});const w=await worker(f,complete,{beforeFrame:async frame=>{if(frame.type==='result')controller.abort(Error('synthetic-cancellation'));}});
  await assert.rejects(w.execute({binding,signal:controller.signal}),/EXECUTION_STOPPED/u);assert.equal(w.counts().calls,1);assert.equal(w.counts().closed,1);const h=await f.service.history({credential:f.credential});assert.equal(h.run.state,'cancelled');assert.equal(h.events.filter(e=>e.type==='message.delta').map(e=>e.data.text).join(''),'Public answer');assert.equal(h.events.some(e=>e.type==='run.status'&&e.data.state==='completed'),false);
