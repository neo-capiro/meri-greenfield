test('lost event COMMIT acknowledgement preserves exact text/event identity after owner reconstruction without duplicate event',async()=>{
 const f=await applicationFixture();try{await f.service.submit({credential:f.credential,input:f.input});
  const event=(n,type,data)=>({eventId:id(n),createdAt:'2026-10-13T12:00:00.000Z',type,data});
  await f.runOwner.append({binding,event:event(800,'run.status',{state:'starting',reasonCode:null})});await f.runOwner.append({binding,event:event(801,'run.status',{state:'running',reasonCode:null})});
  const text=event(802,'message.delta',{messageId:id(803),text:'Retained immutable text'});f.state.commitUnknown=true;await assert.rejects(f.runOwner.append({binding,event:text}),/STORE_COMMIT_UNKNOWN/u);
  const retained=structuredClone(f.state.events.values().next().value);f.state.commitUnknown=false;
  const response=await f.runOwner.append({binding,event:text});assert.equal(response.sequence,4);assert.deepEqual(f.state.events.values().next().value,retained);
  const h=await f.service.history({credential:f.credential,after:3});assert.equal(h.events.length,1);assert.equal(h.events[0].eventId,text.eventId);assert.equal(h.events[0].data.text,text.data.text);assert.equal(h.lastSequence,4);assert.equal(h.run.state,'running');
 }finally{f.close();}
});

