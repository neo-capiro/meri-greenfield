const runtime=()=>({binding,versions,cwd:`/workspace/conversations/${binding.conversationId}`,proxyUrl:'https://trusted-proxy.invalid',proxyCredential:'synthetic-task-capability',model:'scripted-source-review',sessionStore:{async load(){return null;},async append(){}},deadlineMs:Date.now()+1000,maxTurns:2,maxCostMicroUSD:1000,maxOutputBytes:1024});
const complete=[{type:'assistant',message:{id:'main',content:[{type:'text',text:'Public answer'}]}},{type:'result',subtype:'success',is_error:false}];
async function worker(f,frames=complete,options={}){
 let calls=0,closed=0,n=700;
 const query=()=>{calls++;return {async *[Symbol.asyncIterator](){for(const frame of frames){await options.beforeFrame?.(frame);yield frame;}},close(){closed++;}};};
 const execute=createConversationActivity({runOwner:f.runOwner,prepareRuntime:options.prepareRuntime??(async()=>runtime()),query,newId:()=>id(n++)});
 return {execute,counts:()=>({calls,closed})};
}

test('two simultaneously prepared activities permit one winning SDK execution without loser poisoning',async()=>{
 const f=await applicationFixture();try{
  await f.service.submit({credential:f.credential,input:f.input});let prepared=0,release;const barrier=new Promise(r=>release=r);
  const w=await worker(f,complete,{prepareRuntime:async()=>{if(++prepared===2)release();await barrier;return runtime();}});
  const result=await Promise.allSettled([w.execute({binding}),w.execute({binding})]);
  assert.equal(result.filter(x=>x.status==='fulfilled').length,1);
  assert.equal(w.counts().calls,1);assert.equal(w.counts().closed,1);
  const h=await f.service.history({credential:f.credential});assert.equal(h.run.state,'completed');assert.equal(h.events.filter(e=>e.type==='run.status'&&e.data.state==='failed').length,0);
 }finally{f.close();}
});

test('actual submit consumer normalizes trusted Sunday calendar window through DST at fixed reference',async()=>{
 const f=await applicationFixture();try{
  let clock=Date.parse('2026-11-01T16:00:00.000Z'),n=800;
  const authentication={principal:{tenantId:binding.tenantId,actorId:binding.actorId,conversationId:binding.conversationId,runId:binding.runId},checkedAtMs:clock,expiresAtMs:clock+30000};
  const sessions={async authenticateSession(){return {...authentication,checkedAtMs:clock,expiresAtMs:clock+30000};},async readCurrentState({authentication:a}){return {authenticationSha256:hash(a),...f.state.context,checkedAtMs:clock,expiresAtMs:clock+30000};}};
  const service=createConversationService({sessions,store:f.store,dispatcher:f.dispatcher,versions,now:()=>clock,newId:()=>id(n++)});
  await service.submit({credential:'synthetic-only-session',input:{...f.input,windowRequest:{basis:'calendar-week',offset:0,timezone:'America/New_York',weekStartsOn:'sunday'}}});
  const h=await service.history({credential:'synthetic-only-session'});assert.equal(h.request.window.startInclusive,'2026-11-01T04:00:00Z');assert.equal(h.request.window.endExclusive,'2026-11-08T05:00:00Z');assert.equal(h.request.window.basis,'calendar-week');assert.equal(h.request.window.weekStartsOn,'sunday');assert.equal(h.request.window.timezone,'America/New_York');
  assert.equal(Date.parse(h.request.window.endExclusive)-Date.parse(h.request.window.startInclusive),169*3600000);
 }finally{f.close();}
});

