test('cancelled subscription aborts its owned polling signal and cannot release a later page',async()=>{
 let observed,resolvePage,reads=0;const page=new Promise(r=>resolvePage=r),source=createConversationEventSource({service:{history({signal}){observed=signal;reads++;return page;}},credential:'synthetic-only-session',pollMs:10,maxSubscriptionMs:1000});
 const reader=source.getReader(),pending=reader.read();while(!observed)await new Promise(r=>setTimeout(r,1));await reader.cancel('review-disconnect');assert.equal(observed.aborted,true);resolvePage({events:[],run:{state:'running'},lastSequence:0});assert.equal((await pending).done,true);await new Promise(r=>setTimeout(r,20));assert.equal(reads,1);reader.releaseLock();
});
