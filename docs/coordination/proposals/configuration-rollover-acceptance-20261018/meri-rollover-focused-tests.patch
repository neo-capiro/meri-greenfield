+
+test('accepted child inherits the transition digest while keeping its own reservation and current versions',async()=>{
+ const f=fixture(),selected=await f.journal.current(target,check);
+ await f.journal.accept({...f.firstInput,effectiveAdmissionSha256:selected.effectiveAdmission.descriptorSha256},check);
+ const accepted=f.state.runs[1];accepted.projection.state='failed';accepted.projection_sha256=hash(accepted.projection);
