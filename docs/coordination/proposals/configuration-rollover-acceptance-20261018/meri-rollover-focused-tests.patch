+ assert.equal((await f.journal.accept({...f.firstInput,effectiveAdmissionSha256:current.effectiveAdmission.descriptorSha256},check)).replayed,true);
+ assert.equal(f.state.inserts.length,1);assert.equal(await f.journal.execution({binding:target,scopes,selectedClientId:id(5)},check),null);
+ f.state.runs[1].transition_sha256='0'.repeat(64);
+ await assert.rejects(f.journal.current(target,check),/NEXT_RUN_ADOPTION_CORRUPT/u);
+});
+
+test('expired RESERVED adoption refuses current and first acceptance without a Run write',async()=>{
