+const inputFor=(b,pins,n,offset)=>{const run=projection(b,pins,'queued',time(offset)),sourceRequest=request(b,n);return {conversation,run,request:sourceRequest,event:{contractVersion:'0.1.0',eventId:id(n+100),binding:b,sequence:1,createdAt:time(offset),scopes,type:'run.status',data:{state:'queued',reasonCode:null}},selectedClientId:id(5)};};
+function fixture(){
+ const state={clock:at+3000,original:[structuredClone(originalRow)],next:[structuredClone(first)],adoptions:[structuredClone(adoptionRow)],runs:[runRow(projection(binding,versions,'failed',time(0)),request(binding,6))],events:[],inserts:[]};
+ const client={async query(sql,args=[]){
+  if(sql.startsWith('SELECT * FROM meri_conversations.conversations'))return {rows:[{tenant_id:binding.tenantId,conversation_id:binding.conversationId,owner_actor_id:binding.actorId,projection:conversation,projection_sha256:hash(conversation)}]};
+  if(sql.startsWith('SELECT * FROM meri_conversations.initial_run_bindings'))return {rows:structuredClone(state.original)};
