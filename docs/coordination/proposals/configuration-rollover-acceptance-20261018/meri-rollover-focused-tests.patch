+/** Focused scripted transaction for the next-run adoption junction; no live SQL or Core calls. */
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createNextRunJournal} from '../next-run-journal.mjs';
+import {hash} from '../boundary.mjs';
+import {binding,id,scopes,versions} from './store-fixture.mjs';
+
+const at=1800000000000,oldSha='c'.repeat(64),newSha='d'.repeat(64),newVersions={...versions,imageDigest:`sha256:${'f'.repeat(64)}`,sdk:'0.3.296'};
+const target={...binding,runId:id(11),attemptId:id(12),workerId:id(13),writerFence:2};
+const descendant={...binding,runId:id(21),attemptId:id(22),workerId:id(23),writerFence:3};
+const time=offset=>new Date(at+offset).toISOString(),check=()=>{};
+const originalRecord={schemaVersion:1,state:'ADMITTED',binding,selectedClientId:id(5),policyRevision:'policy1',versions,configurationSha256:oldSha,createdAtMs:at-1000,expiresAtMs:at+60000};
+const originalRow={tenant_id:binding.tenantId,conversation_id:binding.conversationId,run_id:binding.runId,record:originalRecord,record_sha256:hash(originalRecord)};
+const reserve=(source,destination,pins)=>{const reservation={source,target:destination,facts:{checkpoint:null,noAuthority:{foreclosureSha256:'a'.repeat(64)}},scopes,versions:pins,policyRevision:'policy1',reservedAt:time(1000)};return {tenant_id:binding.tenantId,conversation_id:binding.conversationId,source_run_id:source.runId,target_run_id:destination.runId,reservation,reservation_sha256:hash(reservation),state:'RESERVED'};};
+const first=reserve(binding,target,versions);
+const receipt={schemaVersion:1,source:binding,target,originalAdmissionSha256:originalRow.record_sha256,reservationSha256:first.reservation_sha256,selectedClientId:id(5),scopes,policyRevision:'policy1',fromConfigurationSha256:oldSha,fromVersions:versions,toConfigurationSha256:newSha,toVersions:newVersions,authorityDecisionSha256:'b'.repeat(64),authorityCheckedAtMs:at+1000,authorityExpiresAtMs:at+30000,adoptedAtMs:at+2000,validUntilMs:at+5000};
+const adoptionRow={tenant_id:binding.tenantId,conversation_id:binding.conversationId,target_run_id:target.runId,receipt,receipt_sha256:hash(receipt)};
+const conversation={conversationId:binding.conversationId,owner:{tenantId:binding.tenantId,actorId:binding.actorId},scopes,createdAt:time(0),policyRevision:'policy1'};
+const request=(b,n)=>({requestId:id(n),prompt:`prompt ${n}`,skill:null,window:null,windowRequest:null});
