{
  "name": "@capiro/portfolio-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 5188",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 5188",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src tests",
    "format:check": "prettier --check src tests *.json *.ts *.mjs",
    "architecture": "node scripts/architecture.mjs",
    "check": "npm run typecheck && npm run lint && npm run architecture && npm test && npm run build",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.14",
    "@schedule-x/calendar": "4.9.1",
    "@schedule-x/calendar-controls": "4.9.1",
    "@schedule-x/react": "4.1.0",
    "@schedule-x/theme-default": "4.9.1",
    "@tanstack/react-query": "5.104.1",
    "@xyflow/react": "12.12.0",
    "d3-geo": "3.1.1",
    "geist": "1.7.2",
    "lucide-react": "0.577.0",
    "next": "16.4.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "temporal-polyfill": "0.3.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/d3-geo": "3.1.1",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.2",
    "eslint-config-next": "16.4.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "vite": "8.3.4"
  }
}
