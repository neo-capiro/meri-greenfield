{
  "name": "@meri/assembled-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=24 <25"},
  "scripts": {
    "start:control": "node cli.mjs control",
    "start:worker": "node cli.mjs temporal-worker",
    "start:runner": "node cli.mjs conversation-runner",
    "test": "node --experimental-test-module-mocks --test test/*.test.mjs telemetry/test/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-ecs": "3.1151.0",
    "@hono/node-server": "2.1.5",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "pg": "8.23.1"
  },
  "devDependencies": {"typescript": "5.9.3", "@types/node": "24.19.2"}
}
