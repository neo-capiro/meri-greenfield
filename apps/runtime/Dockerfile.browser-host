# syntax=docker/dockerfile:1
# Provisioned browser-only host image (linux/arm64, c7g). It carries the host service sources, Playwright MCP 0.0.83 with
# its pinned playwright-core and Chromium build, the two root-only C helpers compiled from this tree, and the network
# tools the per-run compartment and the proxy-uid nft guard need (iproute2, nftables). Identities: sdk 1001 (workspace
# owner only), browser 2002, host relay 3001, local relay 3002, egress proxy 3003. Build once per source commit, push to
# meri-greenfield/browser-host, scan the digest (0 HIGH/CRITICAL), then bake the browser host AMI from it exactly as the
# native host AMI is baked from the runtime image. The host service runs as root on the instance (it owns cgroups, network
# namespaces and the helpers); every browser, relay and workspace process is dropped to its fixed unprivileged identity by
# the helpers, never by this image.
#
# Pins:
#  - NODE_IMAGE is the same immutable linux/arm64 Node 24.22.1 trixie-slim child manifest the runtime image uses
#    (infra/product-preview/runtime-packages.lock.json: nodeImageUri).
#  - DEBIAN_SNAPSHOT fixes every apt candidate; versions are recorded from the real build (dpkg inventory below) instead of
#    being guessed per architecture here. Bump the snapshot deliberately and re-scan.
#  - The browser-host lockfile (apps/runtime/browser-host-service/image/package-lock.json) pins @playwright/mcp 0.0.83,
#    playwright and playwright-core 1.64.0-alpha-1790635538000 by registry integrity; regenerate it only with
#    `npm install --package-lock-only --ignore-scripts` in that directory when image/package.json changes.
ARG NODE_IMAGE=public.ecr.aws/docker/library/node@sha256:401346cb1fc12bb388a82ed58ea72eeed2fe8530804d2964bcddce63a4eda4d8
ARG DEBIAN_SNAPSHOT=20261009T000000Z

FROM ${NODE_IMAGE} AS snapshot
ARG DEBIAN_SNAPSHOT
RUN test "$(uname -m)" = aarch64 && test "$(node --version)" = v24.22.1
# Signed historical snapshot, HTTP first only to obtain ca-certificates, then HTTPS for everything else (as in
# apps/worker/qualification/Dockerfile). Signature verification stays on; no mutable suite is ever consulted.
RUN set -eux; \
    rm -f /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list; \
    printf '%s\n' \
      'Types: deb' "URIs: http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}" 'Suites: trixie' 'Components: main' \
      'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' 'Check-Valid-Until: no' '' \
      'Types: deb' "URIs: http://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT}" 'Suites: trixie-security' 'Components: main' \
      'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' 'Check-Valid-Until: no' \
      > /etc/apt/sources.list.d/meri-snapshot.sources; \
    apt-get update; apt-get install -y --no-install-recommends --no-remove ca-certificates; \
    sed -i 's#http://snapshot.debian.org#https://snapshot.debian.org#g' /etc/apt/sources.list.d/meri-snapshot.sources; \
    apt-get clean; rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------- build: dependencies, helpers, Chromium
FROM snapshot AS builder
RUN set -eux; apt-get update; apt-get install -y --no-install-recommends --no-remove gcc libc6-dev make; apt-get clean; rm -rf /var/lib/apt/lists/*
WORKDIR /opt/meri
# The host service imports shared worker and runtime modules; their locked dependency sets are installed exactly as the
# runtime image installs them (the Claude Agent SDK package arrives as a module dependency of shared worker modules and is
# never invoked here: this host has no query, provider credential or Bash process).
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund --omit=dev
COPY apps/runtime/package.json apps/runtime/package-lock.json ./apps/runtime/
RUN npm ci --prefix apps/runtime --ignore-scripts --no-audit --no-fund --omit=dev
COPY apps/worker/conversation/package.json apps/worker/conversation/package-lock.json ./apps/worker/conversation/
RUN npm ci --prefix apps/worker/conversation --ignore-scripts --no-audit --no-fund --omit=dev
# The pinned browser stack lives in its own tree so cliPath is fixed: /opt/meri/browser-host/node_modules/@playwright/mcp/cli.js
COPY apps/runtime/browser-host-service/image/package.json apps/runtime/browser-host-service/image/package-lock.json ./browser-host/
RUN npm ci --prefix browser-host --ignore-scripts --no-audit --no-fund --omit=dev && \
    test "$(node -p "require('/opt/meri/browser-host/node_modules/@playwright/mcp/package.json').version")" = 0.0.83 && \
    test "$(node -p "require('/opt/meri/browser-host/node_modules/playwright-core/package.json').version")" = 1.64.0-alpha-1790635538000
COPY apps ./apps
COPY packages ./packages
RUN mkdir -p node_modules/@capiro && ln -s ../../packages/contracts node_modules/@capiro/meri-contracts
# Root-only helpers compiled from this exact tree; their hashes become helperSha256 / nativeHostRelayHelperSha256.
RUN set -eux; \
    gcc -O2 -Wall -Wextra -Werror -D_FORTIFY_SOURCE=2 -fstack-protector-strong -fPIE -pie -Wl,-z,relro,-z,now \
      -o /opt/meri/meri-host-launcher apps/worker/conversation/host/launcher/native/meri-host-launcher.c; \
    gcc -O2 -Wall -Wextra -Werror -D_FORTIFY_SOURCE=2 -fstack-protector-strong -fPIE -pie -Wl,-z,relro,-z,now \
      -o /opt/meri/meri-host-relay-launcher apps/worker/conversation/host/network/native/meri-host-relay-launcher.c; \
    sha256sum /opt/meri/meri-host-launcher /opt/meri/meri-host-relay-launcher > /opt/meri/browser-host/helper-hashes.txt; \
    cat /opt/meri/browser-host/helper-hashes.txt
# Playwright's pinned Chromium (revision 1247 for this playwright-core) under the fixed browsers path. The setuid sandbox
# helper is not used: the launcher sets NoNewPrivs before exec, so Chromium runs its user-namespace sandbox; the AMI must
# allow unprivileged user namespaces.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/meri/browsers
RUN set -eux; \
    node browser-host/node_modules/playwright-core/cli.js install chromium; \
    test -d /opt/meri/browsers/chromium-1247; \
    chmod -R a+rX,u-s,g-s /opt/meri/browsers; \
    find /opt/meri/browsers -maxdepth 3 -type f -name 'chrome' -exec sha256sum {} \; > /opt/meri/browser-host/chromium-hashes.txt; \
    test -s /opt/meri/browser-host/chromium-hashes.txt; cat /opt/meri/browser-host/chromium-hashes.txt; \
    test -z "$(find /opt/meri/browsers -perm /6000 -type f -print)"

# ---------------------------------------------------------------- host image
FROM snapshot AS host
RUN set -eux; apt-get update; \
    apt-get install -y --no-install-recommends --no-remove \
      iproute2 nftables procps \
      libnss3 libnspr4 libatk1.0-0t64 libatk-bridge2.0-0t64 libcups2t64 libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 \
      libxfixes3 libxrandr2 libgbm1 libpango-1.0-0 libcairo2 libasound2t64 libatspi2.0-0t64 libx11-6 libxcb1 libxext6 \
      libglib2.0-0t64 libexpat1 libdbus-1-3 fonts-liberation fonts-noto-core; \
    apt-get clean; rm -rf /var/lib/apt/lists/*; \
    test -x /usr/sbin/ip && test -x /usr/sbin/nft && test -x /usr/sbin/ss
COPY --from=builder /opt/meri /opt/meri
# The bootstrap program the SSM document runs is this tree's protected-bootstrap module at its fixed path (its bytes are
# programSha256); the helpers are root-only executables at their fixed protected paths (helperSha256).
RUN set -eux; \
    ln -s /opt/meri/apps/runtime/native-processing-host/protected-bootstrap.mjs /opt/meri/native-bootstrap.mjs; \
    chown root:root /opt/meri/meri-host-launcher /opt/meri/meri-host-relay-launcher; \
    chmod 0700 /opt/meri/meri-host-launcher /opt/meri/meri-host-relay-launcher; \
    groupadd --gid 1001 meri-sdk && useradd --uid 1001 --gid 1001 --no-create-home --shell /usr/sbin/nologin meri-sdk; \
    groupadd --gid 2002 meri-browser && useradd --uid 2002 --gid 2002 --no-create-home --shell /usr/sbin/nologin meri-browser; \
    groupadd --gid 3001 meri-host-relay && useradd --uid 3001 --gid 3001 --no-create-home --shell /usr/sbin/nologin meri-host-relay; \
    groupadd --gid 3002 meri-local-relay && useradd --uid 3002 --gid 3002 --no-create-home --shell /usr/sbin/nologin meri-local-relay; \
    groupadd --gid 3003 meri-proxy && useradd --uid 3003 --gid 3003 --no-create-home --shell /usr/sbin/nologin meri-proxy; \
    mkdir -p /var/lib/meri/browser-workspaces /var/lib/meri/native-bootstrap /run/netns; \
    chmod 0755 /var/lib/meri/browser-workspaces; chmod 0700 /var/lib/meri/native-bootstrap
# Privilege-bit reduction and inventory: no SUID/SGID regular file anywhere, exact package set recorded from the real build.
RUN set -eux; \
    find / -xdev \( -path /proc -o -path /sys -o -path /dev -o -path /run \) -prune -o -type f -perm /6000 -print | while IFS= read -r f; do chmod u-s,g-s "$f"; done; \
    test -z "$(find / -xdev \( -path /proc -o -path /sys -o -path /dev -o -path /run \) -prune -o -type f -perm /6000 -print)"; \
    dpkg-query -W -f='${Package}=${Version}\n' | sort > /opt/meri/browser-host/os-installed-packages.txt; \
    test -s /opt/meri/browser-host/os-installed-packages.txt; \
    node --version > /opt/meri/browser-host/runtime-versions.txt; \
    sha256sum /opt/meri/apps/runtime/native-processing-host/protected-bootstrap.mjs >> /opt/meri/browser-host/helper-hashes.txt; \
    cat /opt/meri/browser-host/helper-hashes.txt /opt/meri/browser-host/runtime-versions.txt
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/meri/browsers NODE_ENV=production
WORKDIR /opt/meri
# Root on purpose (see header). The protected bundle at /var/lib/meri/native-bootstrap, the host cgroup2 tree and
# /run/netns come from the instance; the listener binds the instance's private address from the installed scope.
ENTRYPOINT ["node", "/opt/meri/apps/runtime/browser-host-service/host.mjs"]
