FROM ${HOST_IMAGE} AS host-repository
COPY infra/product-preview/native-apk-index/aarch64-APKINDEX-d6f8b212573cb558a4476d29eea5279c3de8a6e0b5bcc6361715bd70932a8e64.tar.gz /tmp/meri-browser-host-repo/aarch64/APKINDEX.tar.gz
COPY --from=host-repo-1 /tmp/meri-browser-host-repo /tmp/meri-browser-host-repo
COPY --from=host-repo-2 /tmp/meri-browser-host-repo /tmp/meri-browser-host-repo

# ---------------------------------------------------------------- host image
FROM ${HOST_IMAGE} AS host
USER root
# apk verifies the index signature with the vendor keys of the pinned base and installs exactly the locked name=version
# set from the staged bytes only: no network, no untrusted-file exception, no configured repository
# (--repositories-file /dev/null). Naming every member supersedes the base's world pins for the packages it upgrades.
RUN --mount=type=bind,from=host-repository,source=tmp/meri-browser-host-repo,target=/tmp/meri-browser-host-repo,readonly \
    test "$(uname -m)" = aarch64 && apk --version && \
    apk add --no-cache --no-network --repository /tmp/meri-browser-host-repo --repositories-file /dev/null --update-cache \
      alsa-lib=1.2.16.1-r5 at-spi2-core=2.62.1-r0 avahi-libs=0.9_rc5-r3 ca-certificates-bundle=20261020-r0 \
      cairo=1.18.6-r1 cups-libs=2.4.20-r0 db=2026.10.8-r0 dbus-libs=1.16.2-r11 font-liberation=2.1.5-r6 \
      fontconfig-config=2.18.3-r5 freetype=2.14.3-r7 fribidi=1.0.18-r2 gdbm=1.26-r9 glib=2.90.1-r1 \
      glibc-2.44=2.44-r11 glibc-2.44-locale-posix=2.44-r11 gmp=6.3.0-r12 graphite2=1.3.15-r6 harfbuzz=15.0.0-r3 \
      iproute2=7.3.0-r0 iptables=1.8.13-r5 jansson=2.15.1-r4 keyutils-libs=1.6.3-r41 krb5-conf=1.0-r10 \
      krb5-libs=1.22.2-r5 ld-linux-2.44=2.44-r11 libLLVM-23=23.1.4-r1 libatk-1.0=2.62.1-r0 \
      libatk-bridge-2.0=2.62.1-r0 libblkid=2.42.4-r2 libbpf=1.8.0-r0 libbrotlicommon1=1.2.1-r3 libbrotlidec1=1.2.1-r3 \
      libbrotlienc1=1.2.1-r3 libbz2-1=1.0.8-r29 libcap=2.78-r4 libcom_err=1.47.4-r5 libcrypt1-2.44=2.44-r11 \
      libdrm-libs=2.4.134-r5 libedit=3.1-r20 libelf=0.197-r0 libexpat1=2.10.0-r0 libffi=3.8.0-r2 \
      libfontconfig1=2.18.3-r5 libgcc=16.2.0-r2 libglvnd=1.7.0-r12 libmnl=1.0.5-r10 libmount=2.42.4-r2 \
      libnftnl=1.3.2-r3 libnspr=4.40-r2 libnss=3.132-r0 libpcre2-8-0=10.49-r2 libpng16-16=1.6.59-r1 \
      libproc-2-0=4.0.7-r3 libselinux=3.11-r2 libsepol=3.11-r3 libstdc++=16.2.0-r2 libsystemd=262.1-r4 \
      libsystemd-compression-libs=262.1-r4 libtirpc=1.3.8-r0 libudev=262.1-r4 libuuid=2.42.4-r2 libverto=0.3.2-r11 \
      libx11-6=1.8.14-r4 libx11-data=1.8.14-r4 libx11-xcb1=1.8.14-r4 libxau=1.0.12-r11 libxcb=1.17.0-r19 \
      libxcomposite=0.4.7-r5 libxcrypt=4.5.2-r7 libxdamage=1.1.7-r5 libxdmcp=1.1.5-r14 libxext6=1.3.7-r5 \
      libxfixes=6.0.2-r4 libxft=2.3.9-r8 libxi6=1.8.4-r1 libxkbcommon=1.13.2-r4 libxml2-16=2.15.4-r2 \
      libxrandr=1.5.5-r7 libxrender1=0.9.13-r1 libxshmfence=1.3.3-r7 libxtst6=1.2.6-r1 libzstd1=1.5.7-r13 \
      linux-pam=1.7.3-r3 lz4=1.10.0-r12 mesa-gbm=26.2.6-r0 mesa-libgallium=26.2.6-r0 mpdecimal=4.0.1-r6 \
      ncurses=6.6.20261031-r0 ncurses-terminfo-base=6.6.20261031-r0 nftables=1.1.7-r0 openssl-4.0-libcrypto=4.0.3-r8 \
      openssl-4.0-libssl=4.0.3-r8 openssl-provider-legacy-allowed=4.1.0-r0 pango=1.58.2-r1 pixman=0.46.4-r9 \
      procps=4.0.7-r3 py3-pip-wheel=26.2.2-r2 python-3.13-base=3.13.18_git20261030-r0 readline=8.3-r3 \
      sqlite-libs=3.54.1-r0 wayland-libs-client=1.26.0-r3 wolfi-baselayout=20230201-r31 xkeyboard-config=2.49-r0 \
      xz=5.8.4-r0 zlib=1.3.2.1_rc20260921-r1 zstd=1.5.7-r13 && \
    apk info -v | sort
# Wolfi glibc runs the official Node binary from the build stage, as in the runtime image.
COPY --from=builder /usr/local/bin/node /usr/local/bin/node
COPY --from=builder /opt/meri /opt/meri
RUN test "$(node --version)" = v24.22.1
# The network executables the host service runs are checked at the exact paths its source names (confinement.mjs
# NETWORK_TOOLS), so a package that moves one fails this build instead of the first run on an instance.
RUN node --input-type=module -e "import {accessSync,constants} from 'node:fs';import {NETWORK_TOOLS} from '/opt/meri/apps/worker/conversation/host/network/confinement.mjs';for(const file of Object.values(NETWORK_TOOLS)){accessSync(file,constants.X_OK);console.log(file);}"
# The bootstrap program the SSM document runs is this tree's protected-bootstrap module at its fixed path (its bytes are
# programSha256); the helpers are root-only executables at their fixed protected paths (helperSha256).
RUN set -eux; \
    ln -s /opt/meri/apps/runtime/native-processing-host/protected-bootstrap.mjs /opt/meri/native-bootstrap.mjs; \
    chown root:root /opt/meri/meri-host-launcher /opt/meri/meri-host-relay-launcher; \
    chmod 0700 /opt/meri/meri-host-launcher /opt/meri/meri-host-relay-launcher; \
    test -x /sbin/nologin; \
    addgroup -g 1001 meri-sdk && adduser -D -H -u 1001 -G meri-sdk -s /sbin/nologin meri-sdk; \
    addgroup -g 2002 meri-browser && adduser -D -H -u 2002 -G meri-browser -s /sbin/nologin meri-browser; \
    addgroup -g 3001 meri-host-relay && adduser -D -H -u 3001 -G meri-host-relay -s /sbin/nologin meri-host-relay; \
    addgroup -g 3002 meri-local-relay && adduser -D -H -u 3002 -G meri-local-relay -s /sbin/nologin meri-local-relay; \
    addgroup -g 3003 meri-proxy && adduser -D -H -u 3003 -G meri-proxy -s /sbin/nologin meri-proxy; \
    mkdir -p /var/lib/meri/browser-workspaces /var/lib/meri/native-bootstrap /run/netns; \
    chmod 0755 /var/lib/meri/browser-workspaces; chmod 0700 /var/lib/meri/native-bootstrap
# Privilege-bit reduction and inventory: no SUID/SGID regular file anywhere, exact package set recorded from the real
# build (apk's installed database), nothing left that root without capabilities cannot read (the build probe searches
# every file): the base layout's empty, unused service directories owned by other accounts (/var/mail, /var/spool/lpd,
# /home/nonroot and the like) are removed, and any such directory that is not empty fails the build.
RUN set -eux; \
    find / -xdev \( -path /proc -o -path /sys -o -path /dev -o -path /run \) -prune -o -type d ! -user root ! -perm -005 -print | sort -r | while IFS= read -r d; do rmdir "$d"; done; \
    test -z "$(find / -xdev \( -path /proc -o -path /sys -o -path /dev -o -path /run \) -prune -o -type d ! -user root ! -perm -005 -print)"; \
    find / -xdev \( -path /proc -o -path /sys -o -path /dev -o -path /run \) -prune -o -type f -perm /6000 -print | while IFS= read -r f; do chmod u-s,g-s "$f"; done; \
    test -z "$(find / -xdev \( -path /proc -o -path /sys -o -path /dev -o -path /run \) -prune -o -type f -perm /6000 -print)"; \
    awk -F: '/^P:/{p=$2} /^V:/{print p "=" $2}' /lib/apk/db/installed | sort > /opt/meri/browser-host/os-installed-packages.txt; \
    test -s /opt/meri/browser-host/os-installed-packages.txt; \
    node --version > /opt/meri/browser-host/runtime-versions.txt; \
    sha256sum /opt/meri/apps/runtime/native-processing-host/protected-bootstrap.mjs >> /opt/meri/browser-host/helper-hashes.txt; \
    cat /opt/meri/browser-host/helper-hashes.txt /opt/meri/browser-host/runtime-versions.txt
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/meri/browsers NODE_ENV=production
WORKDIR /opt/meri
# Root on purpose (see header). The protected bundle at /var/lib/meri/native-bootstrap, the host cgroup2 tree and
# /run/netns come from the instance; the listener binds the instance's private address from the installed scope.
ENTRYPOINT ["node", "/opt/meri/apps/runtime/browser-host-service/host.mjs"]
