# syntax=docker/dockerfile:1
# Provisioned browser-only host image (linux/arm64, c7g). It carries the host service sources, Playwright MCP 0.0.83 with
# its pinned playwright-core and Chromium build, the two root-only C helpers compiled from this tree, and the network
# tools the per-run compartment and the proxy-uid nft guard need (iproute2, nftables, procps). Identities: sdk 1001
# (workspace owner only), browser 2002, host relay 3001, local relay 3002, egress proxy 3003. Build once per source commit,
# push to meri-greenfield/browser-host, scan the digest (0 HIGH/CRITICAL), then bake the browser host AMI from it exactly as
# the native host AMI is baked from the runtime image. The host service runs as root on the instance (it owns cgroups,
# network namespaces and the helpers); every browser, relay and workspace process is dropped to its fixed unprivileged
# identity by the helpers, never by this image.
#
# Pins:
#  - NODE_IMAGE is the same immutable linux/arm64 Node 24.22.1 trixie-slim child manifest the runtime image uses
#    (infra/product-preview/runtime-packages.lock.json: nodeImageUri). It is the build stage only: npm, the helper
#    compiler and the Chromium download run there, and its Debian packages are never part of the exported image.
#  - HOST_IMAGE is the same immutable Wolfi base the runtime image uses (runtimeImageUri). The exported image is Wolfi
#    glibc with the official Node binary copied from the build stage, as the runtime image does.
#  - DEBIAN_SNAPSHOT fixes the build stage's apt candidates (the helper compiler).
#  - infra/browser-host/browser-host-packages.lock.json pins the exported image's whole Wolfi closure: every archive by
#    exact URL and sha256, resolved from the retained vendor-signed index the runtime image also installs from
#    (infra/product-preview/native-apk-index; replacing that index means re-resolving this closure). The archives are
#    staged below as one local apk repository and installed offline exactly as the runtime image installs its native
#    closure from runtime-packages.lock.json. Re-resolve the closure from a newer signed index deliberately and re-scan.
#  - The browser-host lockfile (apps/runtime/browser-host-service/image/package-lock.json) pins @playwright/mcp 0.0.83,
#    playwright and playwright-core 1.64.0-alpha-1790635538000 by registry integrity; regenerate it only with
#    `npm install --package-lock-only --ignore-scripts` in that directory when image/package.json changes.
ARG NODE_IMAGE=public.ecr.aws/docker/library/node@sha256:401346cb1fc12bb388a82ed58ea72eeed2fe8530804d2964bcddce63a4eda4d8
ARG HOST_IMAGE=cgr.dev/chainguard/wolfi-base@sha256:4e354e15b41a49dc249d07a4e38974c4ef6db8a4cc70059c4d625f5cdaa92657
ARG DEBIAN_SNAPSHOT=20261102T000000Z

# ---------------------------------------------------------------- build: dependencies, helpers, Chromium
FROM ${NODE_IMAGE} AS builder
ARG DEBIAN_SNAPSHOT
RUN test "$(uname -m)" = aarch64 && test "$(node --version)" = v24.22.1
# Signed historical snapshot, HTTP first only to obtain ca-certificates, then HTTPS for everything else (as in
# apps/worker/qualification/Dockerfile). Signature verification stays on; no mutable suite is ever consulted.
RUN set -eux; \
    rm -f /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list; \
    printf '%s\n' \
      'Types: deb' "URIs: http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}" 'Suites: trixie' 'Components: main' \
      'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' 'Check-Valid-Until: no' '' \
      'Types: deb' "URIs: http://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT}" 'Suites: trixie-security' 'Components: main' \
      'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' 'Check-Valid-Until: no' \
      > /etc/apt/sources.list.d/meri-snapshot.sources; \
    apt-get update; apt-get install -y --no-install-recommends --no-remove ca-certificates; \
    sed -i 's#http://snapshot.debian.org#https://snapshot.debian.org#g' /etc/apt/sources.list.d/meri-snapshot.sources; \
    apt-get update; apt-get install -y --no-install-recommends --no-remove gcc libc6-dev make; \
    apt-get clean; rm -rf /var/lib/apt/lists/*
WORKDIR /opt/meri
# The host service imports shared worker and runtime modules; their locked dependency sets are installed exactly as the
# runtime image installs them (the Claude Agent SDK package arrives as a module dependency of shared worker modules and is
# never invoked here: this host has no query, provider credential or Bash process).
# The repository root declares no runtime dependency; the shared contracts and the modules beside them resolve ajv,
# ajv-formats, canonicalize and saxes from /opt/meri/node_modules, so the contracts' own locked runtime set is installed
# there.
COPY packages/contracts/package.json packages/contracts/package-lock.json /tmp/meri-contracts-deps/
RUN npm ci --prefix /tmp/meri-contracts-deps --ignore-scripts --no-audit --no-fund --omit=dev && \
    mv /tmp/meri-contracts-deps/node_modules /opt/meri/node_modules && rm -rf /tmp/meri-contracts-deps
COPY apps/runtime/package.json apps/runtime/package-lock.json ./apps/runtime/
RUN npm ci --prefix apps/runtime --ignore-scripts --no-audit --no-fund --omit=dev
COPY apps/worker/conversation/package.json apps/worker/conversation/package-lock.json ./apps/worker/conversation/
RUN npm ci --prefix apps/worker/conversation --ignore-scripts --no-audit --no-fund --omit=dev
# The pinned browser stack lives in its own tree so cliPath is fixed: /opt/meri/browser-host/node_modules/@playwright/mcp/cli.js
COPY apps/runtime/browser-host-service/image/package.json apps/runtime/browser-host-service/image/package-lock.json ./browser-host/
RUN npm ci --prefix browser-host --ignore-scripts --no-audit --no-fund --omit=dev && \
    test "$(node -p "require('/opt/meri/browser-host/node_modules/@playwright/mcp/package.json').version")" = 0.0.83 && \
    test "$(node -p "require('/opt/meri/browser-host/node_modules/playwright-core/package.json').version")" = 1.64.0-alpha-1790635538000
COPY apps ./apps
COPY packages ./packages
RUN mkdir -p node_modules/@capiro && ln -s ../../packages/contracts node_modules/@capiro/meri-contracts
# Root-only helpers compiled from this exact tree; their hashes become helperSha256 / nativeHostRelayHelperSha256.
RUN set -eux; \
    gcc -O2 -Wall -Wextra -Werror -D_FORTIFY_SOURCE=2 -fstack-protector-strong -fPIE -pie -Wl,-z,relro,-z,now \
      -o /opt/meri/meri-host-launcher apps/worker/conversation/host/launcher/native/meri-host-launcher.c; \
    gcc -O2 -Wall -Wextra -Werror -D_FORTIFY_SOURCE=2 -fstack-protector-strong -fPIE -pie -Wl,-z,relro,-z,now \
      -o /opt/meri/meri-host-relay-launcher apps/worker/conversation/host/network/native/meri-host-relay-launcher.c; \
    sha256sum /opt/meri/meri-host-launcher /opt/meri/meri-host-relay-launcher > /opt/meri/browser-host/helper-hashes.txt; \
    cat /opt/meri/browser-host/helper-hashes.txt
# Playwright's pinned Chromium (revision 1247 for this playwright-core) under the fixed browsers path, with its headless
# shell, which is the executable a `headless: true` launch actually runs; both are hashed. The setuid sandbox helper is not
# used: the launcher sets NoNewPrivs before exec, so Chromium runs its user-namespace sandbox; the AMI must allow
# unprivileged user namespaces.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/meri/browsers
RUN set -eux; \
    node browser-host/node_modules/playwright-core/cli.js install chromium; \
    test -d /opt/meri/browsers/chromium-1247 && test -d /opt/meri/browsers/chromium_headless_shell-1247; \
    chmod -R a+rX,u-s,g-s /opt/meri/browsers; \
    find /opt/meri/browsers -maxdepth 3 -type f \( -name chrome -o -name chrome-headless-shell \) -exec sha256sum {} \; | sort -k2 > /opt/meri/browser-host/chromium-hashes.txt; \
    test "$(wc -l < /opt/meri/browser-host/chromium-hashes.txt)" = 2; cat /opt/meri/browser-host/chromium-hashes.txt; \
    test -z "$(find /opt/meri/browsers -perm /6000 -type f -print)"

# ---------------------------------------------------------------- the pinned Wolfi closure as one local apk repository
# Every archive of infra/browser-host/browser-host-packages.lock.json, by exact URL and sha256, in two staging stages
# (Docker's layer chain limit, as in the runtime image), assembled beside the retained vendor-signed index in a build-only
# stage. The host stage reads it through a read-only mount, so the archives never become image layers.
FROM ${HOST_IMAGE} AS host-repo-1
ADD --checksum=sha256:ad05c3a03fd0f7711bf614b0cdb971f045986f2e63396587bb7f7900d7f5d6b6 https://packages.wolfi.dev/os/aarch64/alsa-lib-1.2.16.1-r5.apk /tmp/meri-browser-host-repo/aarch64/alsa-lib-1.2.16.1-r5.apk
ADD --checksum=sha256:258840eec648177fc224de417203101b0f77b813e8abb79749a367e9858ca3c5 https://packages.wolfi.dev/os/aarch64/at-spi2-core-2.62.1-r0.apk /tmp/meri-browser-host-repo/aarch64/at-spi2-core-2.62.1-r0.apk
ADD --checksum=sha256:9cefe4bc29a914b6cd104d3130fa1efee96e029094427f15aa77e9366eff8649 https://packages.wolfi.dev/os/aarch64/avahi-libs-0.9_rc5-r3.apk /tmp/meri-browser-host-repo/aarch64/avahi-libs-0.9_rc5-r3.apk
