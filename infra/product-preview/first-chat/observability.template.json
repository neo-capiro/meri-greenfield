    "HotPathDashboard": {
      "Type": "AWS::CloudWatch::Dashboard",
      "Properties": {
        "DashboardBody": {
          "Fn::Join": [
            "",
            [
              "{\"widgets\":[{\"type\":\"metric\",\"x\":0,\"y\":0,\"width\":12,\"height\":6,\"properties\":{\"title\":\"First text and result (1 hour)\",\"region\":\"",
              {
                "Ref": "AWS::Region"
              },
              "\",\"view\":\"timeSeries\",\"stat\":\"Sum\",\"period\":3600,\"metrics\":[[\"Meri/Preview\",\"FirstTextMs\",\"Service\",\"control\",{\"stat\":\"p50\"}],[\"Meri/Preview\",\"FirstTextMs\",\"Service\",\"control\",{\"stat\":\"p95\"}],[\"Meri/Preview\",\"ResultMs\",\"Service\",\"control\",{\"stat\":\"p50\"}],[\"Meri/Preview\",\"ResultMs\",\"Service\",\"control\",{\"stat\":\"p95\"}]]}},{\"type\":\"metric\",\"x\":12,\"y\":0,\"width\":12,\"height\":6,\"properties\":{\"title\":\"First text and result (1 day)\",\"region\":\"",
              {
                "Ref": "AWS::Region"
              },
              "\",\"view\":\"timeSeries\",\"stat\":\"Sum\",\"period\":86400,\"metrics\":[[\"Meri/Preview\",\"FirstTextMs\",\"Service\",\"control\",{\"stat\":\"p50\"}],[\"Meri/Preview\",\"FirstTextMs\",\"Service\",\"control\",{\"stat\":\"p95\"}],[\"Meri/Preview\",\"ResultMs\",\"Service\",\"control\",{\"stat\":\"p50\"}],[\"Meri/Preview\",\"ResultMs\",\"Service\",\"control\",{\"stat\":\"p95\"}]]}},{\"type\":\"metric\",\"x\":0,\"y\":6,\"width\":12,\"height\":6,\"properties\":{\"title\":\"Turns and timeout signals by source (signals may share a turn)\",\"region\":\"",
              {
                "Ref": "AWS::Region"
              },
              "\",\"view\":\"timeSeries\",\"stat\":\"Sum\",\"period\":300,\"metrics\":[[\"Meri/Preview\",\"Turns\",\"Service\",\"control\",\"Outcome\",\"completed\",{}],[\"Meri/Preview\",\"Turns\",\"Service\",\"control\",\"Outcome\",\"failed\",{}],[\"Meri/Preview\",\"Turns\",\"Service\",\"control\",\"Outcome\",\"cancelled\",{}],[\"Meri/Preview\",\"TimeoutFailures\",\"Service\",\"control\",{\"label\":\"Control timeout signals\"}],[\"Meri/Preview\",\"TimeoutFailures\",\"Service\",\"runner\",{\"label\":\"Runner timeout signals\"}]]}},{\"type\":\"metric\",\"x\":12,\"y\":6,\"width\":12,\"height\":6,\"properties\":{\"title\":\"Calls per turn (background excluded; Clerk reads estimated)\",\"region\":\"",
              {
