    "TurnFailureRate": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "AlarmsTopic"
          }
        ],
        "AlarmDescription": "Meri Preview P0: turn-failure-rate",
        "AlarmName": "meri-preview-turn-failure-rate",
        "ComparisonOperator": "GreaterThanThreshold",
        "DatapointsToAlarm": 1,
        "EvaluationPeriods": 1,
        "Metrics": [
          {
            "Id": "completed",
            "MetricStat": {
              "Metric": {
                "Dimensions": [
                  {
                    "Name": "Service",
                    "Value": "control"
                  },
                  {
                    "Name": "Outcome",
                    "Value": "completed"
                  }
                ],
                "MetricName": "Turns",
                "Namespace": "Meri/Preview"
              },
              "Period": 1800,
              "Stat": "Sum"
            },
            "ReturnData": false
          },
          {
            "Id": "failed",
            "MetricStat": {
              "Metric": {
                "Dimensions": [
                  {
                    "Name": "Service",
                    "Value": "control"
                  },
                  {
                    "Name": "Outcome",
                    "Value": "failed"
                  }
                ],
                "MetricName": "Turns",
                "Namespace": "Meri/Preview"
              },
              "Period": 1800,
              "Stat": "Sum"
            },
            "ReturnData": false
          },
          {
            "Expression": "completed+failed",
            "Id": "total",
            "ReturnData": false
          },
          {
            "Expression": "IF(total>=3,100*failed/total,0)",
            "Id": "rate",
            "ReturnData": true
          }
        ],
        "Threshold": 20,
        "TreatMissingData": "notBreaching"
      }
    },
    "TimeoutFailure": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmActions": [
          {
