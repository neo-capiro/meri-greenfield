          }
        ],
        "AlarmDescription": "Meri Preview P0: timeout-failure",
        "AlarmName": "meri-preview-timeout-failure",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "DatapointsToAlarm": 1,
        "EvaluationPeriods": 1,
        "Metrics": [
          {
            "Id": "control",
            "MetricStat": {
              "Metric": {
                "Dimensions": [
                  {
                    "Name": "Service",
                    "Value": "control"
                  }
                ],
                "MetricName": "TimeoutFailures",
                "Namespace": "Meri/Preview"
              },
              "Period": 300,
              "Stat": "Sum"
            },
            "ReturnData": false
          },
          {
            "Id": "runner",
            "MetricStat": {
              "Metric": {
                "Dimensions": [
                  {
                    "Name": "Service",
                    "Value": "runner"
                  }
                ],
                "MetricName": "TimeoutFailures",
                "Namespace": "Meri/Preview"
              },
              "Period": 300,
              "Stat": "Sum"
            },
            "ReturnData": false
          },
          {
            "Expression": "SUM([control,runner])",
            "Id": "timeouts",
            "ReturnData": true
          }
        ],
        "Threshold": 1,
        "TreatMissingData": "notBreaching"
      }
    },
