# Native ARM64 child manifests, checked against temporal-image-pins.json.
# Build context is the repository root or its exact sealed Temporal subset.
FROM --platform=linux/arm64 public.ecr.aws/docker/library/node@sha256:401346cb1fc12bb388a82ed58ea72eeed2fe8530804d2964bcddce63a4eda4d8 AS node-binary
# Upstream v1.32.1 source, rebuilt with supported security patch dependencies.
FROM --platform=linux/arm64 public.ecr.aws/docker/library/golang@sha256:0849630945ae86e34645a0cf6944792922b80161f9e90c5f85d64e18a903da29 AS temporal-server
ENV CGO_ENABLED=0 GOOS=linux GOARCH=arm64 GOTOOLCHAIN=local GOPROXY=https://proxy.golang.org GOSUMDB=sum.golang.org
ADD --checksum=sha256:ea2283c976d4aaf0b86d289bb5f17b4f514a5b56d01ec2d32f11078e48ab8cfd https://codeload.github.com/temporalio/temporal/tar.gz/af08a5e5f2dd40f545f2afac7780daaa6987001e /tmp/temporal.tar.gz
WORKDIR /src/temporal
RUN tar -xzf /tmp/temporal.tar.gz --strip-components=1 && rm /tmp/temporal.tar.gz
# Generated by Go 1.26.10: go get golang.org/x/net@v0.60.0; go mod download.
# The reviewed go.mod/go.sum delta includes the required standard MVS closure.
COPY infra/product-preview/temporal-server-dependencies.patch /tmp/temporal-server-dependencies.patch
COPY infra/product-preview/temporal-certificate-claims.patch /tmp/temporal-certificate-claims.patch
COPY infra/product-preview/temporal-certificate-claims.go common/authorization/meri_certificate_claims.go
COPY infra/product-preview/temporal-certificate-claims.test.go common/authorization/meri_certificate_claims_test.go
# Match upstream GoReleaser cmd/server, CGO=0 and -s -w, retaining Go module metadata.
RUN test "$(go env GOVERSION)" = go1.26.10 && mkdir /out && \
    git -c core.autocrlf=false apply /tmp/temporal-server-dependencies.patch && git apply /tmp/temporal-certificate-claims.patch && go mod download && go mod verify && \
    go test -mod=readonly ./common/authorization -run '^TestMeriCertificate' -count=1 && \
    go build -mod=readonly -trimpath -ldflags="-s -w" -o /out/temporal-server ./cmd/server && \
    go list -m all > /out/temporal-server.modules && \
    go version -m /out/temporal-server > /out/temporal-server.buildinfo && \
    cd /out && sha256sum temporal-server > temporal-server.sha256
FROM --platform=linux/arm64 cgr.dev/chainguard/wolfi-base@sha256:4e354e15b41a49dc249d07a4e38974c4ef6db8a4cc70059c4d625f5cdaa92657
ARG LAUNCH_SOURCE_COMMIT
USER root
# apk owns the GNU runtime dependencies; no copied loader or private APK repository.
RUN test "$(uname -m)" = aarch64 && apk add --no-cache libatomic=16.2.0-r1 libstdc++=16.2.0-r1
COPY --from=node-binary /usr/local/bin/node /opt/meri/node
# Only the rebuilt server and standard build metadata enter the runtime; no compiler or source tree.
COPY --from=temporal-server /out/temporal-server /usr/local/bin/temporal-server
COPY --from=temporal-server /out/temporal-server.sha256 /out/temporal-server.buildinfo /out/temporal-server.modules /opt/meri/
COPY --chmod=0555 infra/product-preview/temporal-launch.sh /opt/meri/temporal-launch
COPY --chmod=0444 infra/product-preview/temporal-launch-main.mjs /opt/meri/temporal-launch-main.mjs
COPY --chmod=0444 infra/product-preview/temporal-launch-render.mjs /opt/meri/temporal-launch-render.mjs
COPY --chmod=0444 infra/product-preview/temporal-migration-plan.mjs /opt/meri/temporal-migration-plan.mjs
COPY --chmod=0444 infra/product-preview/temporal-image-pins.json /opt/meri/temporal-image-pins.json
RUN /opt/meri/node -e 'const s=process.env.LAUNCH_SOURCE_COMMIT;if(!/^[a-f0-9]{40}$/.test(s)||process.version!=="v24.22.1"||process.arch!=="arm64")process.exit(1)'
RUN addgroup -g 1000 temporal && adduser -D -u 1000 -G temporal -h /etc/temporal -s /bin/sh temporal && \
    mkdir -p /run/temporal /tmp && chown temporal:temporal /run/temporal && chmod 0700 /run/temporal && chmod 01777 /tmp
WORKDIR /etc/temporal
VOLUME ["/run/temporal", "/tmp"]
ENV MERI_TEMPORAL_IMAGE_SOURCE_COMMIT=${LAUNCH_SOURCE_COMMIT}
ENV HOME=/etc/temporal
USER 1000:1000
ENTRYPOINT ["/opt/meri/temporal-launch"]
CMD []
