+    if (!(timeobj))
+        return NULL;
+
+    /* ASN1_TIME has been opaque since OpenSSL 1.1.0 and the 4.0 headers reject the old
+     * direct struct reads, so read the recorded value through the public accessors and
+     * parse it from a bounded local copy. The copy is what the year adjustment below
+     * rewrites, so the caller's object is no longer modified and the parse is unchanged. */
+    strlength = ASN1_STRING_length(timeobj);
+    strdata   = ASN1_STRING_get0_data(timeobj);
+    if (!(strdata) || strlength < 12 || (size_t)strlength >= sizeof(strbuf))
+        return NULL;
+
+    memcpy(strbuf, strdata, (size_t)strlength);
+    strbuf[strlength] = '\0';
+    str = strbuf;
