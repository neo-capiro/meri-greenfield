ClamAV 1.5.4 compatibility patch for OpenSSL 4.0 opaque ASN1_TIME / ASN1_STRING
=================================================================================
upstream        ClamAV 1.5.4 libclamav/crypto.c, from the signed release asset
                clamav-1.5.4.tar.gz sha256 1af1117a228f1b5bc7fa91a0dabc37848a99e7d25188e9be8043332ce721dfd3
                (Cisco Talos detached signature over the same bytes, checked in the same build step)
target          libclamav/crypto.c
target-sha256-before  6cfefd0ca043a922ddfda11c364f4995daf8a12317ce22f6c839b8c95a069dcc
target-sha256-after   26bdec0a22b4feb6927a4ef292e6f2d1896d11d2d92ffabc9a466bbb6884f036
defect          cl_ASN1_GetTimeT reads timeobj->data and timeobj->type directly. ASN1_STRING and ASN1_TIME
                became opaque in OpenSSL 4.0 (they were public structs through 3.x), so with the 4.0.3 headers the
                development closure installs, gcc refuses the four reads that build e6e7efb6 hit at
                crypto.c:1769/1772/1780/1789 ("invalid use of incomplete typedef 'ASN1_TIME'") and libclamav
                cannot compile at all.
change          the same parse, fed from the public accessors: ASN1_STRING_length / ASN1_STRING_get0_data /
                ASN1_STRING_type, into a private NUL-terminated copy of the recorded value (length + 1, checked
                allocation). The copy is what the year adjustment rewrites, so the caller's object stays immutable
                and the value keeps its full length: a GeneralizedTime may carry more fractional digits than the
                "%Y%m%d%H%M%S" parse reads, exactly as before. Every refusal is unchanged (null object, missing
                data, value under 12 bytes, embedded NUL shortening it, unknown type, strptime failure) and the
                returned tm, including tm_isdst, is unchanged. The copy is freed on every exit path. No API or
                version change, no dependency change, no change to time parsing or to the year adjustment.
application     infra/product-preview/native-clamav-patches/apply-pinned-patch.py, run by the stage's pinned
                python3.13 after the archive's sha256 and signature checks, with these two hashes as arguments.
=================================================================================
--- a/libclamav/crypto.c
+++ b/libclamav/crypto.c
@@ -1760,24 +1760,47 @@
     char *str;
     const char *fmt = NULL;
     time_t localt;
+    const unsigned char *strdata;
+    int strlength;
 #ifdef _WIN32
     struct tm localtm, *ltm;
 #else
     struct tm localtm;
 #endif
 
-    if (!(timeobj) || !(timeobj->data))
-        return NULL;
-
-    str = (char *)(timeobj->data);
-    if (strlen(str) < 12)
-        return NULL;
+    if (!(timeobj))
+        return NULL;
+
+    /* ASN1_TIME is opaque as of OpenSSL 4.0 and the 4.0 headers reject the old direct struct
+     * reads, so read the recorded value through the public accessors and parse a private
+     * NUL-terminated copy. The copy is what the year adjustment below rewrites, so the caller's
+     * object is never modified and the recorded value keeps its full length: a GeneralizedTime
+     * may carry more fractional digits than this parser reads, exactly as it did before. */
+    strlength = ASN1_STRING_length(timeobj);
+    strdata   = ASN1_STRING_get0_data(timeobj);
+    if (!(strdata) || strlength < 0)
+        return NULL;
+
+    str = (char *)malloc((size_t)strlength + 1);
+    if (!(str))
+        return NULL;
+
+    if (strlength > 0)
+        memcpy(str, strdata, (size_t)strlength);
+    str[strlength] = '\0';
+
+    if (strlen(str) < 12) {
+        free(str);
+        return NULL;
+    }
 
     t = (struct tm *)calloc(1, sizeof(struct tm));
-    if (!(t))
-        return NULL;
-
-    if (timeobj->type == V_ASN1_UTCTIME) {
+    if (!(t)) {
+        free(str);
+        return NULL;
+    }
+
+    if (ASN1_STRING_type(timeobj) == V_ASN1_UTCTIME) {
         /* two digit year */
         fmt = "%y%m%d%H%M%S";
         if (str[3] == '0') {
@@ -1786,7 +1809,7 @@
         } else {
             str[3]--;
         }
-    } else if (timeobj->type == V_ASN1_GENERALIZEDTIME) {
+    } else if (ASN1_STRING_type(timeobj) == V_ASN1_GENERALIZEDTIME) {
         /* four digit year */
         fmt = "%Y%m%d%H%M%S";
         if (str[5] == '0') {
@@ -1799,11 +1822,13 @@
 
     if (!(fmt)) {
         free(t);
+        free(str);
         return NULL;
     }
 
     if (!strptime(str, fmt, t)) {
         free(t);
+        free(str);
         return NULL;
     }
 
@@ -1816,6 +1841,7 @@
     localtime_r(&localt, &localtm);
 #endif
     t->tm_isdst = localtm.tm_isdst;
+    free(str);
     return t;
 }
 
