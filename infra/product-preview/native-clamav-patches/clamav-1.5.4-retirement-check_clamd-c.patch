+/* These hooks exist only in the check_clamd copy of thrmgr.c. Install them
+ * before creating the worker and clear them after all threads have joined. */
+extern void (*thrmgr_test_stats_locked_hook)(void);
+extern void (*thrmgr_test_retiring_hook)(void);
+static struct stats_worker_retirement_test_state *retirement_state;
+
+static void stats_retirement_snapshot_locked(void)
+{
+    struct stats_worker_retirement_test_state *state = retirement_state;
+    pthread_mutex_lock(&state->mutex);
+    state->allow_first_handler_finish = 1;
+    pthread_cond_broadcast(&state->cond);
+    while (!state->allow_stats_snapshot)
+        pthread_cond_wait(&state->cond, &state->mutex);
+    pthread_mutex_unlock(&state->mutex);
+}
+
+static void stats_retirement_worker_checkpoint(void)
+{
+    struct stats_worker_retirement_test_state *state = retirement_state;
+    pthread_mutex_lock(&state->mutex);
+    state->worker_retiring = 1;
+    pthread_cond_broadcast(&state->cond);
+    pthread_mutex_unlock(&state->mutex);
+}
 
