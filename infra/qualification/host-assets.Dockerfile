# Source-only D006 v2 recipe. This image is NEVER started; source and build
# identities must be independently frozen before an owner-authorized build.
FROM scratch
ARG SOURCE_COMMIT
LABEL org.opencontainers.image.title="Meri isolated browser qualification support" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      meri.qualification.kind="browser-host-support-only" \
      meri.browser.asset-protocol="2"
COPY infra/browser-qualification/bootstrap.sh /meri-host-assets/bootstrap.sh
COPY infra/browser-qualification/host-evidence.py /meri-host-assets/host-evidence.py
COPY infra/browser-qualification/host_evidence/__init__.py /meri-host-assets/host_evidence/__init__.py
COPY infra/browser-qualification/host_evidence/admission.py /meri-host-assets/host_evidence/admission.py
COPY infra/browser-qualification/host_evidence/browser_capture.py /meri-host-assets/host_evidence/browser_capture.py
COPY infra/browser-qualification/host_evidence/classification.py /meri-host-assets/host_evidence/classification.py
COPY infra/browser-qualification/host_evidence/cli.py /meri-host-assets/host_evidence/cli.py
COPY infra/browser-qualification/host_evidence/collection.py /meri-host-assets/host_evidence/collection.py
COPY infra/browser-qualification/host_evidence/config.py /meri-host-assets/host_evidence/config.py
COPY infra/browser-qualification/host_evidence/evidence_io.py /meri-host-assets/host_evidence/evidence_io.py
COPY infra/browser-qualification/host_evidence/export_protocol.py /meri-host-assets/host_evidence/export_protocol.py
COPY infra/browser-qualification/host_evidence/poll.py /meri-host-assets/host_evidence/poll.py
COPY infra/browser-qualification/host_evidence/source_binding.py /meri-host-assets/host_evidence/source_binding.py
COPY infra/browser-qualification/seccomp.chromium-155-amd64.json /meri-host-assets/seccomp.json
# Manifest DATA is exclusively generated by the reviewed loader, never copied.
# No RUN, ADD, CMD, ENTRYPOINT or remote dependency.
